@inject PeticionCambioDomicilio.AppOptions Options
@inject PeticionCambioDomicilio.Ews.IMailSender Mail
@inject Sgl.Peticiones.IMenuSistema Menu
@* Marco del sistema (Gestión de Carpetas 2.0): mismo encabezado, menú lateral y tema que el resto de los módulos. *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Gestión de Carpetas 2.0</title>
    <meta name="color-scheme" content="light dark" />
    <script>
        // Aplica tema y estilo de filas antes del primer pintado (igual que el resto del sistema).
        (function () {
            var d = document.documentElement, t = null, r = null, g = null, p = null;
            try { t = localStorage.getItem('sgl-theme'); r = localStorage.getItem('sgl-rows'); g = localStorage.getItem('sgl-design'); p = localStorage.getItem('sgl-palette'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') t = 'light';
            d.setAttribute('data-theme', t);
            d.setAttribute('data-rows', r === 'classic' ? 'classic' : 'soft');
            d.setAttribute('data-design', g === 'institucional' ? 'institucional' : 'claro');
            d.setAttribute('data-palette', ['inst', 'ocea', 'bosq', 'atar', 'viol', 'graf'].indexOf(p) >= 0 ? p : 'inst');
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/app.css" />
    <link rel="stylesheet" href="~/theme.css" />
    <link rel="stylesheet" href="~/modulos.css" />
    <link rel="stylesheet" href="~/polish.css" />
    <link rel="stylesheet" href="~/shell.css" />
    <link rel="stylesheet" href="~/paginas.css" />
    <link rel="stylesheet" href="~/listado.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/peticiones.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" />
</head>
<body>
    <header class="topbar">
        <div class="brand-group">
            <a class="brand" href="/carpetas?bandeja=PorClasificar" title="Ir a Entrantes para clasificar">
                <span class="brand-mark brand-logo">
                    <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" />
                </span>
                <span class="brand-text"><strong>Gestión de Carpetas 2.0</strong> <span class="brand-sub">Licencias de Conducir</span></span>
            </a>
        </div>
        <nav class="main-nav" aria-label="Principal">
            <a href="/" class="nav-item nav-inicio" title="Ir al panel de inicio">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
                Inicio
            </a>
            <a href="/cajas" class="nav-item nav-cajas">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>
                Cajas de Archivo
            </a>
            <a href="/estadisticas" class="nav-item nav-estadisticas">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
                Estadísticas
            </a>
            <button id="btn-guia-global" class="btn-guia-accion" type="button" title="Cómo usar el sistema (Guía interactiva)">
                <span class="guia-avatar lico-slot" data-lico="explica" aria-hidden="true"></span>
                <span>Cómo usar el sistema</span>
            </button>
        </nav>
        <div class="topbar-tools">
        <div class="pal-wrap">
        <button type="button" class="pal-toggle" id="btn-paleta" aria-expanded="false" aria-controls="pal-panel" aria-label="Elegir paleta de color" title="Elegir paleta de color"><i aria-hidden="true"></i></button>
        <div class="pal" id="pal-panel" role="group" aria-label="Paleta de color">
            <button type="button" class="sw" data-palette="inst" style="--sc: #26388c" aria-label="Paleta Institucional" title="Paleta Institucional" aria-pressed="true" onclick="window.sglUi.setPalette('inst')"><i></i></button>
            <button type="button" class="sw" data-palette="ocea" style="--sc: #127aa8" aria-label="Paleta Océano" title="Paleta Océano" aria-pressed="false" onclick="window.sglUi.setPalette('ocea')"><i></i></button>
            <button type="button" class="sw" data-palette="bosq" style="--sc: #1f7d4e" aria-label="Paleta Bosque" title="Paleta Bosque" aria-pressed="false" onclick="window.sglUi.setPalette('bosq')"><i></i></button>
            <button type="button" class="sw" data-palette="atar" style="--sc: #c43a2c" aria-label="Paleta Atardecer" title="Paleta Atardecer" aria-pressed="false" onclick="window.sglUi.setPalette('atar')"><i></i></button>
            <button type="button" class="sw" data-palette="viol" style="--sc: #7040d0" aria-label="Paleta Violeta" title="Paleta Violeta" aria-pressed="false" onclick="window.sglUi.setPalette('viol')"><i></i></button>
            <button type="button" class="sw" data-palette="graf" style="--sc: #4a5068" aria-label="Paleta Grafito" title="Paleta Grafito" aria-pressed="false" onclick="window.sglUi.setPalette('graf')"><i></i></button>
        </div>
        </div>
            <button class="tool-btn" type="button" id="btn-filas" aria-pressed="false" title="Alternar entre filas suaves y los colores originales del Excel" aria-label="Alternar colores de filas" onclick="window.sglUi && window.sglUi.toggleRows()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="18" height="4" rx="1"/></svg>
            </button>
            <button class="tool-btn" type="button" id="btn-diseno" title="Cambiar estilo visual: claro o institucional" aria-label="Cambiar estilo visual entre claro e institucional" onclick="window.sglUi.toggleDesign()">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M3 15h18"/></svg>
            </button>
            <button class="tool-btn" type="button" id="btn-tema" title="Cambiar entre tema claro y oscuro" aria-label="Cambiar tema claro u oscuro" onclick="window.sglUi && window.sglUi.toggleTheme()">
                <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
        </div>
    </header>

    <main class="content">
        <div class="modulo-shell">
            @{
                var rutaActual = Context.Request.Path.Value?.Trim('/') ?? "";
            }
            <nav class="modulos-sidebar" aria-label="Módulos">
                <div class="sidebar-cabecera">
                    <span class="sidebar-inicio sidebar-titulo">Módulos</span>
                </div>
                <div class="sidebar-grupos">
                    @foreach (var grupo in Menu.Grupos)
                    {
                        var activo = grupo.Items.Any(i => string.Equals(i.Href.Trim('/'), rutaActual, StringComparison.OrdinalIgnoreCase));
                        <section class="sidebar-grupo @grupo.Css">
                            <button type="button" class="sidebar-grupo-titulo" aria-expanded="@(activo ? "true" : "false")" title="@grupo.Nombre">
                                <svg class="sidebar-grupo-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="@grupo.Icono" /></svg>
                                <span class="sidebar-grupo-nombre">@grupo.Nombre</span>
                                <span class="sidebar-chevron" aria-hidden="true">@(activo ? "▾" : "▸")</span>
                            </button>
                            <ul hidden="@(!activo)">
                                @foreach (var item in grupo.Items)
                                {
                                    var esActivo = string.Equals(item.Href.Trim('/'), rutaActual, StringComparison.OrdinalIgnoreCase);
                                    <li>
                                        <a class="sidebar-modulo @(esActivo ? "activo" : "") @item.ClaseColor" href="/@item.Href.TrimStart('/')" aria-current="@(esActivo ? "page" : null)" title="@item.Nombre">
                                            <span class="semaforo-punto"></span>
                                            <span class="sidebar-modulo-nombre">@item.Nombre</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            </nav>
            <div class="modulo-main">
                @{
                    var envioReal = Mail.IsConfigured && string.IsNullOrWhiteSpace(Options.TestModeEmail);
                    var modoPrueba = !string.IsNullOrWhiteSpace(Options.TestModeEmail);
                }
                @if (envioReal)
                {
                    <div class="modo-franja modo-franja--real">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m10.3 3.6-8 13.9A2 2 0 0 0 4 20.5h16a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>
                        ENVÍO REAL ACTIVO — los correos salen a las municipalidades
                    </div>
                }
                else if (modoPrueba)
                {
                    <div class="modo-franja modo-franja--prueba">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="m4.9 4.9 14.2 14.2" /></svg>
                        MODO PRUEBA — nada llega a las municipalidades (todo va a @Options.TestModeEmail)
                    </div>
                }
                @if (TempData["Flash"] is string flash)
                {
                    <div class="alert info mx-3 mb-2">@flash</div>
                }
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="footer">Desarrollado por Raúl Salazar</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/app.js"></script>
    <script src="~/lico.js"></script>
    <script src="~/lico-juegos.js"></script>
    <script>
        // Confirmaciones con texto dinámico (comuna, etc.): el texto viaja en data-confirmar, nunca dentro de un
        // literal JavaScript, así un apóstrofe en el nombre no rompe el diálogo. Fase de captura: corre antes de guardarScroll.
        document.addEventListener("submit", function (ev) {
            var f = ev.target;
            if (f && f.dataset && f.dataset.confirmar && !confirm(f.dataset.confirmar)) ev.preventDefault();
        }, true);

        // Menú lateral: abrir y cerrar grupos (en el resto del sistema lo hace Blazor).
        document.querySelectorAll(".modulos-sidebar .sidebar-grupo-titulo").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var ul = btn.parentElement.querySelector("ul");
                var abrir = ul.hasAttribute("hidden");
                ul.toggleAttribute("hidden", !abrir);
                btn.setAttribute("aria-expanded", abrir ? "true" : "false");
                btn.querySelector(".sidebar-chevron").textContent = abrir ? "▾" : "▸";
            });
        });

        // No saltar al tope cuando una acción recarga la página: guardar el scroll antes de enviar
        // cualquier formulario y volver a esa posición al cargar.
        (function () {
            var KEY = "scroll:" + location.pathname;
            document.addEventListener("submit", function () {
                try { sessionStorage.setItem(KEY, String(window.scrollY)); } catch (e) {}
            }, true);
            window.addEventListener("DOMContentLoaded", function () {
                var y;
                try { y = sessionStorage.getItem(KEY); sessionStorage.removeItem(KEY); } catch (e) {}
                if (y !== null && y !== undefined) {
                    window.scrollTo(0, parseInt(y, 10) || 0);
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
