@page "/peticiones"
@model PeticionCambioDomicilio.Pages.IndexModel
@using PeticionCambioDomicilio.Domain
@inject Sgl.Application.CambioDomicilio.CambioDomicilioOptions OpcionesCambio
@{
    ViewData["Title"] = "Historial de peticiones (anterior)";
    var total = Model.Peticiones.Count;
    var enviadas = Model.Peticiones.Count(p => p.Estado == EstadoPeticion.Enviada);
    var pendientes = total - enviadas;
    var vencidas = Model.Peticiones.Count(p => PlazoInfo.Para(p, feriadosAdicionales: OpcionesCambio.FeriadosAdicionales).Vencido);
}

<div class="page-container peticiones-page">
<h1 class="modulo-titulo">Historial de peticiones (anterior) <span class="muted">· solo lectura</span></h1>
<p>Plazos históricos calculados desde el envío del correo, no desde la citación. Considere feriados nacionales 2026–2027 y adicionales configurados; verifique feriados locales, extraordinarios y años fuera de esa cobertura.</p>

@if (Model.ModoPruebaEmail is not null)
{
    <div class="peticiones-alert danger">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <div>
            <strong>MODO PRUEBA ACTIVO.</strong> Ningún correo sale hacia las municipalidades.
            Todo se desvía a <code>@Model.ModoPruebaEmail</code>.
            Los envíos quedan registrados como prueba: las peticiones siguen pendientes y <strong>no se marcan como enviadas</strong>.
            Para enviar de verdad, vaciar <code>Peticion:TestModeEmail</code> en appsettings.Local.json.
        </div>
    </div>
}

@if (Model.ComunasSinCorreo.Count > 0)
{
    <div class="peticiones-alert warn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <div>
            <strong>@Model.ComunasSinCorreo.Count comuna(s) sin correo en el directorio:</strong>
            @string.Join(", ", Model.ComunasSinCorreo).
            Esas peticiones quedan en espera. Cargá el correo en
            <a asp-page="/Comunas">Comunas</a> y volvé a enviar — se retoman solas.
        </div>
    </div>
}

<div class="peticiones-alert warn" id="peticiones-solo-lectura">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
    <div>
        <strong>Historial de peticiones (anterior): solo lectura.</strong>
        Los pedidos a otras comunas ahora se hacen en <a href="/cambio-domicilio/pedimos">Cambios de domicilio · Pedimos carpetas</a>.
        Aquí quedan los registros antiguos para consultarlos; ya no se importa el Excel ni se envían o reenvían correos desde esta página.
    </div>
</div>

<div class="peticiones-toolbar-panel">
    <div class="toolbar-row">
        <span class="toolbar-spacer"></span>
        <a href="/peticiones/Imprimir" target="_blank" id="btn-imprimir-lista" class="btn-action btn-action-secondary">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z"/></svg>
            <span>Imprimir</span>
        </a>
    </div>
</div>

<div class="table-container standard-table" id="tabla-peticiones">
<table class="data-table bandeja-table">
    <thead>
        <tr>
            <th class="th-check col-sticky-check"></th>
            <th class="th-wrap col-sticky-nombre">NOMBRE DE CONTRIBUYENTE</th>
            <th class="col-sticky-rut">RUT</th>
            <th>SEDE</th>
            <th>COMUNA</th>
            <th>FECHA DE SOLICITUD</th>
            <th>ENVÍO</th>
            <th>PLAZO · 15 D. HÁB.</th>
            <th>ACCIÓN</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Peticiones)
    {
        var pendientesComuna = Model.PendientesPorComuna.TryGetValue(p.Comuna, out var n) ? n : 0;
        var esEnviada = p.Estado == EstadoPeticion.Enviada;
        var esResuelta = p.SubidaEn is not null;
        var finalizada = PeticionCambioDomicilio.Pages.IndexModel.EsFinalizada(p);
        var claseFila = esResuelta
            ? "fila-resuelta"
            : p.Marcada
                ? "fila-marcada"
                : esEnviada
                    ? "fila-enviada"
                    : p.Estado == EstadoPeticion.SinCorreoComuna
                        ? "fila-sincorreo"
                        : p.Estado == EstadoPeticion.Error
                            ? "fila-error"
                            : p.RutInvalido
                                ? "fila-rutinvalido"
                                : "fila-pendiente";

        int? diasCierre = null;
        if (esResuelta && p.EnviadaEn is { } envio)
        {
            var iniCierre = DateOnly.FromDateTime(envio.LocalDateTime);
            diasCierre = p.SubidaEn!.Value <= iniCierre
                ? 0
                : DeadlineCalculator.BusinessDaysBetween(iniCierre, p.SubidaEn.Value, OpcionesCambio.FeriadosAdicionales);
        }

        var plazo = PlazoInfo.Para(p, feriadosAdicionales: OpcionesCambio.FeriadosAdicionales);
        var pct = plazo.Inicio is null
            ? 0
            : Math.Clamp(plazo.DiasTranscurridos * 100 / DeadlineCalculator.PlazoDiasHabiles, 0, 100);
        var plazoClase = plazo.Inicio is null
            ? "idle"
            : plazo.Vencido ? "bad" : plazo.DiasRestantes <= 3 ? "warn" : "ok";
        var envioTitulo = !string.IsNullOrEmpty(p.DetalleEstado) ? p.DetalleEstado : null;

        var rutBusqueda = new string(p.Rut.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();

        <tr id="fila-@p.Id" class="@claseFila" data-pendiente="@(esEnviada || p.Estado == EstadoPeticion.Enviando ? "0" : "1")" data-finalizada="@(finalizada ? "1" : "0")"
            data-nombre="@TextNormalization.Fold(p.NombreCompleto)" data-rut="@rutBusqueda">
            <td class="td-check col-sticky-check"><span class="sin-seleccion" aria-hidden="true">—</span></td>
            <td class="col-sticky-nombre">
                <div class="nombre-wrapper-cell">
                    <span class="name-cell" title="@p.NombreCompleto">@p.NombreCompleto</span>
                    <a class="icono-buscar-dup" href="/carpetas?bandeja=todas&amp;buscar=@Uri.EscapeDataString(p.Rut)"
                       title="Buscar otras carpetas de este RUT (repetidos)" aria-label="Buscar en el sistema las otras carpetas de este RUT">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                    </a>
                </div>
            </td>
            <td class="col-sticky-rut">
                <span class="rut-mono">@p.Rut</span> @(p.RutInvalido ? "⚠" : "")
            </td>
            <td>
                <span class="sede-tag" title="@p.Origen">@p.Oficina</span>
            </td>
            <td>
                <span class="comuna-pill">@p.Comuna</span>
            </td>
            <td class="date-cell" title="Fecha en que se pidió la carpeta a la comuna">
                @(p.EnviadaEn?.LocalDateTime.ToString("dd-MM-yyyy") ?? "— sin pedir")
            </td>
            <td>
                @if (p.Estado == EstadoPeticion.Enviada && p.EnviadaEn is not null)
                {
                    <span class="pill-status ok" title="@envioTitulo">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5" /></svg>Enviado
                    </span>
                    <span class="pill-time-sub">@p.EnviadaEn.Value.ToString("dd-MM HH:mm")</span>
                }
                else if (p.Estado == EstadoPeticion.Enviando)
                {
                    <span class="pill-status idle" title="Hay un envío en curso para esta comuna">Enviando…</span>
                }
                else if (p.Estado == EstadoPeticion.SinCorreoComuna)
                {
                    <span class="pill-status warn" title="@envioTitulo">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v5" /><path d="M12 17h.01" /></svg>Sin correo comuna
                    </span>
                }
                else if (p.Estado == EstadoPeticion.Error)
                {
                    <span class="pill-status bad" title="@envioTitulo">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>Error
                    </span>
                }
                else
                {
                    <span class="pill-status idle">Sin enviar</span>
                }
            </td>
            <td>
                @if (esResuelta)
                {
                    <span class="pill-status ok" title="Carpeta subida el @p.SubidaEn!.Value.ToString("dd-MM-yyyy")">
                        ✓ Cerrada@(diasCierre is not null ? $" · {diasCierre} d. háb." : "")
                    </span>
                }
                else if (plazo.Inicio is null)
                {
                    <span class="text-muted" title="El reloj parte al enviar">—</span>
                }
                else
                {
                    <div class="plazo-widget @plazoClase" title="Día @plazo.DiasTranscurridos de 15 · vence @plazo.Vence?.ToString("dd-MM-yyyy")">
                        <div class="plazo-track"><i class="plazo-fill" style="width:@(pct)%"></i></div>
                        <span class="plazo-label">@(plazo.Vencido ? $"Vencido hace {-plazo.DiasRestantes} d." : $"Quedan {plazo.DiasRestantes} d.")</span>
                    </div>
                }
            </td>
            <td>
                <div class="d-inline-flex align-items-center gap-1">
                <a href="/carpetas?bandeja=CambioDomicilio&buscar=@Uri.EscapeDataString(p.Rut)" 
                   class="btn-decision btn-secondary text-nowrap" style="text-decoration:none;"
                   title="Ver esta carpeta en el módulo de Carpetas">Carpeta →</a>
                </div>
            </td>
        </tr>
    }
    @if (Model.Peticiones.Count == 0)
    {
        <tr><td colspan="9" class="text-center text-muted py-4">Sin peticiones en el historial.</td></tr>
    }
    </tbody>
</table>
</div>
<div class="peticiones-footer-notes">
    <span>Pendientes arriba en el orden del Excel · enviadas abajo por fecha de envío, la más nueva primero</span>
    <span>Historial anterior: solo lectura</span>
</div>
</div>
