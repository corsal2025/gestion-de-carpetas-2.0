<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="color-scheme" content="light dark" />
    <script>
        // Aplica tema, paleta y estilo de filas antes del primer pintado (evita el parpadeo claro/oscuro).
        (function () {
            var d = document.documentElement, t = null, r = null, g = null, p = null;
            try { t = localStorage.getItem('sgl-theme'); r = localStorage.getItem('sgl-rows'); g = localStorage.getItem('sgl-design'); p = localStorage.getItem('sgl-palette'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') t = 'light';
            d.setAttribute('data-theme', t);
            d.setAttribute('data-rows', r === 'soft' ? 'soft' : 'classic');
            d.setAttribute('data-design', g === 'institucional' ? 'institucional' : 'claro');
            d.setAttribute('data-palette', ['inst', 'ocea', 'bosq', 'atar', 'viol', 'graf'].indexOf(p) >= 0 ? p : 'inst');
        })();
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <link rel="stylesheet" href="@Assets["modulos.css"]" />
    <link rel="stylesheet" href="@Assets["polish.css"]" />
    <link rel="stylesheet" href="@Assets["shell.css"]" />
    <link rel="stylesheet" href="@Assets["Sgl.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["lico.js"]"></script>
    <script src="@Assets["lico-juegos.js"]"></script>
</body>

</html>
