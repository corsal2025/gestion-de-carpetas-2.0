<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="color-scheme" content="light dark" />
    <script>
        // Aplica tema, paleta y estilo de filas antes del primer pintado (evita el parpadeo claro/oscuro).
        (function () {
            var d = document.documentElement, t = null, r = null, g = null, p = null;
            try { t = localStorage.getItem('sgl-theme'); r = localStorage.getItem('sgl-rows'); g = localStorage.getItem('sgl-design'); p = localStorage.getItem('sgl-palette'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') t = 'light';
            d.setAttribute('data-theme', t);
            d.setAttribute('data-rows', r === 'classic' ? 'classic' : 'soft');
            d.setAttribute('data-design', g === 'institucional' ? 'institucional' : 'claro');
            d.setAttribute('data-palette', ['inst', 'ocea', 'bosq', 'atar', 'viol', 'graf'].indexOf(p) >= 0 ? p : 'inst');
        })();
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <link rel="stylesheet" href="@Assets["modulos.css"]" />
    <link rel="stylesheet" href="@Assets["polish.css"]" />
    <link rel="stylesheet" href="@Assets["shell.css"]" />
    <link rel="stylesheet" href="@Assets["listado.css"]" />
    <link rel="stylesheet" href="@Assets["paginas.css"]" />
    <link rel="stylesheet" href="@Assets["solicitudes.css"]" />
    <link rel="stylesheet" href="@Assets["encabezados.css"]" />
    <link rel="stylesheet" href="@Assets["Sgl.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="ModoInteractivo" />
</head>

<body>
    <Routes @rendermode="ModoInteractivo" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["app.js"]"></script>
    <script src="@Assets["lico.js"]"></script>
    <script src="@Assets["lico-juegos.js"]"></script>
</body>

</html>

@code {
    // Sin prerender: el circuito arma la página una sola vez. Evita que las páginas con efectos al cargar
    // (p. ej. Integridad) se ejecuten dos veces, una en el servidor estático y otra en el circuito.
    private static readonly InteractiveServerRenderMode ModoInteractivo = new(prerender: false);
}
