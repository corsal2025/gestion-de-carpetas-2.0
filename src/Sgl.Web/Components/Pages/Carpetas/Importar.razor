@page "/importar"
@using Sgl.Application.Carpetas
@using Sgl.Infrastructure.Carpetas
@inject ExcelImportService ExcelImport
@inject AgendaImportService AgendaImport
@inject AutorState Autor
@inject NavigationManager Nav
@inject ModulosState Modulos

<PageTitle>@TituloPagina.De("Cargar Excel")</PageTitle>

<div class="page-container imp-page">
    <header class="header-section imp-hero card">
        <span class="lico-slot head-art imp-lico" data-lico="saluda" aria-hidden="true"></span>
        <div class="imp-hero-t">
            <h1>📥 Carga Masiva de Carpetas desde Excel</h1>
            <p class="subtitle">Integre planillas Excel oficiales (.xlsx) del Departamento de Licencias para registrar y sincronizar carpetas en lote.</p>
        </div>
        <ol class="imp-steps" aria-label="Pasos de la carga">
            <li class="imp-step @PasoClase(1)" aria-current="@PasoActual(1)"><i>1</i>Elegir archivo</li>
            <li class="imp-step @PasoClase(2)" aria-current="@PasoActual(2)"><i>2</i>Procesar</li>
            <li class="imp-step @PasoClase(3)" aria-current="@PasoActual(3)"><i>3</i>Resultado</li>
        </ol>
    </header>

    <div class="card imp-panel">
        <h2>
            1. Seleccionar o Arrastrar Archivo Excel (.xlsx)
        </h2>
        <p class="imp-help">
            Se detecta automáticamente el formato: <strong>agenda diaria</strong> (Fecha Cita, Hora Inicio, RUT, Trámite, Ubicación… → carpetas <em>Por clasificar</em>) o <strong>planilla DETALLE</strong>.
            En la planilla DETALLE el sistema detecta automáticamente las hojas de cada sede (<strong>AV. ARGENTINA</strong>, <strong>PLACILLA</strong>, <strong>MERC. PUERTO</strong>) y mapea las columnas de Fecha, RUT, Nombre, Apellido, Estado, Decisión y Comuna.
        </p>

        <div class="drop-zone">
            <div class="imp-drop-ico" aria-hidden="true">📊</div>
            <label class="btn-primary imp-browse">
                Examinar Archivo Excel
                <InputFile OnChange="OnArchivoSeleccionado" accept=".xlsx, .xls" class="imp-file" />
            </label>
            <p class="imp-drop-note">
                @(archivoSeleccionado is not null ? $"Archivo listo: {archivoSeleccionado.Name} ({archivoSeleccionado.Size / 1024} KB)" : "o arrastre el archivo .xlsx aquí (hasta 50 MB)")
            </p>
        </div>

        @if (cargando)
        {
            <div class="imp-box imp-loading" role="status">
                <div class="spinner"></div>
                <h3>Procesando e Integrando Planilla Excel...</h3>
                <p>
                    Leyendo filas, validando RUTs y sincronizando carpetas en la base de datos. Esto puede tardar unos segundos.
                </p>
            </div>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert error imp-box imp-error" role="alert">
                <span class="lico-slot lico-msg" data-lico="alerta" aria-hidden="true"></span>
                <span>⚠️ <strong>Error al cargar archivo:</strong> @error</span>
            </div>
        }

        @if (resultadoAgenda is not null)
        {
            <div class="imp-box imp-ok" role="status">
                <h3>✅ Agenda del día importada</h3>
                <p class="imp-sedes">Formato detectado: <strong>AGENDA</strong>. Las carpetas nuevas quedan en <strong>Por clasificar</strong>. Email y teléfono no se guardan.</p>
                <div class="imp-tiles">
                    <div class="imp-tile"><span class="imp-tile-label">Filas leídas</span><strong class="imp-tile-num">@resultadoAgenda.FilasLeidas.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">Carpetas creadas</span><strong class="imp-tile-num">+@resultadoAgenda.Creadas.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">Ya existían</span><strong class="imp-tile-num">@resultadoAgenda.YaExistian.ToString("N0")</strong></div>
                    <div class="imp-tile" title="Filas ya importadas antes y anuladas (p. ej. por reagendamiento): no se vuelven a crear"><span class="imp-tile-label">Ya existían (anuladas)</span><strong class="imp-tile-num">@resultadoAgenda.YaExistianAnuladas.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">Canceladas omitidas</span><strong class="imp-tile-num">@resultadoAgenda.CanceladasOmitidas.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">RUT inválidos</span><strong class="imp-tile-num">@resultadoAgenda.FilasRutInvalido.Count.ToString("N0")</strong></div>
                    <div class="imp-tile @(resultadoAgenda.ConAlertaDuplicado > 0 ? "imp-tile-alerta" : null)"><span class="imp-tile-label">Con alerta de duplicado</span><strong class="imp-tile-num">@resultadoAgenda.ConAlertaDuplicado.ToString("N0")</strong></div>
                </div>
                @if (resultadoAgenda.ConAlertaDuplicado > 0)
                {
                    <p class="imp-sedes imp-note">⚠️ @resultadoAgenda.ConAlertaDuplicado.ToString("N0") @(resultadoAgenda.ConAlertaDuplicado == 1 ? "fila tiene" : "filas tienen") RUT con carpeta abierta: aparecen en rojo en <a href="carpetas?bandeja=PorClasificar">Por clasificar</a> con las acciones Reagendar, Crear nueva o Anular duplicada.</p>
                }
                @if (resultadoAgenda.FilasRutInvalido.Count > 0)
                {
                    <p class="imp-sedes imp-note">⚠️ RUT inválido (no se creó carpeta) en filas: @string.Join(", ", resultadoAgenda.FilasRutInvalido)</p>
                }
                @if (resultadoAgenda.Errores.Count > 0)
                {
                    <div class="imp-obs">
                        <span class="imp-obs-title">Filas no importadas:</span>
                        <ul class="imp-obs-list">
                            @foreach (var err in resultadoAgenda.Errores)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
                <div class="imp-cta">
                    <a href="carpetas?bandeja=PorClasificar" class="btn-primary">
                        🗂️ Ir a Por clasificar →
                    </a>
                </div>
            </div>
        }

        @if (resultado is not null)
        {
            <div class="imp-box imp-ok" role="status">
                <h3>
                    <span class="lico-slot lico-msg" data-lico="celebra" aria-hidden="true"></span>
                    ✅ Integración Completada con Éxito
                </h3>

                <div class="imp-tiles">
                    <div class="imp-tile">
                        <span class="imp-tile-label">Filas Leídas</span>
                        <strong class="imp-tile-num">@resultado.FilasLeidas.ToString("N0")</strong>
                    </div>
                    <div class="imp-tile">
                        <span class="imp-tile-label">Carpetas Creadas</span>
                        <strong class="imp-tile-num">+@resultado.CarpetasCreadas.ToString("N0")</strong>
                    </div>
                    <div class="imp-tile">
                        <span class="imp-tile-label">Carpetas Actualizadas</span>
                        <strong class="imp-tile-num">@resultado.CarpetasActualizadas.ToString("N0")</strong>
                    </div>
                    <div class="imp-tile">
                        <span class="imp-tile-label">Nuevos Ciudadanos</span>
                        <strong class="imp-tile-num">+@resultado.CiudadanosCreados.ToString("N0")</strong>
                    </div>
                </div>

                <p class="imp-sedes">
                    🏛️ <strong>Sedes procesadas:</strong> @(string.Join(", ", resultado.SedesProcesadas))
                </p>

                @if (resultado.ComunasNoReconocidas > 0)
                {
                    <div class="imp-sedes imp-note">⚠️ <strong>@resultado.ComunasNoReconocidas.ToString("N0")</strong> fila(s) con comuna no reconocida: se importaron sin comuna (el resto de los datos sí se aplicó).</div>
                }

                @if (resultado.Errores.Count > 0)
                {
                    <div class="imp-obs">
                        <span class="imp-obs-title">Observaciones en algunas filas:</span>
                        <ul class="imp-obs-list">
                            @foreach (var err in resultado.Errores)
                            {
                                <li>@err</li>
                            }
                        </ul>
                        @if (resultado.TotalErrores > resultado.Errores.Count)
                        {
                            <span class="imp-obs-more">y @(resultado.TotalErrores - resultado.Errores.Count) errores más</span>
                        }
                    </div>
                }

                <div class="imp-cta">
                    <a href="carpetas" class="btn-primary">
                        📋 Ver Listado de Carpetas Actualizado →
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Guía de formato de columnas soportadas -->
    <div class="card imp-guide">
        <h3>
            ℹ️ Formato de Columnas Compatibles del Excel
        </h3>
        <p class="imp-help">
            El importador acepta tanto los libros multicapa oficiales del departamento como planillas personalizadas.
        </p>

        <div class="imp-cols">
            <div class="imp-col"><i>1</i><span><strong>Fecha Citación:</strong> Fecha programada</span></div>
            <div class="imp-col"><i>2</i><span><strong>Fecha Subida:</strong> Fecha al subir a sistema</span></div>
            <div class="imp-col"><i>3</i><span><strong>Última Carpeta:</strong> Fecha carpeta anterior</span></div>
            <div class="imp-col"><i>4</i><span><strong>Nombres / Apellidos:</strong> Ciudadano</span></div>
            <div class="imp-col"><i>5</i><span><strong>RUT:</strong> Con o sin puntos y guión</span></div>
            <div class="imp-col"><i>6</i><span><strong>Comuna:</strong> Comuna de procedencia</span></div>
            <div class="imp-col"><i>7</i><span><strong>Estado:</strong> 12 estados oficiales</span></div>
            <div class="imp-col"><i>8</i><span><strong>Decisión:</strong> Otorgado, Denegado, etc.</span></div>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? archivoSeleccionado;
    private bool cargando;
    private string? error;
    private ExcelImportResult? resultado;
    private AgendaImportResult? resultadoAgenda;

    // Presentation only: which step of the 3-step indicator is current / done.
    private int PasoNumero => (resultado is not null || resultadoAgenda is not null) ? 3 : cargando ? 2 : 1;
    private string PasoClase(int n) => n < PasoNumero || (n == 3 && PasoNumero == 3) ? "done" : n == PasoNumero ? "on" : string.Empty;
    private string? PasoActual(int n) => n == PasoNumero ? "step" : null;

    private async Task OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        archivoSeleccionado = e.File;
        error = null;
        resultado = null;
        resultadoAgenda = null;

        if (archivoSeleccionado is null) return;

        cargando = true;
        StateHasChanged();

        try
        {
            // Permitir archivos Excel de hasta 50MB
            using var stream = archivoSeleccionado.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            if (!Autor.HasNombre)
            {
                error = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de importar: queda registrado en el historial.";
                return;
            }
            var autor = Autor.Nombre!;
            if (AgendaImportService.EsFormatoAgenda(memoryStream))
            {
                resultadoAgenda = await AgendaImport.ImportarAsync(memoryStream, autor);
                _ = Modulos.RefrescarAsync();
            }
            else
            {
                resultado = await ExcelImport.ImportarExcelAsync(memoryStream, autor);
                _ = Modulos.RefrescarAsync();
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
