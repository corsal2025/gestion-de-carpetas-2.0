@page "/importar"
@using Sgl.Application.Carpetas
@using Sgl.Infrastructure.Carpetas
@using Microsoft.AspNetCore.Components.Sections
@inject ExcelImportService ExcelImport
@inject AgendaImportService AgendaImport
@inject AutorState Autor
@inject NavigationManager Nav
@inject ModulosState Modulos
@inject ILogger<Importar> Logger

<PageTitle>@TituloPagina.De("Cargar Excel")</PageTitle>

<div class="page-container imp-page">
    <header class="header-section imp-hero card">
        <span class="lico-slot head-art imp-lico" data-lico="saluda" aria-hidden="true"></span>
        <div class="imp-hero-t">
            <h1>Cargar agenda o planilla</h1>
            <a href="agenda/cancelaciones">Cancelaciones de agenda pendientes de revisión</a>
            <p class="subtitle">Conecte la carpeta de jefatura para recibir agendas automáticamente, importe varias agendas juntas o utilice la carga individual de una agenda o planilla.</p>
        </div>
    </header>

    <SectionOutlet SectionName="entrada-agendas" />

    <div class="card imp-panel">
        <h2>
            Carga individual: agenda o planilla
        </h2>
        <p class="imp-help">Elegir el archivo todavía no guarda datos. Revise el archivo elegido y pulse <strong>Importar archivo</strong>.</p>
        <ol class="imp-steps" aria-label="Pasos de la carga individual">
            <li class="imp-step @PasoClase(1)" aria-current="@PasoActual(1)"><i>1</i>Elegir archivo</li>
            <li class="imp-step @PasoClase(2)" aria-current="@PasoActual(2)"><i>2</i>Revisar y confirmar</li>
            <li class="imp-step @PasoClase(3)" aria-current="@PasoActual(3)"><i>3</i>Resultado</li>
        </ol>
        <p class="imp-help">
            Se detecta automáticamente el formato: <strong>agenda diaria</strong> (Excel .xlsx o listado .csv con Fecha Toma Cita, Fecha Cita, Hora Inicio, RUT, Trámite, Ubicación… → carpetas <em>Por clasificar</em>) o <strong>planilla DETALLE</strong> (solo .xlsx).
            En la planilla DETALLE el sistema detecta automáticamente las hojas de cada sede (<strong>AV. ARGENTINA</strong>, <strong>PLACILLA</strong>, <strong>MERC. PUERTO</strong>) y mapea las columnas de Fecha, RUT, Nombre, Apellido, Estado, Decisión y Comuna.
        </p>

        <div class="drop-zone">
            <div class="imp-drop-ico" aria-hidden="true">📊</div>
            <label class="btn-primary imp-browse">
                Examinar Archivo
                <InputFile @key="revisionArchivo" OnChange="OnArchivoSeleccionado" accept=".xlsx,.csv" class="imp-file" disabled="@cargando" />
            </label>
            <p class="imp-drop-note">
                @(archivoSeleccionado is not null ? $"Archivo listo: {archivoSeleccionado.Name} ({archivoSeleccionado.Size / 1024} KB)" : "o arrastre el archivo .xlsx o .csv aquí (hasta 50 MB)")
            </p>
        </div>

        @if (archivoSeleccionado is not null && resultado is null && resultadoAgenda is null)
        {
            <div class="imp-confirmacion" aria-label="Confirmar archivo">
                <p><strong>Archivo elegido:</strong> @archivoSeleccionado.Name. Al importar se crearán o actualizarán carpetas según el contenido del archivo.</p>
                <button type="button" class="btn-primary" disabled="@cargando" @onclick="ImportarSeleccionadoAsync">@(cargando ? "Importando…" : "Importar archivo")</button>
                <button type="button" class="btn-secondary" disabled="@cargando" @onclick="CancelarSeleccion">Cancelar selección</button>
            </div>
        }

        @if (cargando)
        {
            <div class="imp-box imp-loading" role="status">
                <div class="spinner"></div>
                <h3>Procesando e Integrando Planilla Excel...</h3>
                <p>
                    Leyendo filas, validando RUTs y sincronizando carpetas en la base de datos. Esto puede tardar unos segundos.
                </p>
            </div>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert error imp-box imp-error" role="alert">
                <span class="lico-slot lico-msg" data-lico="alerta" aria-hidden="true"></span>
                <span>⚠️ <strong>Error al cargar archivo:</strong> @error</span>
            </div>
        }

        @if (resultadoAgenda is not null)
        {
            <div class="imp-box imp-ok" role="status">
                <h3>✅ Agenda del día importada</h3>
                <p class="imp-sedes">Formato detectado: <strong>AGENDA</strong>. Las carpetas nuevas quedan en <strong>Licencias para clasificar</strong> (o en <strong>Revisión</strong> si tienen un problema). El correo y el teléfono de contacto quedan en la carpeta. Las citas canceladas se conservan para estadísticas sin nombre ni RUT en texto. Si su carpeta ya existía y no tenía trabajo, se anula conservando el historial; si tenía trabajo, queda pendiente de revisión.</p>
                <div class="imp-tiles">
                    <div class="imp-tile"><span class="imp-tile-label">Filas leídas</span><strong class="imp-tile-num">@resultadoAgenda.FilasLeidas.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">Carpetas creadas</span><strong class="imp-tile-num">+@resultadoAgenda.Creadas.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">Ya existían</span><strong class="imp-tile-num">@resultadoAgenda.YaExistian.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">Datos completados</span><strong class="imp-tile-num">@resultadoAgenda.Actualizadas.ToString("N0")</strong></div>
                    <div class="imp-tile" title="Filas ya importadas antes y anuladas (p. ej. por reagendamiento): no se vuelven a crear"><span class="imp-tile-label">Ya existían (anuladas)</span><strong class="imp-tile-num">@resultadoAgenda.YaExistianAnuladas.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">Canceladas omitidas</span><strong class="imp-tile-num">@resultadoAgenda.CanceladasOmitidas.ToString("N0")</strong></div>
                    <div class="imp-tile" title="Citas canceladas nuevas guardadas para las estadísticas, sin RUT ni nombre"><span class="imp-tile-label">Canceladas guardadas</span><strong class="imp-tile-num">+@resultadoAgenda.CanceladasGuardadas.ToString("N0")</strong></div>
                    <div class="imp-tile" title="Canceladas que ya estaban registradas de una carga anterior"><span class="imp-tile-label">Canceladas ya registradas</span><strong class="imp-tile-num">@resultadoAgenda.CanceladasYaRegistradas.ToString("N0")</strong></div>
                    <div class="imp-tile"><span class="imp-tile-label">RUT inválidos</span><strong class="imp-tile-num">@resultadoAgenda.FilasRutInvalido.Count.ToString("N0")</strong></div>
                    <div class="imp-tile @(resultadoAgenda.ConAlertaDuplicado > 0 ? "imp-tile-alerta" : null)"><span class="imp-tile-label">Con alerta de duplicado</span><strong class="imp-tile-num">@resultadoAgenda.ConAlertaDuplicado.ToString("N0")</strong></div>
                </div>
                @if (resultadoAgenda.FilasConCambiosPorRevisar.Count > 0)
                {
                    <p class="imp-sedes imp-note">⚠️ Citas existentes con datos distintos que no se sobrescribieron. Revisar filas del archivo: @string.Join(", ", resultadoAgenda.FilasConCambiosPorRevisar).</p>
                }
                @if (resultadoAgenda.FilasSinImportarPorRevision.Count > 0)
                {
                    <p class="imp-sedes imp-note" role="alert">⚠️ Estas filas <strong>no se importaron</strong>: no fue posible identificar la cita sin ambigüedad. Revisar el archivo original, filas: @string.Join(", ", resultadoAgenda.FilasSinImportarPorRevision).</p>
                }
                @if (resultadoAgenda.FilasCanceladasConCarpetaAmbigua.Count > 0)
                {
                    <p class="imp-sedes imp-note" role="alert">⚠️ Estas cancelaciones se registraron para estadísticas, pero no se vincularon a ninguna carpeta porque hay varias coincidencias: @string.Join(", ", resultadoAgenda.FilasCanceladasConCarpetaAmbigua).</p>
                }
                @if (resultadoAgenda.FilasConCambiosPorRevisar.Count > 0 || resultadoAgenda.FilasSinImportarPorRevision.Count > 0 || resultadoAgenda.FilasCanceladasConCarpetaAmbigua.Count > 0)
                {
                    <a class="btn-secondary" download="revision-agenda.txt" href="@($"data:text/plain;charset=utf-8,{Uri.EscapeDataString($"Citas existentes con cambios: {string.Join(", ", resultadoAgenda.FilasConCambiosPorRevisar)}\nFilas no importadas por ambigüedad: {string.Join(", ", resultadoAgenda.FilasSinImportarPorRevision)}\nCancelaciones sin carpeta identificada: {string.Join(", ", resultadoAgenda.FilasCanceladasConCarpetaAmbigua)}\nLos números corresponden a las filas del archivo de agenda original.")}")">Descargar filas por revisar</a>
                }
                @if (resultadoAgenda.ConAlertaDuplicado > 0)
                {
                    <p class="imp-sedes imp-note">⚠️ @resultadoAgenda.ConAlertaDuplicado.ToString("N0") @(resultadoAgenda.ConAlertaDuplicado == 1 ? "fila tiene" : "filas tienen") RUT con carpeta abierta: aparecen en rojo en <a href="carpetas?bandeja=RevisionDuplicadas">Revisión › Duplicadas</a> con las acciones Reagendar, Anular duplicada o Mantener ambas.</p>
                }
                @if (resultadoAgenda.CanceladasDeCarpetaExistente > 0)
                {
                    <p class="imp-sedes imp-note">ℹ️ @resultadoAgenda.CanceladasDeCarpetaExistente.ToString("N0") @(resultadoAgenda.CanceladasDeCarpetaExistente == 1 ? "carpeta ya creada llegó cancelada" : "carpetas ya creadas llegaron canceladas"): se revisaron conservando su historial. @resultadoAgenda.CanceladasAnuladas se anularon automáticamente por no tener trabajo; @resultadoAgenda.CanceladasConTrabajoPendiente requieren revisión. <a href="agenda/cancelaciones">Revisar cancelaciones pendientes</a>.</p>
                }
                @if (resultadoAgenda.CanceladasConTrabajoPendiente > 0)
                {
                    <p class="imp-sedes imp-note" role="alert">Hay @resultadoAgenda.CanceladasConTrabajoPendiente cancelación(es) de carpetas con trabajo o restauradas que requieren decisión. <a href="agenda/cancelaciones">Abrir revisión persistente</a>.</p>
                }
                @if (resultadoAgenda.FilasActivasCanceladas.Count > 0)
                {
                    <p class="imp-sedes imp-note" role="alert">No se reactivaron estas reservas porque ya constan canceladas en una carga actual o anterior: @string.Join(", ", resultadoAgenda.FilasActivasCanceladas). Revise el archivo más reciente y el historial.</p>
                }
                @if (resultadoAgenda.FilasRutInvalido.Count > 0)
                {
                    <p class="imp-sedes imp-note">⚠️ RUT inválido (no se creó carpeta) en filas: @string.Join(", ", resultadoAgenda.FilasRutInvalido)</p>
                }
                @if (resultadoAgenda.Errores.Count > 0)
                {
                    <div class="imp-obs">
                        <span class="imp-obs-title">Filas no importadas:</span>
                        <ul class="imp-obs-list">
                            @foreach (var err in resultadoAgenda.Errores)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
                <div class="imp-cta">
                    <a href="carpetas?bandeja=PorClasificar" class="btn-primary">
                        🗂️ Ir a Licencias para clasificar →
                    </a>
                </div>
            </div>
        }

        @if (resultado is not null)
        {
            <div class="imp-box imp-ok" role="status">
                <h3>
                    <span class="lico-slot lico-msg" data-lico="celebra" aria-hidden="true"></span>
                    ✅ Integración Completada con Éxito
                </h3>

                <div class="imp-tiles">
                    <div class="imp-tile">
                        <span class="imp-tile-label">Filas Leídas</span>
                        <strong class="imp-tile-num">@resultado.FilasLeidas.ToString("N0")</strong>
                    </div>
                    <div class="imp-tile">
                        <span class="imp-tile-label">Carpetas Creadas</span>
                        <strong class="imp-tile-num">+@resultado.CarpetasCreadas.ToString("N0")</strong>
                    </div>
                    <div class="imp-tile">
                        <span class="imp-tile-label">Carpetas Actualizadas</span>
                        <strong class="imp-tile-num">@resultado.CarpetasActualizadas.ToString("N0")</strong>
                    </div>
                    <div class="imp-tile">
                        <span class="imp-tile-label">Nuevos Ciudadanos</span>
                        <strong class="imp-tile-num">+@resultado.CiudadanosCreados.ToString("N0")</strong>
                    </div>
                </div>

                <p class="imp-sedes">
                    🏛️ <strong>Sedes procesadas:</strong> @(string.Join(", ", resultado.SedesProcesadas))
                </p>

                @if (resultado.ComunasNoReconocidas > 0)
                {
                    <div class="imp-sedes imp-note">⚠️ <strong>@resultado.ComunasNoReconocidas.ToString("N0")</strong> fila(s) con comuna no reconocida: se importaron sin comuna (el resto de los datos sí se aplicó).</div>
                }

                @if (resultado.EstadosNoAplicados > 0)
                {
                    <div class="imp-sedes imp-note">⚠️ <strong>@resultado.EstadosNoAplicados.ToString("N0")</strong> carpeta(s) existente(s) conservaron su estado: el del Excel era atrasado o no alcanzable.</div>
                }

                @if (resultado.Avisos.Count > 0)
                {
                    <div class="imp-obs">
                        <span class="imp-obs-title">Avisos (la fila sí se importó; revise los datos):</span>
                        <ul class="imp-obs-list">
                            @foreach (var aviso in resultado.Avisos)
                            {
                                <li>@aviso</li>
                            }
                            @if (resultado.AvisosTotal > resultado.Avisos.Count)
                            {
                                <li>… y @((resultado.AvisosTotal - resultado.Avisos.Count).ToString("N0")) más</li>
                            }
                        </ul>
                    </div>
                }

                @if (resultado.Errores.Count > 0)
                {
                    <div class="imp-obs">
                        <span class="imp-obs-title">Observaciones en algunas filas (omitidas, no se importaron):</span>
                        <ul class="imp-obs-list">
                            @foreach (var err in resultado.Errores)
                            {
                                <li>@err</li>
                            }
                        </ul>
                        @if (resultado.TotalErrores > resultado.Errores.Count)
                        {
                            <span class="imp-obs-more">y @(resultado.TotalErrores - resultado.Errores.Count) errores más</span>
                        }
                    </div>
                }

                <div class="imp-cta">
                    <a href="carpetas" class="btn-primary">
                        📋 Ver Listado de Carpetas Actualizado →
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Guía de formato de columnas soportadas -->
    <div class="card imp-guide">
        <h3>
            ℹ️ Formato de Columnas Compatibles del Excel
        </h3>
        <p class="imp-help">
            El importador acepta tanto los libros multicapa oficiales del departamento como planillas personalizadas.
        </p>

        <div class="imp-cols">
            <div class="imp-col"><i>1</i><span><strong>Fecha Citación:</strong> Fecha programada</span></div>
            <div class="imp-col"><i>2</i><span><strong>Fecha Subida:</strong> Fecha al subir a sistema</span></div>
            <div class="imp-col"><i>3</i><span><strong>Última Carpeta:</strong> Fecha carpeta anterior</span></div>
            <div class="imp-col"><i>4</i><span><strong>Nombres / Apellidos:</strong> Ciudadano</span></div>
            <div class="imp-col"><i>5</i><span><strong>RUT:</strong> Con o sin puntos y guión</span></div>
            <div class="imp-col"><i>6</i><span><strong>Comuna:</strong> Comuna de procedencia</span></div>
            <div class="imp-col"><i>7</i><span><strong>Estado:</strong> 12 estados oficiales</span></div>
            <div class="imp-col"><i>8</i><span><strong>Decisión:</strong> Otorgado, Denegado, etc.</span></div>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? archivoSeleccionado;
    private int revisionArchivo;
    private bool cargando;
    private string? error;
    private ExcelImportResult? resultado;
    private AgendaImportResult? resultadoAgenda;

    // Presentation only: which step of the 3-step indicator is current / done.
    private int PasoNumero => (resultado is not null || resultadoAgenda is not null) ? 3 : archivoSeleccionado is not null ? 2 : 1;
    private string PasoClase(int n) => n < PasoNumero || (n == 3 && PasoNumero == 3) ? "done" : n == PasoNumero ? "on" : string.Empty;
    private string? PasoActual(int n) => n == PasoNumero ? "step" : null;

    private void OnArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        archivoSeleccionado = e.File;
        error = null;
        resultado = null;
        resultadoAgenda = null;
    }

    private void CancelarSeleccion()
    {
        archivoSeleccionado = null;
        revisionArchivo++;
        error = null;
    }

    private async Task ImportarSeleccionadoAsync()
    {
        if (archivoSeleccionado is null || cargando) return;
        error = null;

        cargando = true;
        StateHasChanged();

        try
        {
            // Permitir archivos Excel de hasta 50MB
            using var stream = archivoSeleccionado.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            if (!Autor.HasNombre)
            {
                error = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de importar: queda registrado en el historial.";
                return;
            }
            var autor = Autor.Nombre!;
            if (AgendaImportService.EsFormatoAgenda(memoryStream))
            {
                resultadoAgenda = await AgendaImport.ImportarAsync(memoryStream, autor);
                _ = Modulos.RefrescarAsync();
            }
            else if (!AgendaTabla.EsXlsx(memoryStream))
            {
                error = "El archivo no es un Excel (.xlsx) ni una agenda (.csv) con las columnas esperadas: Fecha Cita, Hora Inicio, RUT, Nombre, Trámite y Ubicación.";
            }
            else
            {
                resultado = await ExcelImport.ImportarExcelAsync(memoryStream, autor);
                _ = Modulos.RefrescarAsync();
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            error = ErroresUi.Mensaje(ex, Logger, "Error al importar el Excel");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
}
