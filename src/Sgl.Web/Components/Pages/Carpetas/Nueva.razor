@page "/carpetas/nueva"
@using System.ComponentModel.DataAnnotations
@inject CarpetaService Carpetas
@inject AutorState Autor
@inject ILogger<Nueva> Logger
@inject NavigationManager Nav
@inject DuplicadosNotifier DuplicadosNotifier

<PageTitle>@TituloPagina.De("Nueva carpeta")</PageTitle>

<h1>Nueva carpeta</h1>

<EditForm Model="model" OnValidSubmit="GuardarAsync" FormName="nueva-carpeta" class="card form">
    <DataAnnotationsValidator />

    <label>RUT
        <InputText @bind-Value="model.Rut" placeholder="12.345.678-5" />
        <ValidationMessage For="() => model.Rut" />
    </label>
    <label>Nombre
        <InputText @bind-Value="model.Nombre" />
        <ValidationMessage For="() => model.Nombre" />
    </label>
    <label>Apellido
        <InputText @bind-Value="model.Apellido" />
        <ValidationMessage For="() => model.Apellido" />
    </label>
    <label>Sede
        <InputSelect @bind-Value="model.Sede">
            @foreach (var s in Enum.GetValues<Sede>())
            {
                <option value="@s">@Labels.Of(s)</option>
            }
        </InputSelect>
    </label>
    <label>Fecha de citación
        <InputDate @bind-Value="model.FechaCitacion" />
    </label>
    <div class="field">
        <span>Clase de licencia</span>
        <ClasesSelector @bind-Value="model.Clases" />
    </div>

    <AvisoDuplicado Verificacion="duplicado" Ocupado="guardando" OnConfirmar="ConfirmarDuplicadoAsync" OnCancelar="() => duplicado = null" />

    @if (error is not null)
    {
        <p class="error" role="alert"><span class="lico-slot lico-msg" data-lico="alerta" aria-hidden="true"></span><span>@error</span></p>
    }

    <div class="actions">
        <button type="submit" disabled="@guardando">Registrar</button>
        <a class="button secondary" href="carpetas">Cancelar</a>
    </div>
</EditForm>

@code {
    private readonly FormModel model = new();
    private string? error;
    private VerificacionDuplicadoDto? duplicado;
    private bool guardando;

    private Task GuardarAsync() => RegistrarAsync(confirmarDuplicado: false);

    private Task ConfirmarDuplicadoAsync() => RegistrarAsync(confirmarDuplicado: true);

    private async Task RegistrarAsync(bool confirmarDuplicado)
    {
        error = null;
        duplicado = null;
        if (!Autor.HasNombre)
        {
            error = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de registrar.";
            return;
        }

        guardando = true;
        try
        {
            var id = await Carpetas.RegistrarAsync(new RegistrarCarpetaCommand(
                model.Rut, model.Nombre, model.Apellido, model.Sede, model.FechaCitacion, Autor.Nombre,
                model.Clases, confirmarDuplicado));
            DuplicadosNotifier.Notify();
            Nav.NavigateTo($"carpetas/{id}");
        }
        catch (CarpetaDuplicadaException ex)
        {
            duplicado = ex.Verificacion;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            error = ErroresUi.Mensaje(ex, Logger, "Error al crear la carpeta");
        }
        finally
        {
            guardando = false;
        }
    }

    private sealed class FormModel
    {
        [Required(ErrorMessage = "El RUT es obligatorio.")]
        public string Rut { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre es obligatorio."), MaxLength(Ciudadano.MaxNameLength)]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "El apellido es obligatorio."), MaxLength(Ciudadano.MaxNameLength)]
        public string Apellido { get; set; } = string.Empty;

        public Sede Sede { get; set; } = Sede.AvArgentina;

        public DateOnly FechaCitacion { get; set; } = HoraChile.Fecha(DateTime.UtcNow);

        public ClaseLicencia Clases { get; set; }
    }
}
