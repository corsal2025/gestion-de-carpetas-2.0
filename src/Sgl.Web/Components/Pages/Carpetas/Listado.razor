    // Quick-Add agenda rápido
    private bool mostrarAcordeonNuevo;
    private string nuevoRut = "";
    private string nuevoNombre = "";
    private string nuevoApellido = "";
    private Sede nuevaSede = Sede.AvArgentina;
    private DateOnly nuevaFechaCitacion = HoraChile.Fecha(DateTime.UtcNow);
    private ClaseLicencia nuevasClases;
    private bool guardandoNuevo;
    private string? errorNuevo;
    private VerificacionDuplicadoDto? duplicadoNuevo;

    private async Task RegistrarCarpetaRapidaAsync(bool confirmarDuplicado = false)
    {
        if (string.IsNullOrWhiteSpace(nuevoRut) || string.IsNullOrWhiteSpace(nuevoNombre) || string.IsNullOrWhiteSpace(nuevoApellido))
        {
            errorNuevo = "Por favor complete RUT, Nombre y Apellido.";
            return;
        }

        guardandoNuevo = true;
        errorNuevo = null;
        duplicadoNuevo = null;

        try
        {
            if (AutorRequerido() is not { } autor) return;
            var id = await Carpetas.RegistrarAsync(new RegistrarCarpetaCommand(
                nuevoRut.Trim(),
                nuevoNombre.Trim(),
                nuevoApellido.Trim(),
                nuevaSede,
                nuevaFechaCitacion,
                autor,
                nuevasClases,
                confirmarDuplicado));
            DuplicadosNotifier.Notify();

            nuevoRut = "";
            nuevasClases = ClaseLicencia.Ninguna;
            nuevoNombre = "";
            nuevoApellido = "";
            nuevaFechaCitacion = HoraChile.Fecha(DateTime.UtcNow);
            mostrarAcordeonNuevo = false;

            guardadoOkId = id;
            await CargarMetricasAsync();
            await CargarAsync();
            await JS.InvokeVoidAsync("showRutToast", "Carpeta agregada con éxito a la agenda.");

            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                if (guardadoOkId == id)
                {
                    guardadoOkId = null;
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
        catch (CarpetaDuplicadaException ex)
        {
            duplicadoNuevo = ex.Verificacion;
        }
        catch (Exception ex)
        {
            errorNuevo = ex.Message;
        }
        finally
        {
            guardandoNuevo = false;
        }
    }

