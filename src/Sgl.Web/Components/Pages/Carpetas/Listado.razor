                    <span class="sede-tag">@Labels.Of(drawerDetalle.Sede)</span>
                    @if (!string.IsNullOrEmpty(drawerDetalle.CajaArchivo))
                    {
                        <span class="badge info">📦 @drawerDetalle.CajaArchivo</span>
                    }
