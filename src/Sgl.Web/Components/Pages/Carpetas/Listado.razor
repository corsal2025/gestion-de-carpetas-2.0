    /// <summary>Recalcula el total con los filtros actuales y refresca las filas visibles del virtualizador.</summary>

    private async Task CargarAsync(bool refrescarPanel = true)
    {
        InvalidarIds();
        var conteo = await Carpetas.ListarAsync(ConsultaActual(take: 0));
        // Contadores del menú lateral e inicio: en su propio scope (no comparte este DbContext), sin bloquear la tabla.
        // En la primera carga no hace falta: el menú lateral ya refresca al montarse.
        if (refrescarPanel) _ = Modulos.RefrescarAsync();
        var antes = total;
        var eraDirecta = filasDirectas is not null;
        await CargarFilasDirectasAsync(conteo.Total);
        total = conteo.Total;
        if (filasDirectas is null && !eraDirecta && virtualizador is not null && antes is > 0 && total > 0)
        {
            await virtualizador.RefreshDataAsync();
        }
        StateHasChanged();
    }

    // Big trays: the ordered ids are loaded once (own scope) and every window is then read by primary key,
    // instead of re-sorting the whole table with OFFSET on each scroll. The order is shared state that other
    // circuits (or an import) can invalidate: it is re-validated against a cheap data-version stamp every few
    // seconds and dropped as soon as a window comes back short (see OrdenCacheado).
    private readonly OrdenCacheado orden = new();

    [Inject] private TimeProvider Reloj { get; set; } = default!;

    private void InvalidarIds() => orden.Invalidar();

    private void IniciarCargaIds()
    {
        if (!orden.IniciarCarga(out var generacion)) return;
        var consulta = ConsultaActual();
        _ = Task.Run(async () =>
        {
            try
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                var svc = scope.ServiceProvider.GetRequiredService<CarpetaService>();
                // The stamp is read BEFORE the ids: a change in between only costs one extra reload, never a stale hit.
                var version = await svc.ObtenerVersionDatosAsync();
                var ids = await svc.ListarIdsAsync(consulta);
                // Compile the by-ids query shape now (own scope), so the first far jump does not pay for it.
                if (ids.Count > 0) _ = await svc.ListarAsync(consulta with { Ids = [ids[0]] });
                await InvokeAsync(() => orden.Completar(generacion, ids.ToList(), version, Reloj.GetUtcNow()));
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Logger.LogWarning(ex, "No se pudo precargar el orden de la bandeja.");
                await InvokeAsync(() => orden.CargaFallida(generacion));
            }
        });
    }

    private async Task<bool> OrdenSigueVigenteAsync()
    {
        var ahora = Reloj.GetUtcNow();
        if (!orden.DebeVerificar(ahora)) return true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var version = await scope.ServiceProvider.GetRequiredService<CarpetaService>().ObtenerVersionDatosAsync();
            return orden.Verificar(version, ahora);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Unable to verify: do not trust the cache.
            Logger.LogWarning(ex, "No se pudo verificar el orden cacheado de la bandeja.");
            orden.Invalidar();
            return false;
        }
    }

    private async ValueTask<ItemsProviderResult<CarpetaResumenDto>> CargarFilasAsync(ItemsProviderRequest request)
    {
        var caducado = !await OrdenSigueVigenteAsync();
        ListResult<CarpetaResumenDto> rango;
        var ids = orden.Ids;
        if (ids is not null && request.StartIndex < ids.Count)
        {
            var corte = ids.Skip(request.StartIndex).Take(request.Count).ToArray();
            var porIds = await Carpetas.ListarAsync(ConsultaActual() with { Ids = corte }, request.CancellationToken);
            if (orden.ValidarVentana(corte.Length, porIds.Items.Count))
            {
                rango = new ListResult<CarpetaResumenDto>(porIds.Items, ids.Count);
            }
            else
            {
                // A row of this window left the tray (moved/annulled elsewhere): read the live window and rebuild the order.
                caducado = true;
                rango = await Carpetas.ListarAsync(ConsultaActual(request.StartIndex, request.Count), request.CancellationToken);
                IniciarCargaIds();
            }
        }
        else
        {
            rango = await Carpetas.ListarAsync(ConsultaActual(request.StartIndex, request.Count), request.CancellationToken);
            IniciarCargaIds();
        }

        foreach (var item in rango.Items)
        {
            if (seleccionadas.Contains(item.Id))
            {
                itemsSeleccionadosMap[item.Id] = item;
            }
        }

        if (total != rango.Total)
        {
            total = rango.Total;
            _ = InvokeAsync(StateHasChanged);
        }

        if (caducado)
        {
            // Windows rendered earlier came from the stale order: re-read them (the next call finds no cached ids).
            _ = InvokeAsync(async () =>
            {
                if (virtualizador is not null) await virtualizador.RefreshDataAsync();
            });
        }

        return new ItemsProviderResult<CarpetaResumenDto>(rango.Items, rango.Total);
    }

