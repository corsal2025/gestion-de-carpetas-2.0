    // ==========================================================================
    // REGLA DE NEGOCIO: CÁLCULO DE SECTOR E IMPRESIÓN OFICIAL PDF
    // ==========================================================================
    private static readonly DateOnly CutoffSectorJulio2023 = new(2023, 7, 1);
    private static readonly string[] SpanishMonthNames =
    [
        "enero", "febrero", "marzo", "abril", "mayo", "junio",
        "julio", "agosto", "septiembre", "octubre", "noviembre", "diciembre"
    ];

    private static string CalcularSector(string? fechaStr) => SectorFisico.Calcular(fechaStr);

    private static string FormatearFechaFormal(string? fechaStr)
    {
        if (string.IsNullOrWhiteSpace(fechaStr)) return "—";

        if (DateOnly.TryParse(fechaStr, CultureInfo.InvariantCulture, out var d)
            || DateOnly.TryParse(fechaStr, CultureInfo.GetCultureInfo("es-CL"), out d)
            || DateOnly.TryParse(fechaStr, out d)
            || SpanishDateTryParse(fechaStr, out d))
        {
            return $"{d.Day} {SpanishMonthNames[d.Month - 1].ToUpperInvariant()} {d.Year}";
        }

        return fechaStr.ToUpperInvariant();
    }

    private static bool SpanishDateTryParse(string? input, out DateOnly date)
    {
        date = default;
        if (string.IsNullOrWhiteSpace(input)) return false;

        var words = input
            .Split(new[] { ' ', '\t', ',', '/', '-', '.' }, StringSplitOptions.RemoveEmptyEntries)
            .Where(w => !w.Equals("de", StringComparison.OrdinalIgnoreCase) && !w.Equals("del", StringComparison.OrdinalIgnoreCase))
            .ToArray();

        if (words.Length != 3 || !int.TryParse(words[0], out var day)) return false;

        var months = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
        {
            ["enero"] = 1, ["febrero"] = 2, ["marzo"] = 3, ["abril"] = 4,
            ["mayo"] = 5, ["junio"] = 6, ["julio"] = 7, ["agosto"] = 8,
            ["septiembre"] = 9, ["setiembre"] = 9, ["octubre"] = 10,
            ["noviembre"] = 11, ["diciembre"] = 12
        };

        if (!months.TryGetValue(words[1], out var month) && (!int.TryParse(words[1], out month) || month < 1 || month > 12))
            return false;

        if (!int.TryParse(words[2], out var year)) return false;
        if (words[2].Length <= 2) year += year >= 50 ? 1900 : 2000;
        if (year < 1900 || year > 2100 || day < 1 || day > DateTime.DaysInMonth(year, month)) return false;

        date = new DateOnly(year, month, day);
        return true;
    }

