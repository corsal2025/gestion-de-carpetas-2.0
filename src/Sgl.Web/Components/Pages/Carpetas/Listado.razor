    // ---- Clasificación manual (bandeja Por clasificar) ----
    private readonly Dictionary<Guid, EstadoCarpeta?> destinoClasif = new();
    private readonly Dictionary<Guid, string?> fechaClasif = new();
    private readonly Dictionary<Guid, string?> comunaClasif = new();
    private readonly Dictionary<Guid, ClaseLicencia> clasesClasif = new();
    private ClaseLicencia clasesLote;

    /// <summary>"" = nothing chosen, <see cref="LoteBuscar"/> = default action by stored date, otherwise an EstadoCarpeta name.</summary>
    private string? destinoLote;
    private const string LoteBuscar = "BUSCAR";

    // ---- Alerta de duplicado (R2): reagendar / crear nueva / anular duplicada ----
    private readonly HashSet<Guid> alertasDescartadas = [];

    private bool MuestraAlerta(CarpetaResumenDto c) => c.AlertaDuplicado is not null && !alertasDescartadas.Contains(c.Id);

    // ---- Errores de edición en línea: siempre registrados (sin datos personales) y visibles ----
    private string? errorEdicion;

    private void MostrarErrorEdicion(Exception ex, string contexto)
    {
        if (ex is DomainException or NotFoundException or CarpetaDuplicadaException)
        {
            errorEdicion = ex.Message;
            return;
        }
        Logger.LogError(ex, "{Contexto} en el listado de carpetas.", contexto);
        errorEdicion = $"{contexto}. Intente nuevamente.";
    }

    private string AutorActual => Autor.HasNombre ? Autor.Nombre : throw new DomainException(MensajeSinNombre);

    private const string MensajeSinNombre = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de modificar carpetas.";

    /// <summary>Every change is attributed to a real official: without a name nothing is saved and a message is shown.</summary>
    private string? AutorRequerido()
    {
        if (Autor.HasNombre) return Autor.Nombre;
        errorEdicion = MensajeSinNombre;
        errorClasif = MensajeSinNombre;
        return null;
    }
    private bool clasificando;
    private string? errorClasif;

    private string? FechaClasif(Guid id) => fechaClasif.GetValueOrDefault(id);

    private void SeleccionarDestino(Guid id, ChangeEventArgs e) =>
        destinoClasif[id] = Enum.TryParse<EstadoCarpeta>(e.Value?.ToString(), out var d) ? d : null;

    /// <summary>R6: the destination "Buscar carpeta física" proposes from the typed date (null when no readable date).</summary>
    private EstadoCarpeta? DestinoPorFecha(Guid id) => Carpeta.DestinoPorFechaUltimaCarpeta(fechaClasif.GetValueOrDefault(id));

    private string TituloAplicar(Guid id)
    {
        if (clasesClasif.GetValueOrDefault(id) == ClaseLicencia.Ninguna) return "Marque al menos una clase de licencia";
        if (destinoClasif.GetValueOrDefault(id) is null && DestinoPorFecha(id) is null) return "Escriba la fecha de la última carpeta o elija un estado";
        return "Clasificar";
    }

    private readonly HashSet<Guid> intentoAplicar = [];

    /// <summary>What is still missing before a row can be classified (null when it is ready). Shown after the first click.</summary>
    private string? Faltantes(Guid id)
    {
        var sinClase = clasesClasif.GetValueOrDefault(id) == ClaseLicencia.Ninguna;
        var sinDestino = destinoClasif.GetValueOrDefault(id) is null && DestinoPorFecha(id) is null;
        return (sinClase, sinDestino) switch
        {
            (true, true) => "Falta marcar la clase de licencia y escribir la fecha de la última carpeta (dd-mm-aaaa) o elegir un estado.",
            (true, false) => "Falta marcar al menos una clase de licencia (botón «Clase»).",
            (false, true) => "Falta escribir la fecha de la última carpeta (dd-mm-aaaa) o elegir un estado.",
            _ => null,
        };
    }

    private Task ClasificarUnaAsync(Guid id)
    {
        intentoAplicar.Add(id);
        if (Faltantes(id) is not null) return Task.CompletedTask;
        var elegido = destinoClasif.GetValueOrDefault(id);
        if (elegido is null && DestinoPorFecha(id) is null) return Task.CompletedTask;
        // No explicit state => null: the service applies the default action from the date.
        return EjecutarClasificacionAsync([id], elegido, clasesClasif.GetValueOrDefault(id), fechaClasif.GetValueOrDefault(id),
            elegido is { } d && Carpeta.EsCambioDomicilio(d) ? comunaClasif.GetValueOrDefault(id) : null);
    }

    private async Task ClasificarLoteAsync()
    {
        if (seleccionadas.Count == 0) return;
        if (string.IsNullOrEmpty(destinoLote))
        {
            errorClasif = "Elija en el selector cómo clasificar las carpetas marcadas.";
            return;
        }
        if (clasesLote == ClaseLicencia.Ninguna)
        {
            errorClasif = "Marque al menos una clase de licencia para clasificar.";
            return;
        }
        EstadoCarpeta? destino = destinoLote == LoteBuscar ? null
            : Enum.TryParse<EstadoCarpeta>(destinoLote, out var d) ? d : null;
        if (destinoLote != LoteBuscar && destino is null) return;
        var cuando = destino is { } e ? $"como «{Labels.Of(e)}»" : "con «Buscar carpeta física» (según la fecha de última carpeta de cada una)";
        var mensaje = $"¿Clasificar {seleccionadas.Count} carpetas {cuando} con clase {Labels.Of(clasesLote)}?";
        if (!await JS.InvokeAsync<bool>("confirm", mensaje)) return;
        await EjecutarClasificacionAsync(seleccionadas.ToList(), destino, clasesLote, null, null);
    }

    private async Task EjecutarClasificacionAsync(IReadOnlyList<Guid> ids, EstadoCarpeta? destino, ClaseLicencia clases, string? fecha, string? comuna)
    {
        if (clases == ClaseLicencia.Ninguna)
        {
            errorClasif = "Marque al menos una clase de licencia para clasificar.";
            return;
        }
        clasificando = true;
        errorClasif = null;
        try
        {
            if (AutorRequerido() is not { } autor) return;
            var resultado = await Carpetas.ClasificarAsync(new ClasificarCommand(ids, destino, clases, fecha, comuna, autor));
            OfrecerListadoBusqueda(resultado);
            foreach (var id in ids)
            {
                destinoClasif.Remove(id);
                fechaClasif.Remove(id);
                comunaClasif.Remove(id);
                clasesClasif.Remove(id);
                intentoAplicar.Remove(id);
                alertasDescartadas.Remove(id);
            }
            CancelarSeleccion();
            destinoLote = null;
            clasesLote = ClaseLicencia.Ninguna;
            await CargarMetricasAsync();
            await CargarAsync();
        }
        catch (CarpetaDuplicadaException ex)
        {
            errorClasif = ex.Bloqueante
                ? "Bloqueado: este RUT ya tiene una carpeta abierta con la misma clase. Búsquela en el sistema y resuélvala en «Posibles duplicados»."
                : ex.Message;
        }
        catch (Exception ex) when (ex is DomainException or NotFoundException)
        {
            errorClasif = ex.Message;
        }
        finally
        {
            clasificando = false;
        }
    }

