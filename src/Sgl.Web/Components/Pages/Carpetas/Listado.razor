@page "/carpetas"
@layout ModuloLayout
@implements IDisposable
@using System.Globalization
@inject CarpetaService Carpetas
@inject ModulosState Modulos
@inject ILogger<Listado> Logger
@inject AutorState Autor
@inject IJSRuntime JS
@inject DuplicadosNotifier DuplicadosNotifier

<PageTitle>@TituloPagina.De(TituloModuloPdf)</PageTitle>

<datalist id="lista-comunas-chile">
    @foreach (var comuna in Sgl.Domain.ComunasChile.Todas)
    {
        <option value="@comuna"></option>
    }
</datalist>

<div class="page-container">
    <!-- Panel estático y fijo de filtros, sedes y búsqueda siempre visible -->
    <div class="sticky-controls-panel">
        <button type="button" class="btn-panel-toggle @(mostrarPanelSuperior ? "open" : "")" @onclick="TogglePanelSuperiorAsync" title="Mostrar u ocultar sedes y acciones">
            <span>@(mostrarPanelSuperior ? "Ocultar sedes y acciones" : "Mostrar sedes y acciones")</span>
            @if (!mostrarPanelSuperior)
            {
                <span class="panel-toggle-resumen">@(filtroSede is null ? "TODAS" : Labels.Of(filtroSede.Value)) · @(seleccionadas.Count) MARCADAS</span>
            }
        </button>
        @if (mostrarPanelSuperior)
        {
        <div class="sede-tabs-container">
            <div class="sede-pills">
                <button class="pill @(filtroSede is null ? "active" : "")" @onclick="() => SeleccionarSede(null)">
                    Todas <span class="badge-count">@(stats?.TotalCarpetas ?? 0)</span>
                </button>
                <button class="pill @(filtroSede == Sede.AvArgentina ? "active" : "")" @onclick="() => SeleccionarSede(Sede.AvArgentina)">
                    Av. Argentina <span class="badge-count">@(GetCount(Sede.AvArgentina))</span>
                </button>
                <button class="pill @(filtroSede == Sede.Placilla ? "active" : "")" @onclick="() => SeleccionarSede(Sede.Placilla)">
                    Placilla <span class="badge-count">@(GetCount(Sede.Placilla))</span>
                </button>
                <button class="pill @(filtroSede == Sede.MercadoPuerto ? "active" : "")" @onclick="() => SeleccionarSede(Sede.MercadoPuerto)">
                    Mercado Puerto <span class="badge-count">@(GetCount(Sede.MercadoPuerto))</span>
                </button>
            </div>

            <!-- Pestañas PDF Sector: Archivo y Oficina 43 (se activan al seleccionar carpetas) -->
            <div class="pdf-sector-pills" title="Generar e imprimir listado oficial de carpetas según sector">
                <button class="btn-pdf-pill btn-pdf-archivo @(conteoArchivoSeleccionadas > 0 ? "active" : "disabled")"
                        @onclick='() => AbrirModalPdfSector("ARCHIVO")'
                        disabled="@(conteoArchivoSeleccionadas == 0)"
                        type="button"
                        title="@(conteoArchivoSeleccionadas > 0 ? $"Generar e imprimir PDF Archivo ({conteoArchivoSeleccionadas} carpetas marcadas)" : "Seleccione carpetas de sector Archivo (fecha < julio 2023) para activar")">
                    <svg class="pdf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>PDF Archivo</span>
                    @if (conteoArchivoSeleccionadas > 0)
                    {
                        <span class="pdf-count-badge">@conteoArchivoSeleccionadas</span>
                    }
                </button>
                <button class="btn-pdf-pill btn-pdf-oficina43 @(conteoOficina43Seleccionadas > 0 ? "active" : "disabled")"
                        @onclick='() => AbrirModalPdfSector("OFICINA 43")'
                        disabled="@(conteoOficina43Seleccionadas == 0)"
                        type="button"
                        title="@(conteoOficina43Seleccionadas > 0 ? $"Generar e imprimir PDF Oficina 43 ({conteoOficina43Seleccionadas} carpetas marcadas)" : "Seleccione carpetas de sector Oficina 43 (fecha >= julio 2023) para activar")">
                    <svg class="pdf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>PDF Oficina 43</span>
                    @if (conteoOficina43Seleccionadas > 0)
                    {
                        <span class="pdf-count-badge gold">@conteoOficina43Seleccionadas</span>
                    }
                </button>
            </div>

            <div class="quick-actions">
                <button class="btn-toggle-filters @(mostrarFiltros ? "active" : "")" @onclick="ToggleFiltros" type="button" title="Mostrar u ocultar panel de filtros y búsqueda">
                    @((MarkupString)"<svg class=\"ico\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0\"/><circle cx=\"16\" cy=\"6\" r=\"2\"/><circle cx=\"10\" cy=\"12\" r=\"2\"/><circle cx=\"18\" cy=\"18\" r=\"2\"/></svg>")<span>@(mostrarFiltros ? "Ocultar filtros" : "Filtros y búsqueda")</span>
                    @if (FiltrosActivosCount > 0)
                    {
                        <span class="badge-filtros-activos" title="@FiltrosActivosCount filtros activos">@FiltrosActivosCount</span>
                    }
                </button>
                <a class="btn-secondary btn-import-link" href="importar" title="Cargar planilla Excel masiva para integrar datos">
                    @((MarkupString)"<svg class=\"ico\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 15V3\"/><path d=\"M7 8l5-5 5 5\"/><path d=\"M5 21h14\"/></svg>") Cargar Excel
                </a>
                <a class="btn-primary" href="carpetas/nueva">@((MarkupString)"<svg class=\"ico\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>") Nueva carpeta</a>
            </div>
        </div>
        }

        @if (mostrarFiltros)
        {
            <div class="collapsible-filters-body">
                <!-- Filtros de operación: Almacenamiento y Tipo de trámite -->
                <div class="tramite-filters">
                    <span class="filter-label">Almacenamiento:</span>
                    <button class="filter-chip @(filtroSinCaja is null && string.IsNullOrEmpty(filtroCaja) ? "active" : "")" @onclick="() => SeleccionarFiltroAlmacenamiento(null)">
                        Todas
                    </button>
                    <button class="filter-chip @(filtroSinCaja == true ? "active" : "")" @onclick="() => SeleccionarFiltroAlmacenamiento(true)">
                        Por guardar / sin caja
                    </button>
                    <button class="filter-chip @(filtroSinCaja == false ? "active" : "")" @onclick="() => SeleccionarFiltroAlmacenamiento(false)">
                        Archivadas en caja
                    </button>

                    <span class="filter-label" style="margin-left: 1rem;">Trámite:</span>
                    <button class="filter-chip @(string.IsNullOrEmpty(filtroTramite) ? "active" : "")" @onclick="() => SeleccionarTramite(null)">Todos</button>
                    <button class="filter-chip @(filtroTramite == TramitePrimera ? "active" : "")" @onclick="() => SeleccionarTramite(TramitePrimera)">1° Licencia</button>
                    <button class="filter-chip @(filtroTramite == TramiteConaset ? "active" : "")" @onclick="() => SeleccionarTramite(TramiteConaset)">Subida CONASET</button>
                    <button class="filter-chip @(filtroTramite == TramiteDomicilio ? "active" : "")" @onclick="() => SeleccionarTramite(TramiteDomicilio)">Cambio Domicilio</button>
                    <button class="filter-chip @(filtroTramite == TramiteF8 ? "active" : "")" @onclick="() => SeleccionarTramite(TramiteF8)">Subida con F8</button>

                    @if (cajasDisponibles.Count > 0)
                    {
                        <div class="caja-filter-dropdown">
                            <select @bind="filtroCaja" @bind:after="BuscarAsync" class="select-caja">
                                <option value="">Filtrar por caja específica...</option>
                                @foreach (var c in cajasDisponibles)
                                {
                                    <option value="@c.Caja">@c.Caja (@c.TotalCarpetas carpetas)</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <!-- Barra de búsqueda principal por RUT o Nombre legible -->
                <div class="search-bar-row">
                    <div class="search-input-wrapper">
                        <span class="search-icon">@((MarkupString)"<svg class=\"ico\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-3.5-3.5\"/></svg>")</span>
                        <input @bind="texto" @bind:event="oninput" @onkeyup="OnSearchKeyUp" placeholder="Escriba RUT, nombre o apellido para encontrar la carpeta..." aria-label="Buscar" />
                        @if (!string.IsNullOrEmpty(texto))
                        {
                            <button class="btn-clear" @onclick="LimpiarBusqueda" title="Borrar búsqueda">✕</button>
                        }
                    </div>

                    <div class="state-select-wrapper">
                        <select @bind="filtroEstado" @bind:after="BuscarAsync">
                            <option value="">TODOS LOS ESTADOS</option>
                            @foreach (var e in Labels.OpcionesDesplegable)
                            {
                                <option value="@e">@Labels.Of(e)</option>
                            }
                        </select>
                    </div>

                    <div class="fecha-filter-wrapper" title="Rango de fecha de citación">
                        <label>Citación desde <input type="date" @bind="filtroDesde" @bind:after="BuscarAsync" /></label>
                        <label>hasta <input type="date" @bind="filtroHasta" @bind:after="BuscarAsync" /></label>
                    </div>
                </div>

                <!-- Acordeón para Agregar Caso Rápido a la agenda -->
                <div class="quick-add-accordion card">
                    <div class="quick-add-summary" @onclick="() => mostrarAcordeonNuevo = !mostrarAcordeonNuevo" role="button" tabindex="0">
                        <span>Agregar nueva carpeta a la agenda</span>
                        <span class="quick-add-hint">@(mostrarAcordeonNuevo ? "Ocultar formulario" : "Registro rápido sin salir de la lista")</span>
                    </div>
                    @if (mostrarAcordeonNuevo)
                    {
                        <div class="quick-add-body">
                            <div class="quick-add-grid">
                                <div class="quick-add-field">
                                    <label>RUT *</label>
                                    <input @bind="nuevoRut" oninput="formatRutInput(this)" placeholder="12.345.678-9" />
                                </div>
                                <div class="quick-add-field">
                                    <label>Nombres *</label>
                                    <input @bind="nuevoNombre" placeholder="Ej: Juan Andrés" />
                                </div>
                                <div class="quick-add-field">
                                    <label>Apellidos *</label>
                                    <input @bind="nuevoApellido" placeholder="Ej: Pérez González" />
                                </div>
                                <div class="quick-add-field">
                                    <label>Sede</label>
                                    <select @bind="nuevaSede">
                                        <option value="@Sede.AvArgentina">Av. Argentina</option>
                                        <option value="@Sede.Placilla">Placilla</option>
                                        <option value="@Sede.MercadoPuerto">Mercado Puerto</option>
                                    </select>
                                </div>
                                <div class="quick-add-field">
                                    <label>Fecha Citación</label>
                                    <input type="date" @bind="nuevaFechaCitacion" />
                                </div>
                                <div class="quick-add-field quick-add-clases">
                                    <label>Clase de licencia</label>
                                    <ClasesSelector @bind-Value="nuevasClases" Disabled="guardandoNuevo" />
                                </div>
                                <div class="quick-add-field" style="justify-content: flex-end;">
                                    <button class="btn-primary" @onclick="() => RegistrarCarpetaRapidaAsync()" disabled="@(string.IsNullOrWhiteSpace(nuevoRut) || string.IsNullOrWhiteSpace(nuevoNombre) || string.IsNullOrWhiteSpace(nuevoApellido) || guardandoNuevo)">
                                        @(guardandoNuevo ? "Guardando..." : "💾 Registrar Carpeta")
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(errorNuevo))
                            {
                                <div class="alert error" role="alert" style="margin-top: 0.5rem; font-size: 0.85rem;">@errorNuevo</div>
                            }
                            <AvisoDuplicado Verificacion="duplicadoNuevo" Ocupado="guardandoNuevo" OnConfirmar="() => RegistrarCarpetaRapidaAsync(confirmarDuplicado: true)" OnCancelar="() => duplicadoNuevo = null" />
                        </div>
                    }
                </div>
            </div>
        }
        else if (FiltrosActivosCount > 0)
        {
            <!-- Resumen compacto de filtros activos cuando el panel está plegado -->
            <div class="active-filters-summary">
                <span class="summary-label">Filtros aplicados:</span>
                @if (!string.IsNullOrWhiteSpace(texto))
                {
                    <span class="active-filter-chip">Búsqueda: "@texto" <button type="button" @onclick="LimpiarBusqueda">✕</button></span>
                }
                @if (filtroEstado is not null)
                {
                    <span class="active-filter-chip">Estado: @Labels.Of(filtroEstado.Value) <button type="button" @onclick="() => { filtroEstado = null; BuscarAsync(); }">✕</button></span>
                }
                @if (!string.IsNullOrWhiteSpace(filtroTramite))
                {
                    <span class="active-filter-chip">Trámite: @filtroTramite <button type="button" @onclick="() => SeleccionarTramite(null)">✕</button></span>
                }
                @if (filtroSinCaja is true)
                {
                    <span class="active-filter-chip">Por Guardar / Sin Caja <button type="button" @onclick="() => SeleccionarFiltroAlmacenamiento(null)">✕</button></span>
                }
                @if (filtroSinCaja is false)
                {
                    <span class="active-filter-chip">Archivadas en Caja <button type="button" @onclick="() => SeleccionarFiltroAlmacenamiento(null)">✕</button></span>
                }
                @if (!string.IsNullOrWhiteSpace(filtroCaja))
                {
                    <span class="active-filter-chip">Caja: @filtroCaja <button type="button" @onclick="() => { filtroCaja = null; BuscarAsync(); }">✕</button></span>
                }
                @if (filtroDesde is not null || filtroHasta is not null)
                {
                    <span class="active-filter-chip">Citación: @(filtroDesde?.ToString("dd-MM-yyyy") ?? "…") → @(filtroHasta?.ToString("dd-MM-yyyy") ?? "…") <button type="button" @onclick="() => { filtroDesde = null; filtroHasta = null; BuscarAsync(); }">✕</button></span>
                }
                <button type="button" class="btn-clear-all-compact" @onclick="ResetFiltros">Limpiar todos</button>
            </div>
        }

        @if (errorEdicion is not null)
        {
            <div class="alert error" role="alert">@errorEdicion <button class="btn-close-alert" type="button" aria-label="Cerrar mensaje" @onclick="() => errorEdicion = null">✕</button></div>
        }
        <!-- Navegación entre módulos: menú lateral (ModulosSidebar). Aquí solo la barra de meta en Por clasificar. -->
        @if (bandejaActiva == Bandeja.PorClasificar && Modulos.Panel is { } panelMeta)
        {
            <MetaDiaBar Meta="panelMeta.Meta" Delgada="true" />
        }
    </div>

    <!-- Grilla de resultados con máxima legibilidad -->
    @if (total is null)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Cargando carpetas operativas…</p>
        </div>
    }
    else if (total == 0)
    {
        <div class="empty-state">
            <span class="lico-slot lico-empty" data-lico="explica" aria-hidden="true"></span>
            @if (bandejaActiva == Bandeja.PorClasificar)
            {
                <p>No hay carpetas por clasificar. Aquí llegan las personas de la agenda diaria.</p>
                <a class="btn-primary" href="importar">Cargar agenda del día</a>
            }
            else
            {
                <p>No hay carpetas en esta bandeja con los filtros actuales.</p>
                <button class="btn-secondary" @onclick="ResetFiltros">Restablecer filtros</button>
            }
        </div>
    }
    else
    {
        @if (bandejaActiva is null)
        {
        <div class="table-container @(!mostrarPanelSuperior ? "panel-colapsado" : (mostrarFiltros ? "standard-table" : "expanded-table"))">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="th-check col-sticky-check">
                            <input type="checkbox" checked="@TodosSeleccionados" disabled="@seleccionandoTodas" @onchange="ToggleSelectAll" title="Seleccionar todas las carpetas que coinciden con los filtros" />
                        </th>
                        <th class="col-sticky-rut">RUT</th>
                        <th class="col-sticky-nombre th-wrap">NOMBRE DE CONTRIBUYENTE</th>
                        <th>SEDE</th>
                        <th>FECHA CITACIÓN</th>
                        <th>FECHA SUBIDA</th>
                        <th>ÚLTIMA CARPETA</th>
                        <th class="sector-header">SECTOR</th>
                        <th class="th-pend">PENDIENTE BÚSQUEDA</th>
                        <th>ESTADO DE LA CARPETA</th>
                        <th>COMUNAS</th>
                        <th>DECISIÓN</th>
                        <th>ACCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize @ref="virtualizador" TItem="CarpetaResumenDto" Context="c" ItemsProvider="CargarFilasAsync"
                                ItemSize="FilaAlturaEstimada" OverscanCount="20" SpacerElement="tr">
                        <ItemContent>
                        @{
                        var isSelected = seleccionadas.Contains(c.Id);
                        var estadoClass = Labels.EstadoRowCss(c.Estado);
                        var isSaving = guardandoId == c.Id;
                        var isSaved = guardadoOkId == c.Id;
                        <tr class="@estadoClass @(isSelected ? "row-selected" : "") @(isSaving ? "fila-guardando" : "") @(isSaved ? "fila-guardada-ok" : "") @(drawerCarpetaId == c.Id ? "row-drawer-active" : "")"
                            @ondblclick="() => AbrirDrawerAsync(c.Id)">
                            <td class="td-check col-sticky-check" @ondblclick:stopPropagation>
                                <input type="checkbox" checked="@isSelected" @onchange="() => ToggleSelect(c)" />
                            </td>
                            <td class="col-sticky-rut" @ondblclick:stopPropagation>
                                <div class="rut-wrapper-cell">
                                    <input class="excel-rut-input rut-input"
                                           value="@c.Rut"
                                           @onchange="(e) => CambiarRutRapidoAsync(c.Id, e)"
                                           oninput="formatRutInput(this)"
                                           title="Modificar RUT directamente (Enter para guardar)" />
                                </div>
                            </td>
                            <td class="col-sticky-nombre" @ondblclick:stopPropagation>
                                @{
                                    var puedeMarcar = Carpeta.PermiteBusquedaPendiente(c.Estado);
                                    var parpadea = c.PendienteBusqueda && puedeMarcar;
                                    var tituloPend = !puedeMarcar
                                        ? "Solo disponible cuando la carpeta está en Archivos u Of. 43"
                                        : (c.PendienteBusqueda ? "Quitar marca de pendiente de búsqueda" : "Marcar como pendiente de búsqueda");
                                }
                                <div class="nombre-wrapper-cell">
                                    <span class="name-cell @(parpadea ? "nombre-pend-parpadeo" : "")" title="@c.NombreCompleto">@c.NombreCompleto</span>
                                    <button class="btn-obs-trigger @(!string.IsNullOrEmpty(c.IdoneidadMoral) ? "has-obs" : "")"
                                            title="@(!string.IsNullOrEmpty(c.IdoneidadMoral) ? $"Observación: {c.IdoneidadMoral}" : "Agregar observación a la carpeta")"
                                            @onclick="() => AbrirModalObs(c)"
                                            type="button">
                                        <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                                        @if (!string.IsNullOrEmpty(c.IdoneidadMoral))
                                        {
                                            <span class="obs-badge-indicator" title="Tiene observación registrada"></span>
                                        }
                                    </button>
                                </div>
                            </td>
                            <td><span class="sede-tag">@Labels.Of(c.Sede)</span></td>
                            <td class="date-cell">@c.FechaCitacion.ToString("dd-MM-yyyy")</td>
                            <td class="date-cell">@(c.FechaSubida?.ToString("dd-MM-yyyy") ?? "—")</td>
                            <td class="excel-cell-date" @ondblclick:stopPropagation>
                                @if (!string.IsNullOrWhiteSpace(c.FechaUltimaCarpeta) && !EsFechaIso(c.FechaUltimaCarpeta))
                                {
                                    <span class="legacy-ultima" title="Valor antiguo no válido como fecha (dato heredado del Excel)">@c.FechaUltimaCarpeta</span>
                                }
                                <input type="date"
                                       @key="@($"fu-{c.Id}-{revEdicion}")"
                                       class="date-input-inline"
                                       value="@(EsFechaIso(c.FechaUltimaCarpeta) ? c.FechaUltimaCarpeta : null)"
                                       @onchange="(e) => CambiarFechaUltimaRapidaAsync(c.Id, e)"
                                       title="Fecha de la última carpeta" />
                            </td>
                            <td class="excel-cell-sector">
                                @{
                                    var sector = CalcularSector(c.FechaUltimaCarpeta);
                                }
                                <span class="sector-cell @(sector == "ARCHIVO" ? "sector-archivo" : sector == "OFICINA 43" ? "sector-oficina43" : "sector-vacio")">
                                    @sector
                                </span>
                            </td>
                            <td class="td-pend" @ondblclick:stopPropagation>
                                <button type="button"
                                        class="btn-pend-busqueda @(c.PendienteBusqueda ? "activo" : "") @(parpadea ? "parpadeo" : "")"
                                        aria-pressed="@(c.PendienteBusqueda ? "true" : "false")"
                                        aria-label="Pendiente búsqueda"
                                        title="@tituloPend"
                                        disabled="@(!puedeMarcar)"
                                        @onclick="() => TogglePendienteBusquedaAsync(c)">
                                    <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                                </button>
                            </td>
                            <td class="excel-cell" @ondblclick:stopPropagation>
                                <select class="excel-select"
                                        @key="@($"es-{c.Id}-{revEdicion}")"
                                        value="@c.Estado"
                                        @onchange="(e) => CambiarEstadoRapidoAsync(c.Id, e)"
                                        title="Cambiar estado de carpeta directamente (como en Excel)">
                                    @if (!Labels.OpcionesDesplegable.Contains(c.Estado))
                                    {
                                        <option value="@c.Estado" disabled>@Labels.Of(c.Estado)</option>
                                    }
                                    @foreach (var e in Labels.OpcionesDesplegable)
                                    {
                                        <option value="@e">@Labels.Of(e)</option>
                                    }
                                </select>
                            </td>
                            <td class="excel-cell-comuna" @ondblclick:stopPropagation>
                                @if (Carpeta.EsCambioDomicilio(c.Estado))
                                {
                                    <input type="text"
                                           @key="@($"co-{c.Id}-{revEdicion}")"
                                           class="comuna-input-inline"
                                           list="lista-comunas-chile"
                                           autocomplete="off"
                                           value="@c.Comuna"
                                           @onchange="(e) => CambiarComunaRapidaAsync(c.Id, e)"
                                           placeholder="—"
                                           title="Comuna de origen: escribe o elige de la lista" />
                                }
                                else
                                {
                                    <input type="text"
                                           class="comuna-input-inline comuna-input-disabled"
                                           value="@(string.IsNullOrEmpty(c.Comuna) ? "—" : c.Comuna)"
                                           disabled
                                           title="Solo editable cuando la carpeta está en cambio de domicilio" />
                                }
                            </td>
                            <td class="excel-cell" @ondblclick:stopPropagation>
                                <select class="excel-select"
                                        @key="@($"de-{c.Id}-{revEdicion}")"
                                        value="@c.Decision"
                                        @onchange="(e) => CambiarDecisionRapidaAsync(c.Id, e)"
                                        title="Cambiar decisión directamente">
                                    @foreach (var d in Enum.GetValues<Decision>())
                                    {
                                        <option value="@d">@Labels.Of(d)</option>
                                    }
                                </select>
                            </td>
                            <td class="action-cell" @ondblclick:stopPropagation>
                                @if (string.IsNullOrEmpty(c.CajaArchivo))
                                {
                                    <button class="btn-action-caja"
                                            title="Enviar directamente a la cola de Caja"
                                            @onclick="() => EnviarACajaDirectoAsync(c)">
                                        <svg class="ico-caja" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="5" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
                                        <span>Caja</span>
                                    </button>
                                }
                                else if (c.CajaArchivo == "Cola de Caja")
                                {
                                    <span class="badge warn" title="En cola para la próxima caja">
                                        En cola
                                    </span>
                                }
                                else
                                {
                                    <a class="btn-action-caja-ok"
                                       href="cajas?caja=@Uri.EscapeDataString(c.CajaArchivo)"
                                       title="Almacenada en @c.CajaArchivo. Clic para ver acta e imprimir">
                                        @c.CajaArchivo
                                    </a>
                                }
                                <button class="btn-detail"
                                        @onclick="() => AbrirDrawerAsync(c.Id)"
                                        title="Abrir panel lateral de detalle e historial">
                                    Abrir →
                                </button>
                            </td>
                        </tr>
                        }
                        </ItemContent>
                        <Placeholder>
                            <tr class="fila-placeholder"><td colspan="13">&nbsp;</td></tr>
                        </Placeholder>
                    </Virtualize>
                </tbody>
            </table>
        </div>
        }
        else
        {
        @if (bandejaActiva == Bandeja.PorClasificar && seleccionadas.Count > 0)
        {
            <div class="clasif-lote-bar" role="region" aria-label="Clasificación en lote">
                <span>@seleccionadas.Count seleccionadas</span>
                <select class="excel-select" @bind="destinoLote" title="Estado a aplicar a las carpetas seleccionadas">
                    <option value="">— Clasificar como… —</option>
                    <option value="@LoteBuscar">Buscar carpeta física (según la fecha ya guardada)</option>
                    @foreach (var e in Labels.OpcionesClasificacion)
                    {
                        <option value="@e">@Labels.Of(e)</option>
                    }
                </select>
                <span class="clasif-lote-clase" title="Clase de licencia (obligatoria)">Clase *</span>
                <ClasesSelector @bind-Value="clasesLote" Disabled="clasificando" AriaLabel="Clase de licencia para las seleccionadas (obligatoria)" />
                <button type="button" class="btn-primary" disabled="@(seleccionadas.Count == 0 || clasificando)"
                        title="Aplicar la clasificación a las carpetas marcadas"
                        @onclick="ClasificarLoteAsync">Aplicar a @seleccionadas.Count</button>
                @if (!string.IsNullOrEmpty(errorClasif))
                {
                    <span class="clasif-error" role="alert">@errorClasif</span>
                }
            </div>
        }
        @if (bandejaActiva is Bandeja.SeEncuentraEnArchivos or Bandeja.SeEncuentraEnOf43)
        {
            <div class="busqueda-bar" role="region" aria-label="Listado para búsqueda">
                <span class="busqueda-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                </span>
                <span class="busqueda-texto">
                    <strong>@total carpeta(s) por buscar</strong>
                    <small>Imprima el listado, camine los estantes y marque «encontrada» o «no existe».</small>
                </span>
                <button type="button" class="btn-primary" disabled="@(total is null or 0 || cargandoListado)" @onclick="() => AbrirListadoBusquedaAsync(bandejaActiva!.Value, null)">
                    @(cargandoListado ? "Preparando…" : "Generar listado para búsqueda")
                </button>
                @if (seleccionadas.Count > 0)
                {
                    <button type="button" class="btn-secondary" disabled="@cargandoListado" @onclick="() => AbrirListadoBusquedaAsync(bandejaActiva!.Value, seleccionadas.ToList())">
                        Solo las @seleccionadas.Count marcadas
                    </button>
                }
                @if (!string.IsNullOrEmpty(errorListado))
                {
                    <span class="clasif-error" role="alert">@errorListado</span>
                }
            </div>
        }
        @if (ofertaListado.Count > 0)
        {
            <div class="oferta-listado" role="status">
                <span class="oferta-texto">
                    @foreach (var o in ofertaListado)
                    {
                        <span>@o.Cantidad carpeta(s) pasaron a <strong>@Labels.Of(o.Destino)</strong>. </span>
                    }
                    ¿Generar el listado para búsqueda de lo recién clasificado?
                </span>
                @foreach (var o in ofertaListado)
                {
                    <button type="button" class="btn-primary" disabled="@cargandoListado" @onclick="() => AbrirListadoBusquedaAsync(o.Bandeja, o.Ids)">
                        Listado de @(o.Bandeja == Bandeja.SeEncuentraEnArchivos ? "Archivos" : "Of. 43")
                    </button>
                }
                <button type="button" class="btn-clear" aria-label="Descartar oferta" @onclick="() => ofertaListado.Clear()">✕</button>
            </div>
        }
        <div class="table-container @(!mostrarPanelSuperior ? "panel-colapsado" : (mostrarFiltros ? "standard-table" : "expanded-table"))">
            <table class="data-table bandeja-table">
                <thead>
                    <tr>
                        <th class="th-check col-sticky-check">
                            <input type="checkbox" checked="@TodosSeleccionados" disabled="@seleccionandoTodas" @onchange="ToggleSelectAll" title="Seleccionar todas las carpetas de esta bandeja" />
                        </th>
                        @foreach (var col in ColumnasBandeja)
                        {
                            <th class="@(col == "NOMBRE DE CONTRIBUYENTE" ? "th-wrap col-sticky-nombre" : col == "RUT" ? "col-sticky-rut" : null)">@col</th>
                        }
                        @if (bandejaActiva != Bandeja.PorClasificar)
                        {
                            <th>ACCIÓN</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (filasDirectas is { } directas)
                    {
                        @* Small trays (the daily agenda): rendered at once, no Virtualize warm-up. *@
                        @foreach (var c in directas)
                        {
                            @FilaBandeja(c)
                        }
                    }
                    else
                    {
                    <Virtualize @ref="virtualizador" TItem="CarpetaResumenDto" Context="c" ItemsProvider="CargarFilasAsync"
                                ItemSize="FilaAlturaEstimada" OverscanCount="20" SpacerElement="tr">
                        <ItemContent>@FilaBandeja(c)</ItemContent>
                        <Placeholder>
                            <tr class="fila-placeholder"><td colspan="@(ColumnasBandeja.Count + 2)">&nbsp;</td></tr>
                        </Placeholder>
                    </Virtualize>
                    }
                </tbody>
            </table>
        </div>
        }





    }
</div>

<!-- Modal para Agregar/Modificar Observaciones Rápidas -->
@if (mostrarModalObs && carpetaParaObs is not null)
{
    <div class="modal-overlay" @onclick="CerrarModalObs">
        <div class="modal-card modal-obs-card" @onclick:stopPropagation>
            <div class="modal-obs-header">
                <span class="modal-obs-icon">📝</span>
                <div>
                    <h3 style="margin: 0; font-size: 1.15rem; color: #0f172a; font-weight: 700;">Observación de Carpeta</h3>
                    <p style="margin: 0.25rem 0 0; font-size: 0.85rem; color: #475569;">
                        <strong>@carpetaParaObs.NombreCompleto</strong> &bull; RUT: @carpetaParaObs.Rut &bull; Sede: @Labels.Of(carpetaParaObs.Sede)
                    </p>
                </div>
            </div>

            <div class="modal-form" style="margin-top: 1rem;">
                <label style="font-weight: 600; font-size: 0.88rem; color: #334155; display: block; margin-bottom: 0.5rem;">
                    Observación / Idoneidad moral / Detalle operativo:
                    <textarea @bind="textoObs"
                              @bind:event="oninput"
                              rows="4"
                              maxlength="200"
                              class="obs-textarea-input"
                              placeholder="Escriba aquí la observación de la carpeta (ej: Pendiente certificado, no tiene antecedentes, etc.)..."
                              autofocus></textarea>
                </label>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.25rem;">
                    <span style="font-size: 0.8rem; color: @(textoObs.Length >= 190 ? "#dc2626" : "#64748b"); font-weight: 600;">
                        @textoObs.Length / 200 caracteres
                    </span>
                    @if (!string.IsNullOrEmpty(errorObs))
                    {
                        <span style="font-size: 0.82rem; color: #dc2626; font-weight: 600;">@errorObs</span>
                    }
                </div>

                <div class="modal-actions" style="margin-top: 1.25rem;">
                    <button class="btn-primary" @onclick="GuardarObservacionModalAsync" disabled="@guardandoObs">
                        @(guardandoObs ? "Guardando..." : "💾 Guardar Observación")
                    </button>
                    <button class="btn-secondary" @onclick="CerrarModalObs" disabled="@guardandoObs">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal para mecanismo de almacenamiento en Caja física -->
@if (mostrarModalCaja)
{
    <div class="modal-overlay" @onclick="CerrarModalCaja">
        <div class="modal-card" @onclick:stopPropagation>
            <h3>📦 Almacenamiento en Caja Física</h3>
            @if (esModoLote)
            {
                <p>Se guardarán <strong>@seleccionadas.Count carpetas</strong> en la caja indicada para su posterior archivo.</p>
            }
            else if (carpetaParaCaja is not null)
            {
                <p>Carpeta: <strong>@carpetaParaCaja.NombreCompleto</strong> (@carpetaParaCaja.Rut)</p>
            }

            <div class="modal-form">
                <label>Código / Identificador de la Caja o Estante:
                    <input @bind="nuevaCajaTexto" maxlength="@Carpeta.MaxCajaLength" placeholder="Ej: CAJA AA-01, CAJA PL-02, ARCHIVO GENERAL, OF. 43" autofocus />
                </label>

                @if (cajasDisponibles.Count > 0)
                {
                    <div class="cajas-sugeridas">
                        <span class="sugeridas-label">Cajas activas existentes:</span>
                        @foreach (var c in cajasDisponibles.Take(6))
                        {
                            <button type="button" class="btn-sug" @onclick="() => nuevaCajaTexto = c.Caja">
                                @c.Caja (@c.TotalCarpetas)
                            </button>
                        }
                    </div>
                }

                <div class="modal-actions">
                    <button class="btn-primary" @onclick="GuardarCajaAsync" disabled="@string.IsNullOrWhiteSpace(nuevaCajaTexto)">
                        Confirmar almacenamiento
                    </button>
                    <button class="btn-secondary" @onclick="CerrarModalCaja">
                        Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de Vista Previa e Impresión Oficial de Documento PDF (Sector Archivo / Oficina 43) -->
@if (mostrarModalPdf)
{
    <div class="pdf-modal-overlay">
        <div class="pdf-modal-container">
            <div class="pdf-modal-toolbar no-print">
                <div class="pdf-toolbar-actions">
                    <button type="button" class="btn-primary btn-print-pdf" @onclick="ImprimirPdf">
                        🖨️ Imprimir / Guardar como PDF
                    </button>
                    <button type="button" class="btn-outline-danger" @onclick="VaciarListadoSectorPdf">
                        Vaciar listado
                    </button>
                    <div class="page-size-selector-pdf">
                        <label for="pdf-page-size-select">TAMAÑO DE HOJA</label>
                        <select id="pdf-page-size-select" value="@pdfPageSize" @onchange="OnPdfPageSizeChangedAsync">
                            <option value="A4">A4</option>
                            <option value="letter">Carta</option>
                            <option value="legal">Oficio</option>
                        </select>
                    </div>
                </div>
                <div class="pdf-toolbar-hint">
                    Este listado muestra solo los nombres marcados (checkbox "Marcar") en la pantalla de Casos.
                </div>
                <button type="button" class="btn-close-pdf-modal" @onclick="CerrarModalPdf" title="Volver a la tabla">
                    ✕ Cerrar
                </button>
            </div>

            <div class="pdf-modal-scroll">
                <div class="doc-sheet">
                    <div class="doc-header">
                        <div class="doc-title-block">
                            <img src="images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="doc-seal" />
                            <div>
                                <p class="doc-org">MUNICIPALIDAD DE VALPARAÍSO — DIRECCIÓN DE TRÁNSITO</p>
                                <h2>@TituloModuloPdf — Listado de carpetas — Sector @(EsSectorArchivo ? "Archivo" : "Oficina 43")</h2>
                            </div>
                        </div>
                        <div class="doc-meta">
                            <div>Folio: <strong>@(EsSectorArchivo ? "Archivo" : "Oficina43")-@HoraChile.ALocal(DateTime.UtcNow).ToString("yyyyMMdd-HHmm")</strong></div>
                            <div>Generado: <strong>@HoraChile.ALocal(DateTime.UtcNow).ToString("dd-MM-yyyy HH:mm")</strong></div>
                        </div>
                    </div>

                    <div class="doc-subheader">
                        <span>@SubtituloPdf</span>
                        <span>@carpetasParaPdf.Count registro(s)</span>
                    </div>

                    <div class="doc-table-card">
                        @if (carpetasParaPdf.Count == 0)
                        {
                            <p class="doc-empty">
                                No hay carpetas seleccionadas en este sector todavía. Marque las casillas de las
                                carpetas correspondientes en la tabla (con su "Fecha última carpeta"
                                ya ingresada) para que aparezcan aquí.
                            </p>
                        }
                        else
                        {
                            <table class="cases doc-table">
                                <thead>
                                    <tr>
                                        <th style="width: 38px;">N°</th>
                                        <th style="text-align: left;">NOMBRE DE CONTRIBUYENTE</th>
                                        <th>RUT</th>
                                        <th>COMUNA</th>
                                        <th>FECHA ÚLTIMA CARPETA</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var correlativo = 0; }
                                    @foreach (var item in carpetasParaPdf)
                                    {
                                        correlativo++;
                                        <tr>
                                            <td style="text-align: center;">@correlativo</td>
                                            <td style="text-align: left; font-weight: 700;">@item.NombreCompleto.ToUpperInvariant()</td>
                                            <td style="text-align: center; font-weight: 600;">@item.Rut</td>
                                            <td style="text-align: center; text-transform: uppercase;">@(string.IsNullOrWhiteSpace(item.Comuna) ? "—" : item.Comuna.ToUpperInvariant())</td>
                                            <td style="text-align: center; font-weight: 600;">@FormatearFechaFormal(item.FechaUltimaCarpeta)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>

                    @if (carpetasParaPdf.Count > 0)
                    {
                        <p class="doc-count">Total: @carpetasParaPdf.Count carpeta(s)</p>

                        <div class="doc-signoff">
                            <div>
                                <div class="sig-line"></div>
                                Quien solicita
                            </div>
                        </div>
                    }

                    <div class="doc-footer-bottom">
                        <span>Cambio de Domicilio · Municipalidad de Valparaíso</span>
                        <span>Modelo y sistema creados por <strong>Raúl Salazar</strong> · 2026</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<UndoToast Aviso="toast" OnDeshacer="DeshacerToastAsync" OnCerrar="CerrarToast" />

@if (listadoBusqueda is not null)
{
    <ListadoBusquedaDocumento Listado="listadoBusqueda" OnCerrar="CerrarListadoBusqueda" OnMarcarImpreso="MarcarListadoImpresoAsync" />
}

<!-- Backdrop y Side Drawer (Master-Detail interactivo) -->
<div class="drawer-backdrop @(drawerAbierto ? "open" : "")" @onclick="CerrarDrawer"></div>

<aside class="case-drawer @(drawerAbierto ? "open" : "")" aria-hidden="@(!drawerAbierto)">
    @if (drawerCargando)
    {
        <div class="drawer-loading">
            <div class="spinner"></div>
            <p>Cargando detalle de la carpeta…</p>
        </div>
    }
    else if (drawerDetalle is not null)
    {
        <div class="drawer-header">
            <div>
                <h2 class="drawer-title-name">@drawerDetalle.Nombre @drawerDetalle.Apellido</h2>
                <div class="drawer-title-meta">
                    <span><strong>RUT:</strong> @drawerDetalle.Rut</span>
                    <span class="sede-tag">@Labels.Of(drawerDetalle.Sede)</span>
                    @if (!string.IsNullOrEmpty(drawerDetalle.CajaArchivo))
                    {
                        <span class="badge info">📦 @drawerDetalle.CajaArchivo</span>
                    }
                </div>
            </div>
            <button class="drawer-close-btn" type="button" @onclick="CerrarDrawer" title="Cerrar panel" aria-label="Cerrar panel">✕</button>
        </div>

        <div class="drawer-body">
            @if (!string.IsNullOrEmpty(errorDrawer))
            {
                <div class="alert error" role="alert">@errorDrawer</div>
            }

            <!-- Sección 1: Estado y Decisión rápidos -->
            <div class="drawer-section">
                <h3 class="drawer-section-title">⚡ Estado y Decisión Operativa</h3>
                <div class="drawer-grid-2">
                    <div class="drawer-field">
                        <label>ESTADO DE LA CARPETA</label>
                        <select class="excel-select" value="@drawerDetalle.Estado" @onchange="OnDrawerEstadoChangedAsync">
                            @if (!Labels.OpcionesDesplegable.Contains(drawerDetalle.Estado))
                            {
                                <option value="@drawerDetalle.Estado" disabled>@Labels.Of(drawerDetalle.Estado)</option>
                            }
                            @foreach (var e in Labels.OpcionesDesplegable)
                            {
                                <option value="@e">@Labels.Of(e)</option>
                            }
                        </select>
                    </div>
                    <div class="drawer-field">
                        <label>Decisión</label>
                        <select class="excel-select" value="@drawerDetalle.Decision" @onchange="OnDrawerDecisionChangedAsync">
                            @foreach (var d in Enum.GetValues<Decision>())
                            {
                                <option value="@d">@Labels.Of(d)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Sección 2: Fechas, Sede y Caja -->
            <div class="drawer-section">
                <h3 class="drawer-section-title">📅 Parámetros de la Carpeta y Ciudadano</h3>
                <div class="drawer-grid-2">
                    <div class="drawer-field">
                        <label>RUT del Ciudadano (Modificable)</label>
                        <div style="display: flex; gap: 5px;">
                            <input class="rut-input"
                                   @bind="drawerRut"
                                   oninput="formatRutInput(this)"
                                   placeholder="12.345.678-9" />
                            <button type="button"
                                    class="btn-copy-rut"
                                    title="Copiar RUT para CAS-Chile"
                                    @onclick="() => CopiarRutCasChileAsync(drawerRut)">
                                📋
                            </button>
                        </div>
                    </div>
                    <div class="drawer-field">
                        <label>Sede Operativa</label>
                        <select @bind="drawerSede">
                            <option value="@Sede.AvArgentina">Av. Argentina</option>
                            <option value="@Sede.Placilla">Placilla</option>
                            <option value="@Sede.MercadoPuerto">Mercado Puerto</option>
                        </select>
                    </div>
                    <div class="drawer-field">
                        <label>Fecha Citación</label>
                        <input type="date" @bind="drawerFechaCitacion" />
                    </div>
                    <div class="drawer-field">
                        <label>Fecha Subida</label>
                        <input type="date" @bind="drawerFechaSubida" />
                    </div>
                    <div class="drawer-field">
                        <label>Caja de Archivo</label>
                        <input @bind="drawerCaja" placeholder="Ej: CAJA AA-01" />
                    </div>
                </div>
                <div style="margin-top: 12px; display: flex; justify-content: flex-end;">
                    <button class="btn-primary" @onclick="GuardarDrawerEdicionAsync" disabled="@drawerGuardando">
                        @(drawerGuardando ? "Guardando..." : "💾 Guardar Parámetros")
                    </button>
                </div>
            </div>

            <!-- Sección 3: Historial y Auditoría -->
            <div class="drawer-section">
                <h3 class="drawer-section-title">📋 Historial de Cambios y Trazabilidad (@drawerDetalle.Historial.Count)</h3>
                @if (drawerDetalle.Historial.Count == 0)
                {
                    <p class="text-muted" style="font-size: 0.82rem; margin: 0;">Sin eventos registrados aún.</p>
                }
                else
                {
                    <div class="drawer-audit-list">
                        @foreach (var h in drawerDetalle.Historial)
                        {
                            <div class="drawer-audit-item">
                                <div class="audit-meta">
                                    <strong>@HoraChile.ALocal(h.Fecha).ToString("dd-MM-yyyy HH:mm")</strong> · Por: <em>@h.Usuario</em>
                                </div>
                                <div class="audit-change">
                                    <span class="audit-field">@Labels.Campo(h.Campo):</span>
                                    @if (!string.IsNullOrEmpty(h.Anterior))
                                    {
                                        <span class="audit-old">@h.Anterior</span>
                                        <span>➔</span>
                                    }
                                    <span class="audit-new">@h.Nuevo</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Enlace a detalle completo si se requiere ver más -->
            <div style="text-align: right; margin-top: 6px;">
                <a href="carpetas/@drawerDetalle.Id" class="btn-secondary" style="font-size: 0.84rem; display: inline-block;">
                    🔍 Abrir vista de página completa →
                </a>
            </div>
        </div>
    }
</aside>

@code {
