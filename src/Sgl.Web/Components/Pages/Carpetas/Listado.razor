    private const string PanelSuperiorStorageKey = "sgl.carpetas.panelSuperior";
    private bool mostrarPanelSuperior = false;

    private async Task TogglePanelSuperiorAsync()
    {
        mostrarPanelSuperior = !mostrarPanelSuperior;
        try { await JS.InvokeVoidAsync("localStorage.setItem", PanelSuperiorStorageKey, mostrarPanelSuperior ? "1" : "0"); }
        catch (Exception) { /* almacenamiento no disponible: la preferencia solo dura la sesión */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pedirFilasTrasMontar && virtualizador is not null)
        {
            pedirFilasTrasMontar = false;
            try { await JS.InvokeVoidAsync("sglUi.scrollTablaArriba"); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { }
            await virtualizador.RefreshDataAsync();
        }
        if (!firstRender) return;
        try
        {
            var guardado = await JS.InvokeAsync<string?>("localStorage.getItem", PanelSuperiorStorageKey);
            if (guardado == "1" && !mostrarPanelSuperior)
            {
                mostrarPanelSuperior = true;
                StateHasChanged();
            }
        }
        catch (Exception) { /* sin localStorage: se mantiene colapsado por defecto */ }
    }
    private void ToggleFiltros() => mostrarFiltros = !mostrarFiltros;

