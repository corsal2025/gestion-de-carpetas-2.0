            }
        }
    }

    // Quick-Add agenda rápido
    private bool mostrarAcordeonNuevo;
    private string nuevoRut = "";
    private string nuevoNombre = "";
    private string nuevoApellido = "";
    private Sede nuevaSede = Sede.AvArgentina;
    private DateOnly nuevaFechaCitacion = DateOnly.FromDateTime(DateTime.Today);
    private bool guardandoNuevo;
    private string? errorNuevo;

    private async Task RegistrarCarpetaRapidaAsync()
    {
        if (string.IsNullOrWhiteSpace(nuevoRut) || string.IsNullOrWhiteSpace(nuevoNombre) || string.IsNullOrWhiteSpace(nuevoApellido))
        {
            errorNuevo = "Por favor complete RUT, Nombre y Apellido.";
            return;
        }

        guardandoNuevo = true;
        errorNuevo = null;

        try
        {
            var autor = Autor.HasNombre ? Autor.Nombre! : "Funcionario";
            var id = await Carpetas.RegistrarAsync(new RegistrarCarpetaCommand(
                nuevoRut.Trim(),
                nuevoNombre.Trim(),
                nuevoApellido.Trim(),
                nuevaSede,
                nuevaFechaCitacion,
                autor));

            nuevoRut = "";
            nuevoNombre = "";
            nuevoApellido = "";
            nuevaFechaCitacion = DateOnly.FromDateTime(DateTime.Today);
            mostrarAcordeonNuevo = false;

            guardadoOkId = id;
            await CargarMetricasAsync();
            await CargarAsync();
            await JS.InvokeVoidAsync("showRutToast", "Carpeta agregada con éxito a la agenda.");

            _ = Task.Run(async () =>
            {
                await Task.Delay(2000);
                if (guardadoOkId == id)
                {
                    guardadoOkId = null;
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
        catch (Exception ex)
        {
            errorNuevo = ex.Message;
        }
        finally
        {
            guardandoNuevo = false;
        }
    }

    // Master-Detail Side Drawer
    private bool drawerAbierto;
    private bool drawerCargando;
    private bool drawerGuardando;
    private Guid? drawerCarpetaId;
    private CarpetaDetalleDto? drawerDetalle;
    private string drawerRut = "";
    private Sede drawerSede;
    private DateOnly drawerFechaCitacion;
    private DateOnly? drawerFechaSubida;
    private string drawerCaja = "";
    private string? errorDrawer;

    private async Task AbrirDrawerAsync(Guid id)
    {
        drawerCarpetaId = id;
        drawerAbierto = true;
        drawerCargando = true;
        errorDrawer = null;
        StateHasChanged();

        try
        {
            drawerDetalle = await Carpetas.ObtenerAsync(id);
            drawerRut = drawerDetalle.Rut;
            drawerSede = drawerDetalle.Sede;
            drawerFechaCitacion = drawerDetalle.FechaCitacion;
            drawerFechaSubida = drawerDetalle.FechaSubida;
            drawerCaja = drawerDetalle.CajaArchivo ?? "";
        }
        catch (Exception ex)
        {
            errorDrawer = ex.Message;
        }
        finally
        {
            drawerCargando = false;
            StateHasChanged();
        }
    }

    private void CerrarDrawer()
    {
        drawerAbierto = false;
        drawerCarpetaId = null;
        drawerDetalle = null;
        drawerRut = "";
        errorDrawer = null;
    }

    private async Task GuardarDrawerEdicionAsync()
    {
        if (drawerDetalle is null) return;
        drawerGuardando = true;
        errorDrawer = null;
        try
        {
            var autor = Autor.HasNombre ? Autor.Nombre! : "Funcionario";
            await Carpetas.EditarAsync(new EditarCarpetaCommand(
                drawerDetalle.Id,
                drawerSede,
                drawerFechaCitacion,
                drawerFechaSubida,
                null,
                autor,
                drawerRut));

            if ((drawerCaja ?? "").Trim() != (drawerDetalle.CajaArchivo ?? "").Trim())
            {
                await Carpetas.AsignarCajaAsync(new AsignarCajaCommand(
                    drawerDetalle.Id,
                    string.IsNullOrWhiteSpace(drawerCaja) ? null : drawerCaja.Trim(),
                    autor));
            }

            drawerDetalle = await Carpetas.ObtenerAsync(drawerDetalle.Id);
            drawerRut = drawerDetalle.Rut;
            await CargarMetricasAsync();
            await CargarAsync();
        }
        catch (Exception ex)
        {
            errorDrawer = ex.Message;
        }
        finally
        {
            drawerGuardando = false;
        }
    }

