    /// <summary>Bumped when an inline edit is rejected so the control is re-created showing the persisted value.</summary>
    private int revEdicion;

    private static bool EsFechaIso(string? v) =>
        DateOnly.TryParseExact(v, "yyyy-MM-dd", out _);

    private async Task CambiarEstadoRapidoAsync(Guid id, ChangeEventArgs e)
    {
        if (Enum.TryParse<EstadoCarpeta>(e.Value?.ToString(), out var nuevoEstado))
        {
            guardandoId = id;
            StateHasChanged();

            try
            {
                if (AutorRequerido() is not { } autor) { revEdicion++; return; }
                var punto = await Carpetas.ForzarEstadoAsync(id, nuevoEstado, autor);
                guardadoOkId = id;
                await AnunciarCambioDeEstadoAsync(id, nuevoEstado, punto);
                await CargarMetricasAsync();
                await CargarAsync();

                _ = Task.Run(async () =>
                {
                    await Task.Delay(1800);
                    if (guardadoOkId == id)
                    {
                        guardadoOkId = null;
                        await InvokeAsync(StateHasChanged);
                    }
                });
            }
            catch (Exception ex)
            {
                MostrarErrorEdicion(ex, "Error al cambiar estado rápido");
                revEdicion++;
