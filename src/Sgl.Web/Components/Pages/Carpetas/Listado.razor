                                    }
                                    <span class="audit-new">@h.Nuevo</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Enlace a detalle completo si se requiere ver más -->
            <div style="text-align: right; margin-top: 6px;">
                <a href="carpetas/@drawerDetalle.Id" class="btn-secondary" style="font-size: 0.84rem; display: inline-block;">
                    🔍 Abrir vista de página completa →
                </a>
            </div>
        </div>
    }
</aside>

@code {
    private const string TramitePrimera = "1° LICENCIA";
    private const string TramiteConaset = "SUBIDA A CONASET";
    private const string TramiteDomicilio = "CAMBIO DOM. SUBIDO A CONASET";
    private const string TramiteF8 = "SUBIDA CON F8";

    private PagedResult<CarpetaResumenDto>? resultado;
    private EstadisticasGlobalesDto? stats;
    private IReadOnlyList<CajaResumenDto> cajasDisponibles = [];
    private Sede? filtroSede;
    private string? filtroTramite;
    private string? filtroCaja;
    private bool? filtroSinCaja;
    private EstadoCarpeta? filtroEstado;
    private string? texto;
    private int page = 1;
    private int pageSize = 25;
    private int saltoPagina = 1;

    // Selección múltiple para almacenamiento y PDF por Sector
    private readonly HashSet<Guid> seleccionadas = [];
    private readonly Dictionary<Guid, CarpetaResumenDto> itemsSeleccionadosMap = new();

    private bool TodosSeleccionados =>
        resultado is not null && resultado.Items.Count > 0 && resultado.Items.All(i => seleccionadas.Contains(i.Id));

    private int conteoArchivoSeleccionadas =>
        itemsSeleccionadosMap.Values.Count(c => CalcularSector(c.FechaUltimaCarpeta) == "ARCHIVO");

    private int conteoOficina43Seleccionadas =>
        itemsSeleccionadosMap.Values.Count(c => CalcularSector(c.FechaUltimaCarpeta) == "OFICINA 43");

    // Modal de caja
    private bool mostrarModalCaja;
    private bool esModoLote;
    private CarpetaResumenDto? carpetaParaCaja;
    private string nuevaCajaTexto = "";

    // Panel de filtros replegable
    private bool mostrarFiltros = false;
    private bool mostrarPanelSuperior = true;
    private void ToggleFiltros() => mostrarFiltros = !mostrarFiltros;

    private int FiltrosActivosCount
    {
        get
        {
            var count = 0;
            if (!string.IsNullOrWhiteSpace(texto)) count++;
            if (filtroEstado is not null) count++;
            if (filtroSinCaja is not null || !string.IsNullOrWhiteSpace(filtroCaja)) count++;
            if (!string.IsNullOrWhiteSpace(filtroTramite)) count++;
            return count;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarMetricasAsync();
        await CargarAsync();
    }

    private async Task CargarMetricasAsync()
    {
        stats = await Carpetas.ObtenerEstadisticasAsync();
        cajasDisponibles = await Carpetas.ObtenerCajasAsync();
    }

    private int GetCount(Sede s) =>
        stats?.Sedes.FirstOrDefault(x => x.Sede == s)?.Total ?? 0;

    private async Task SeleccionarSede(Sede? s)
    {
        filtroSede = s;
        page = 1;
        CancelarSeleccion();
        await CargarAsync();
    }

    private async Task SeleccionarTramite(string? tramite)
    {
        filtroTramite = tramite;
        page = 1;
        CancelarSeleccion();
        await CargarAsync();
    }

    private async Task SeleccionarFiltroAlmacenamiento(bool? sinCaja)
    {
        filtroSinCaja = sinCaja;
        filtroCaja = null;
        page = 1;
        CancelarSeleccion();
        await CargarAsync();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
        {
            await BuscarAsync();
        }
    }

    private async Task LimpiarBusqueda()
    {
        texto = null;
        await BuscarAsync();
    }

    private async Task ResetFiltros()
    {
        filtroSede = null;
        filtroTramite = null;
        filtroCaja = null;
        filtroSinCaja = null;
        filtroEstado = null;
        texto = null;
        page = 1;
        CancelarSeleccion();
        await CargarAsync();
    }

    private Task BuscarAsync()
    {
        page = 1;
        CancelarSeleccion();
        return CargarAsync();
    }

    private Task IrAsync(int nuevaPagina)
    {
        page = nuevaPagina;
        CancelarSeleccion();
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        saltoPagina = page;
        var query = new ListarCarpetasQuery(
            Texto: texto,
            Sede: filtroSede,
            Estado: filtroEstado,
            TipoTramite: filtroTramite,
            CajaArchivo: filtroCaja,
            SinCaja: filtroSinCaja,
            Page: page,
            PageSize: pageSize);

        resultado = await Carpetas.ListarAsync(query);
        if (resultado is not null)
        {
            foreach (var item in resultado.Items)
            {
                if (seleccionadas.Contains(item.Id))
                {
                    itemsSeleccionadosMap[item.Id] = item;
                }
            }
        }
    }

    private async Task CambiarTamanoPagina()
    {
        page = 1;
        await CargarAsync();
    }

    private async Task OnSaltoKeyUp(KeyboardEventArgs e)
    {
        if (e.Key is "Enter")
        {
            await SaltarAPagina();
        }
    }

    private async Task SaltarAPagina()
    {
        if (resultado is null) return;
        var destino = Math.Clamp(saltoPagina, 1, resultado.TotalPages);
        await IrAsync(destino);
    }

    private void ToggleSelect(Guid id)
    {
        if (!seleccionadas.Add(id))
        {
            seleccionadas.Remove(id);
            itemsSeleccionadosMap.Remove(id);
        }
        else
        {
            var item = resultado?.Items.FirstOrDefault(i => i.Id == id);
            if (item is not null)
            {
                itemsSeleccionadosMap[id] = item;
            }
        }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if (resultado is null) return;
        var check = (bool)(e.Value ?? false);
        if (check)
        {
            foreach (var item in resultado.Items)
            {
                seleccionadas.Add(item.Id);
                itemsSeleccionadosMap[item.Id] = item;
            }
        }
        else
        {
            foreach (var item in resultado.Items)
            {
                seleccionadas.Remove(item.Id);
                itemsSeleccionadosMap.Remove(item.Id);
            }
        }
    }

    private void CancelarSeleccion()
    {
        seleccionadas.Clear();
        itemsSeleccionadosMap.Clear();
    }

    private void AbrirModalCaja(CarpetaResumenDto c)
    {
        esModoLote = false;
        carpetaParaCaja = c;
        nuevaCajaTexto = c.CajaArchivo ?? "";
        mostrarModalCaja = true;
    }

    private void AbrirModalCajaLote()
    {
        if (seleccionadas.Count == 0) return;
        esModoLote = true;
        carpetaParaCaja = null;
        nuevaCajaTexto = "";
        mostrarModalCaja = true;
    }

    private void CerrarModalCaja()
    {
        mostrarModalCaja = false;
        carpetaParaCaja = null;
        nuevaCajaTexto = "";
        esModoLote = false;
    }

    private async Task GuardarCajaAsync()
    {
        if (string.IsNullOrWhiteSpace(nuevaCajaTexto)) return;
        var autor = Autor.HasNombre ? Autor.Nombre! : "Funcionario";

        if (esModoLote)
        {
            await Carpetas.AsignarCajaLoteAsync(new AsignarCajaLoteCommand(seleccionadas.ToList(), nuevaCajaTexto.Trim(), autor));
            CancelarSeleccion();
        }
        else if (carpetaParaCaja is not null)
        {
            await Carpetas.AsignarCajaAsync(new AsignarCajaCommand(carpetaParaCaja.Id, nuevaCajaTexto.Trim(), autor));
        }

        CerrarModalCaja();
        await CargarMetricasAsync();
        await CargarAsync();
    }

    private async Task EnviarACajaDirectoAsync(CarpetaResumenDto c)
    {
        var autor = Autor.HasNombre ? Autor.Nombre! : "Funcionario";
        await Carpetas.AsignarCajaAsync(new AsignarCajaCommand(c.Id, "Cola de Caja", autor));
        await CargarMetricasAsync();
        await CargarAsync();
    }

    private async Task EnviarSeleccionadasACajaColaAsync()
    {
        if (seleccionadas.Count == 0) return;
        var autor = Autor.HasNombre ? Autor.Nombre! : "Funcionario";
        await Carpetas.AsignarCajaLoteAsync(new AsignarCajaLoteCommand(seleccionadas.ToList(), "Cola de Caja", autor));
        CancelarSeleccion();
        await CargarMetricasAsync();
        await CargarAsync();
    }

    private Guid? guardandoId;
    private Guid? guardadoOkId;

    // Modal de Observaciones Rápidas (📝)
    private bool mostrarModalObs;
    private CarpetaResumenDto? carpetaParaObs;
    private string textoObs = "";
    private string? errorObs;
    private bool guardandoObs;

    private void AbrirModalObs(CarpetaResumenDto c)
    {
        carpetaParaObs = c;
        textoObs = c.IdoneidadMoral ?? "";
        errorObs = null;
        guardandoObs = false;
        mostrarModalObs = true;
    }

    private void CerrarModalObs()
    {
        mostrarModalObs = false;
        carpetaParaObs = null;
        textoObs = "";
        errorObs = null;
    }

    private async Task GuardarObservacionModalAsync()
    {
        if (carpetaParaObs is null) return;
        guardandoObs = true;
        errorObs = null;
        try
        {
            var autor = Autor.HasNombre ? Autor.Nombre! : "Funcionario";
            await Carpetas.GuardarObservacionAsync(carpetaParaObs.Id, textoObs, autor);
            CerrarModalObs();
            await CargarMetricasAsync();
            await CargarAsync();
        }
        catch (Exception ex)
        {
            errorObs = $"Error al guardar: {ex.Message}";
        }
        finally
        {
            guardandoObs = false;
        }
    }

    private async Task CambiarEstadoRapidoAsync(Guid id, ChangeEventArgs e)
    {
        if (Enum.TryParse<EstadoCarpeta>(e.Value?.ToString(), out var nuevoEstado))
        {
            guardandoId = id;
            StateHasChanged();

            try
            {
                var autor = Autor.HasNombre ? Autor.Nombre! : "Funcionario";
                await Carpetas.ForzarEstadoAsync(id, nuevoEstado, autor);
                guardadoOkId = id;
                await CargarMetricasAsync();
                await CargarAsync();

                _ = Task.Run(async () =>
                {
                    await Task.Delay(1800);
                    if (guardadoOkId == id)
                    {
                        guardadoOkId = null;
                        await InvokeAsync(StateHasChanged);
                    }
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al cambiar estado rápido: {ex.Message}");
                await CargarAsync();
            }
            finally
            {
                guardandoId = null;
            }
        }
