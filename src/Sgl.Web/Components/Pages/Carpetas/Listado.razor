    private IReadOnlyList<string> ColumnasBandeja =>
        bandejaActiva is { } b ? ColumnasPorBandeja[b] : [];

    private async Task SeleccionarBandeja(Bandeja? b)
    {
        if (b == bandejaActiva) return;
        // Los conteos por bandeja no dependen de la bandeja activa: solo se recalcula el total.
        // Se consulta ANTES de cambiar de pestaña para que la tabla nueva (que se vuelve a montar
        // con @key y pide su propio rango) no comparta el DbContext con otra consulta en curso.
        InvalidarIds();
        var conteo = await Carpetas.ListarAsync(ConsultaActual(take: 0) with { Bandeja = b });
        CancelarSeleccion();
        // Same Virtualize instance between trays (only "Todas" uses another table): re-measuring a fresh
        // Virtualize costs ~1 s, refreshing the mounted one keeps the module switch well under 1 s.
        var eraDirecta = filasDirectas is not null;
        bandejaActiva = b;
        await CargarFilasDirectasAsync(conteo.Total);
        var mismaTabla = !eraDirecta && filasDirectas is null && virtualizador is not null
            && (b is null) == (bandejaActiva is null) && total is > 0 && conteo.Total > 0;
        if (!mismaTabla) virtualizador = null;
        total = conteo.Total;
        pedirFilasTrasMontar = mismaTabla;
    }

    private bool pedirFilasTrasMontar;

    /// <summary>Trays up to this size are rendered directly (all rows at once) instead of virtualized.</summary>
    private const int MaxFilasDirectas = 200;

    /// <summary>All rows of a small tray, already enriched; null when the tray is virtualized.</summary>
    private List<CarpetaResumenDto>? filasDirectas;

    private async Task CargarFilasDirectasAsync(int totalBandeja)
    {
        if (bandejaActiva is null || totalBandeja == 0 || totalBandeja > MaxFilasDirectas)
        {
            filasDirectas = null;
            return;
        }

        var rango = await Carpetas.ListarAsync(ConsultaActual(0, totalBandeja));
        filasDirectas = rango.Items.ToList();
        foreach (var item in filasDirectas.Where(i => seleccionadas.Contains(i.Id)))
        {
            itemsSeleccionadosMap[item.Id] = item;
        }
        virtualizador = null;
    }

