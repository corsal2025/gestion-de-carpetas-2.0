    /// <summary>After classifying into Archivos / Of. 43, offer the listing of what just arrived.</summary>
    private void OfrecerListadoBusqueda(ClasificarResultado resultado)
    {
        ofertaListado.Clear();
        foreach (var (destino, bandeja) in new[]
                 {
                     (EstadoCarpeta.SeEncuentraEnArchivos, Bandeja.SeEncuentraEnArchivos),
                     (EstadoCarpeta.SeEncuentraEnOf43, Bandeja.SeEncuentraEnOf43),
                 })
        {
            var ids = resultado.IdsEn(destino);
            if (ids.Count > 0) ofertaListado.Add(new OfertaListado(bandeja, destino, ids));
        }
    }

    private async Task AbrirListadoBusquedaAsync(Bandeja bandeja, IReadOnlyCollection<Guid>? ids)
    {
        if (cargandoListado) return;
        cargandoListado = true;
        errorListado = null;
        try
        {
            // Filters of the screen apply only inside the module itself; from the offer after classifying, only the new ids.
            var filtros = ids is not null && bandeja != bandejaActiva ? new ListarCarpetasQuery() : ConsultaActual();
            listadoBusqueda = await Carpetas.ObtenerListadoBusquedaAsync(bandeja, filtros, ids);
        }
        catch (Exception ex) when (ex is DomainException or NotFoundException)
        {
            errorListado = ex.Message;
