    // Filtros preseleccionados por query string (p. ej. desde Estadísticas): bandeja, sede, estado, desde, hasta, caja.
    [SupplyParameterFromQuery(Name = "bandeja")] public string? QueryBandeja { get; set; }
    [SupplyParameterFromQuery(Name = "sede")] public string? QuerySede { get; set; }
    [SupplyParameterFromQuery(Name = "estado")] public string? QueryEstado { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] public string? QueryDesde { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] public string? QueryHasta { get; set; }
    [SupplyParameterFromQuery(Name = "caja")] public string? QueryCaja { get; set; }
    [SupplyParameterFromQuery(Name = "buscar")] public string? QueryBuscar { get; set; }

    private string? queryBandejaAplicada;
    private string? queryBuscarAplicada;

    /// <summary>The side menu navigates with ?bandeja=…; switching module only reloads count and visible rows.</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (total is null) return;
        var cambioBuscar = QueryBuscar != queryBuscarAplicada;
        var cambioBandeja = QueryBandeja != queryBandejaAplicada;
        if (!cambioBuscar && !cambioBandeja) return;
        if (cambioBuscar)
        {
            queryBuscarAplicada = QueryBuscar;
            if (!string.IsNullOrWhiteSpace(QueryBuscar)) texto = QueryBuscar.Trim();
        }
        if (!cambioBandeja)
        {
            await CargarAsync();
            return;
        }
        queryBandejaAplicada = QueryBandeja;
        var destino = QueryBandeja is null ? Bandeja.PorClasificar
            : QueryBandeja.Equals("todas", StringComparison.OrdinalIgnoreCase) ? (Bandeja?)null
            : Enum.TryParse<Bandeja>(QueryBandeja, true, out var b) && Enum.IsDefined(b) ? b : bandejaActiva;
        await SeleccionarBandeja(destino);
    }

    private void AplicarFiltrosDeQuery()
    {
        queryBandejaAplicada = QueryBandeja;
        queryBuscarAplicada = QueryBuscar;
        if (!string.IsNullOrWhiteSpace(QueryBuscar)) texto = QueryBuscar.Trim();
        if (QueryBandeja is { } b)
        {
            bandejaActiva = b.Equals("todas", StringComparison.OrdinalIgnoreCase) ? null
                : Enum.TryParse<Bandeja>(b, true, out var bandeja) && Enum.IsDefined(bandeja) ? bandeja : bandejaActiva;
        }
        if (Enum.TryParse<Sede>(QuerySede, true, out var sede) && Enum.IsDefined(sede)) filtroSede = sede;
        if (Enum.TryParse<EstadoCarpeta>(QueryEstado, true, out var estado) && Enum.IsDefined(estado)) filtroEstado = estado;
        if (DateOnly.TryParseExact(QueryDesde, "yyyy-MM-dd", out var desde)) filtroDesde = desde;
        if (DateOnly.TryParseExact(QueryHasta, "yyyy-MM-dd", out var hasta)) filtroHasta = hasta;
        if (!string.IsNullOrWhiteSpace(QueryCaja)) filtroCaja = QueryCaja.Trim();
    }

