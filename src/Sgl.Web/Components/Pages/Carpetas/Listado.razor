    private void AbrirModalPdfSector(string sector)
    {
        sectorPdfActivo = sector;
        carpetasParaPdf = itemsSeleccionadosMap.Values
            .Where(c => CalcularSector(c.FechaUltimaCarpeta) == sector)
            .OrderBy(c => c.NombreCompleto)
            .ToList();
        mostrarModalPdf = true;
    }

    private void CerrarModalPdf()
    {
        mostrarModalPdf = false;
        carpetasParaPdf.Clear();
    }

    private void VaciarListadoSectorPdf()
    {
        var idsToRemove = itemsSeleccionadosMap.Values
            .Where(c => CalcularSector(c.FechaUltimaCarpeta) == sectorPdfActivo)
            .Select(c => c.Id)
            .ToList();

        foreach (var id in idsToRemove)
        {
            seleccionadas.Remove(id);
            itemsSeleccionadosMap.Remove(id);
        }

        CerrarModalPdf();
        StateHasChanged();
    }

