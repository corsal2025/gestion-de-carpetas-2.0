    // ---- R11: aviso "Pasó a <módulo>" con deshacer durante 10 s ----
    private UndoToast.AvisoDeshacer? toast;

    private async Task AnunciarCambioDeEstadoAsync(Guid id, EstadoCarpeta nuevo, PuntoRestauracionEstado anterior)
    {
        // The box decides the tray (an archived carpeta stays in Archivadas whatever its state), so read it live.
        string? caja = null;
        try { caja = (await Carpetas.ObtenerAsync(id)).CajaArchivo; }
        catch (NotFoundException) { }
        var antes = Carpeta.ClasificarBandeja(anterior.Estado, anterior.Decision, caja);
        var despues = Carpeta.ClasificarBandeja(nuevo, EstadoTransitions.DecisionFor(nuevo), caja);
        var modulo = ModulosCatalogo.DeBandeja(despues);
        var mensaje = despues != antes && modulo is not null
            ? $"Pasó a {modulo.Nombre}"
            : $"Estado cambiado a {Labels.Of(nuevo)}";
        toast = new UndoToast.AvisoDeshacer(Guid.NewGuid(), mensaje, id, anterior, nuevo);
    }

    private void CerrarToast(UndoToast.AvisoDeshacer aviso)
    {
        if (toast?.Token == aviso.Token) toast = null;
    }

    private async Task DeshacerToastAsync(UndoToast.AvisoDeshacer aviso)
    {
        try
        {
            if (AutorRequerido() is not { } autor) return;
            await Carpetas.DeshacerEstadoAsync(aviso.CarpetaId, aviso.Punto, aviso.EstadoNuevo, autor);
            if (drawerCarpetaId == aviso.CarpetaId) drawerDetalle = await Carpetas.ObtenerAsync(aviso.CarpetaId);
            revEdicion++;
            await CargarMetricasAsync();
            await CargarAsync();
        }
        catch (Exception ex)
        {
            MostrarErrorEdicion(ex, "No se pudo deshacer el cambio");
        }
        finally
        {
            CerrarToast(aviso);
        }
    }

