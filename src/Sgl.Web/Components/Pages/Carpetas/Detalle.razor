@page "/carpetas/{Id:guid}"
@inject CarpetaService Carpetas
@inject Sgl.Application.Solicitudes.SolicitudesF8Service SolicitudesF8
@inject Sgl.Application.Solicitudes.CertificadosService Certificados
@inject AutorState Autor
@inject ILogger<Detalle> Logger
@inject IJSRuntime JS

<PageTitle>@TituloPagina.De("Detalle de carpeta")</PageTitle>

@if (notFound)
{
    <h1>Carpeta no encontrada</h1>
    <p><a href="carpetas">Volver al listado</a></p>
}
else if (carpeta is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="pg-detalle">
    <header class="det-hero card">
        <span class="lico-slot det-lico" data-lico="saluda" aria-hidden="true"></span>
        <div class="det-hero-t">
            <h1><span class="nombre-persona">@carpeta.Nombre @carpeta.Apellido</span> <small class="muted">@carpeta.Rut</small></h1>
            <div class="det-hero-estado">
                <span class="@Labels.Css(carpeta.Estado)">@Labels.Of(carpeta.Estado)</span>
                <span class="det-decision">Decisión: <strong>@Labels.Of(carpeta.Decision)</strong></span>
            </div>
        </div>
        <dl class="det-facts">
            <div><dt>Sede</dt><dd>@Labels.Of(carpeta.Sede)</dd></div>
            <div><dt>Citación</dt><dd>@carpeta.FechaCitacion.ToString("dd-MM-yyyy")</dd></div>
            <div><dt>Subida</dt><dd>@(carpeta.FechaSubida is { } sub ? sub.ToString("dd-MM-yyyy") : "—")</dd></div>
            <div><dt>Caja</dt><dd>@(string.IsNullOrEmpty(carpeta.CajaArchivo) ? "—" : carpeta.CajaArchivo)</dd></div>
        </dl>
    </header>
    @if (carpeta.Anulada)
    {
        <p class="error banner-anulada" role="status"><span>Carpeta <strong>ANULADA</strong> — restaurar desde «Anuladas». (motivo: @carpeta.MotivoAnulacion). No aparece en módulos ni estadísticas; puede restaurarse desde <a href="anuladas">Anuladas</a>.</span></p>
    }

    @if (error is not null)
    {
        <p class="error" role="alert"><span class="lico-slot lico-msg" data-lico="alerta" aria-hidden="true"></span><span>@error</span></p>
    }
    @if (mensaje is not null)
    {
        <p class="ok-msg" role="status"><span class="lico-slot lico-msg" data-lico="celebra" aria-hidden="true"></span><span>@mensaje</span></p>
    }

    <fieldset class="fieldset-limpio" disabled="@carpeta.Anulada" aria-disabled="@(carpeta.Anulada ? "true" : "false")">
    <div class="grid det-grid">
        <section class="card det-estado">
            <h2>Estado</h2>
            <ol class="det-pasos" aria-label="Etapa del proceso">
                @for (var i = 0; i < Etapas.Length; i++)
                {
                    var paso = i < etapaActual ? "done" : i == etapaActual ? "now" : "";
                    <li class="@paso" aria-current="@(i == etapaActual ? "step" : null)"><i aria-hidden="true">@(i < etapaActual ? "✓" : "")</i>@Etapas[i]</li>
                }
            </ol>
            <p>
                Actual: <span class="@Labels.Css(carpeta.Estado)">@Labels.Of(carpeta.Estado)</span>
                · Decisión: <strong>@Labels.Of(carpeta.Decision)</strong>
            </p>
            @if (carpeta.SiguientesEstados.Count == 0)
            {
                <p class="muted">No hay transiciones disponibles desde este estado.</p>
            }
            else
            {
                <div class="det-opciones" role="radiogroup" aria-label="Nuevo estado">
                    @foreach (var e in carpeta.SiguientesEstados)
                    {
                        var elegido = nuevoEstado == e;
                        <button type="button" class="det-opcion @(elegido ? "on" : null)" role="radio" aria-checked="@(elegido ? "true" : "false")"
                                @onclick="() => nuevoEstado = e">@Labels.Of(e)</button>
                    }
                </div>
                <div class="inline">
                    <button disabled="@(nuevoEstado is null)" @onclick="CambiarEstadoAsync">Cambiar estado</button>
                </div>
            }
        </section>

        <section class="card det-datos">
            <h2>Datos de la carpeta y ciudadano</h2>
            <div class="form">
                <label>Nombre completo del Ciudadano
                    <input @bind="editNombre" maxlength="201" placeholder="NOMBRES APELLIDO PATERNO APELLIDO MATERNO"
                           title="Los dos últimos términos se guardan como apellidos; se aplica a todas las carpetas de esta persona." />
                </label>
                <label>RUT del Ciudadano
                    <div class="det-rut-fila">
                        <input class="rut-input" @bind="editRut" oninput="formatRutInput(this)" placeholder="12.345.678-9" />
                        <button type="button" class="btn-copy-rut" title="Copiar RUT para CAS-Chile" @onclick="() => CopiarRutCasChileAsync(editRut)">📋 Copiar</button>
                    </div>
                </label>
                <label>Sede
                    <select @bind="edit.Sede">
                        @foreach (var s in Enum.GetValues<Sede>())
                        {
                            <option value="@s">@Labels.Of(s)</option>
                        }
                    </select>
                </label>
                <label>Fecha de citación <input type="date" @bind="edit.FechaCitacion" /></label>
                <label>Fecha de subida <input type="date" @bind="edit.FechaSubida" /></label>
                <div class="field">
                    <span>Clase de licencia</span>
                    <ClasesSelector @bind-Value="editClases" />
                </div>
                <label>Caja / Archivo físico <input @bind="editCaja" maxlength="@Carpeta.MaxCajaLength" placeholder="Ej: CAJA AA-01, OF. 43, ARCHIVO" /></label>
                <div class="info-block">
                    <p>En esta etapa desde: <strong>@(carpeta.FechaEstadoActual is { } etapa ? HoraChile.ALocal(etapa).ToString("dd-MM-yyyy HH:mm") : "—")</strong></p>
                    @if (carpeta.FechaCierre is { } cierre)
                    {
                        <p>Proceso cerrado el: <strong>@cierre.ToString("dd-MM-yyyy")</strong></p>
                    }
                    @if (carpeta.FechaImpresion is { } impresa)
                    {
                        <p>Incluida en un listado impreso el: <strong>@HoraChile.ALocal(impresa).ToString("dd-MM-yyyy HH:mm")</strong></p>
                    }
                    <p>Trámite / Tipo: <strong>@(string.IsNullOrEmpty(carpeta.TipoTramite) ? "—" : carpeta.TipoTramite)</strong></p>
                    <p>Última carpeta / Comuna: <strong>@(string.IsNullOrEmpty(carpeta.FechaUltimaCarpeta) ? "—" : carpeta.FechaUltimaCarpeta)</strong></p>
                </div>
                <div class="actions"><button @onclick="GuardarAsync">Guardar cambios</button></div>
            </div>
        </section>
    </div>
    </fieldset>

    @if (solicitudF8 is not null || certificadosAsociados.Count > 0)
    {
        <section class="card det-solicitudes" style="margin-top: 1rem;">
            <h2>Solicitudes especiales vinculadas</h2>
            @if (solicitudF8 is not null)
            {
                <div class="info-block" style="margin-bottom: 0.8rem; background: var(--surface-alt); padding: 0.8rem; border-radius: 8px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <strong>Solicitud de Creación de F8</strong>
                        <span class="pill-status @(solicitudF8.Estado == EstadoSolicitudF8.Subido ? "ok" : solicitudF8.Estado == EstadoSolicitudF8.NoSeGenero ? "bad" : "warn")">
                            @solicitudF8.Estado
                        </span>
                    </div>
                    <p style="margin: 0.3rem 0 0; font-size: 0.85rem;">
                        Pedida por: <strong>@solicitudF8.SolicitadoPor</strong> el @Sgl.Domain.HoraChile.ALocal(solicitudF8.SolicitadoEn).ToString("dd-MM-yyyy HH:mm")
                        @if (!string.IsNullOrEmpty(solicitudF8.Observacion))
                        {
                            <span> · Obs: @solicitudF8.Observacion</span>
                        }
                    </p>
                    <div style="margin-top: 0.5rem;">
                        <a href="carpetas?bandeja=SinCarpetaF8&buscar=@Uri.EscapeDataString(carpeta.Rut)" class="btn-small" style="text-decoration:none;">Ver en módulo F8 →</a>
                    </div>
                </div>
            }
            @if (certificadosAsociados.Count > 0)
            {
                <div class="info-block" style="background: var(--surface-alt); padding: 0.8rem; border-radius: 8px;">
                    <strong>Certificados / Oficios (@certificadosAsociados.Count)</strong>
                    <ul style="list-style:none; padding:0; margin:0.5rem 0 0;">
                        @foreach (var c in certificadosAsociados)
                        {
                            <li style="display:flex; justify-content:space-between; align-items:center; padding: 0.4rem 0; border-bottom: 1px solid var(--border-color);">
                                <div>
                                    <span style="font-weight:600;">@c.Tipo</span>
                                    @if (!string.IsNullOrEmpty(c.NumeroOficio))
                                    {
                                        <span> · Oficio N° @c.NumeroOficio</span>
                                    }
                                    <span style="font-size:0.8rem; color:var(--text-muted); margin-left:0.5rem;">
                                        (@Sgl.Domain.HoraChile.ALocal(c.SolicitadoEn).ToString("dd-MM-yyyy"))
                                    </span>
                                </div>
                                <div style="display:flex; gap:0.5rem; align-items:center;">
                                    <span class="pill-status @(c.Estado == EstadoCertificado.Firmado ? "ok" : "warn")">@c.Estado</span>
                                    <a href="/certificados/@c.Id/documento" class="btn-small" target="_blank" title="Descargar documento Word">Descargar Word</a>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            }
        </section>
    }

    <section class="card det-historial">
        <h2>Historial de cambios</h2>
        <table class="hist-tabla">
            <thead><tr><th>Fecha</th><th>Usuario</th><th>Campo</th><th>Anterior</th><th>Nuevo</th></tr></thead>
            <tbody>
                @foreach (var h in carpeta.Historial)
                {
                    <tr>
                        <td>@Sgl.Domain.HoraChile.ALocal(h.Fecha).ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@h.Usuario</td>
                        <td>@Labels.Campo(h.Campo)</td>
                        <td class="celda-trunca" title="@h.Anterior">@h.Anterior</td>
                        <td class="celda-trunca" title="@h.Nuevo">@h.Nuevo</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <p><a href="carpetas">‹ Volver al listado</a></p>
    </div>
}

@* Transfers are automatic: no "Pasó a…" / Deshacer notice is shown. *@

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CarpetaDetalleDto? carpeta;
    private Sgl.Application.Solicitudes.SolicitudF8Dto? solicitudF8;
    private IReadOnlyList<Sgl.Application.Solicitudes.SolicitudCertificadoDto> certificadosAsociados = [];
    private EstadoCarpeta? nuevoEstado;
    private EditModel edit = new();
    private string editRut = "";
    private string editNombre = "";
    private string editCaja = "";
    private ClaseLicencia editClases;
    private bool notFound;
    private string? error;
    private string? mensaje;
    private UndoToast.AvisoDeshacer? toast;

    private static readonly string[] Etapas = ["Entrada", "Preparación", "Subidas", "Cierre"];

    /// <summary>Presentation-only: which of the four process stages the folder is in, derived from data already loaded.</summary>
    private int etapaActual => carpeta is null ? 0
        : carpeta.FechaCierre is not null ? 3
        : carpeta.Estado is EstadoCarpeta.SubidaConaset or EstadoCarpeta.SubidaConF8 or EstadoCarpeta.SubidaConOficio
            or EstadoCarpeta.CambioDomSubidoConaset or EstadoCarpeta.CambioDomSubidoCorreo ? 2
        : carpeta.Estado is EstadoCarpeta.Citada or EstadoCarpeta.PorClasificar ? 0
        : 1;

    private void CerrarToast(UndoToast.AvisoDeshacer aviso)
    {
        if (toast?.Token == aviso.Token) toast = null;
    }

    private async Task DeshacerAsync(UndoToast.AvisoDeshacer aviso)
    {
        toast = null;
        await EjecutarAsync(
            () => Carpetas.DeshacerEstadoAsync(aviso.CarpetaId, aviso.Punto, aviso.EstadoNuevo, Autor.Nombre),
            "Cambio de estado deshecho.");
    }

    protected override Task OnParametersSetAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        try
        {
            carpeta = await Carpetas.ObtenerAsync(Id);
            nuevoEstado = null;
            editRut = carpeta.Rut;
            editNombre = $"{carpeta.Nombre} {carpeta.Apellido}";
            editCaja = carpeta.CajaArchivo ?? "";
            editClases = carpeta.Clases;
            edit = new EditModel
            {
                Sede = carpeta.Sede,
                FechaCitacion = carpeta.FechaCitacion,
                FechaSubida = carpeta.FechaSubida,
                IdoneidadMoral = carpeta.IdoneidadMoral,
            };

            try
            {
                var f8Res = await SolicitudesF8.ListarAsync(new Sgl.Application.Solicitudes.ListarSolicitudesF8Query(Texto: carpeta.Rut, Take: 5));
                solicitudF8 = f8Res.Items.FirstOrDefault(s => s.CarpetaId == Id);

                var certRes = await Certificados.ListarAsync(new Sgl.Application.Solicitudes.ListarCertificadosQuery(Texto: carpeta.Rut, Take: 10));
                certificadosAsociados = certRes.Items.Where(c => c.CarpetaId == Id).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "No se pudieron cargar solicitudes vinculadas de la carpeta {Id}.", Id);
            }
        }
        catch (NotFoundException)
        {
            notFound = true;
        }
    }

    private Task CambiarEstadoAsync() =>
        nuevoEstado is { } estado
            ? EjecutarAsync(async () =>
            {
                var punto = await Carpetas.CambiarEstadoAsync(new CambiarEstadoCommand(Id, estado, Autor.Nombre));
                var bandeja = Carpeta.ClasificarBandeja(estado, EstadoTransitions.DecisionFor(estado), carpeta?.CajaArchivo);
                var modulo = ModulosCatalogo.DeBandeja(bandeja);
                toast = new UndoToast.AvisoDeshacer(
                    Guid.NewGuid(),
                    modulo is not null ? $"Pasó a {modulo.Nombre}" : $"Estado cambiado a {Labels.Of(estado)}",
                    Id, punto, estado);
            }, "Estado actualizado.")
            : Task.CompletedTask;

    private Task GuardarAsync() =>
        EjecutarAsync(async () =>
        {
            // The name is a person-level correction (own save, validated first); the rest is one command, one save.
            if (carpeta is not null && editNombre.Trim() != $"{carpeta.Nombre} {carpeta.Apellido}")
            {
                await Carpetas.ModificarNombreAsync(Id, editNombre, Autor.Nombre);
            }
            await Carpetas.EditarAsync(new EditarCarpetaCommand(
                Id, edit.Sede, edit.FechaCitacion, edit.FechaSubida, edit.IdoneidadMoral, Autor.Nombre, editRut,
                Caja: editCaja,
                CambiarCaja: editCaja != (carpeta?.CajaArchivo ?? ""),
                Clases: editClases != carpeta?.Clases ? editClases : null));
        }, "Cambios guardados.");

    private async Task CopiarRutCasChileAsync(string? rut)
    {
        if (string.IsNullOrWhiteSpace(rut)) return;
        await JS.InvokeVoidAsync("copyRutCasChile", rut);
    }

    private async Task EjecutarAsync(Func<Task> action, string ok)
    {
        error = null;
        mensaje = null;
        if (!Autor.HasNombre)
        {
            error = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de modificar la carpeta.";
            return;
        }

        try
        {
            await action();
            mensaje = ok;
        }
        catch (Exception ex) when (ex is DomainException or NotFoundException or CarpetaDuplicadaException)
        {
            error = ex.Message;
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException ex)
        {
            Logger.LogError(ex, "No se pudo guardar la carpeta desde el detalle.");
            error = "No se pudieron guardar los cambios (conflicto al guardar). Recargue e intente nuevamente.";
        }

        await CargarAsync();
    }

    private sealed class EditModel
    {
        public Sede Sede { get; set; }

        public DateOnly FechaCitacion { get; set; }

        public DateOnly? FechaSubida { get; set; }

        public string? IdoneidadMoral { get; set; }
    }
}
