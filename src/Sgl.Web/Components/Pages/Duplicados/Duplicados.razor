@page "/duplicados"
@inject DuplicadosService Revision
@inject CarpetaService Carpetas
@inject AutorState Autor
@inject DuplicadosNotifier Notifier

<PageTitle>Gestión de Carpetas 2.0 · Posibles Duplicados</PageTitle>

<h1>Posibles Duplicados</h1>
<p class="muted">Ciudadanos con más de una carpeta abierta (sin decisión de otorgamiento o denegación). Revise cada caso, asigne la clase de licencia si corresponde y márquelo como revisado.</p>

<form class="card dup-filtros" @onsubmit="BuscarAsync" @onsubmit:preventDefault>
    <label>Buscar por RUT o nombre
        <input @bind="texto" placeholder="12.345.678-5 o nombre" maxlength="100" />
    </label>
    <label>Sede
        <select @bind="sedeTexto">
            <option value="">Todas</option>
            @foreach (var s in Enum.GetValues<Sede>())
            {
                <option value="@s">@Labels.Of(s)</option>
            }
        </select>
    </label>
    <div class="actions">
        <button type="submit">Buscar</button>
        <button type="button" class="secondary" @onclick="LimpiarAsync">Limpiar</button>
    </div>
</form>

@if (error is not null)
{
    <p class="error" role="alert"><span class="lico-slot lico-msg" data-lico="alerta" aria-hidden="true"></span><span>@error</span></p>
}
@if (mensaje is not null)
{
    <p class="ok-msg" role="status"><span>@mensaje</span></p>
}

@if (resultado is null)
{
    <p>Cargando…</p>
}
else if (resultado.Items.Count == 0)
{
    <p class="muted">No hay casos pendientes de revisión.</p>
}
else
{
    <section class="card">
        <table class="dup-tabla">
            <thead><tr><th></th><th>RUT</th><th>Nombre</th><th>Carpetas abiertas</th><th></th></tr></thead>
            <tbody>
                @foreach (var g in resultado.Items)
                {
                    var abierto = expandidos.ContainsKey(g.CiudadanoId);
                    <tr class="dup-grupo">
                        <td>
                            <button type="button" class="btn-link" aria-expanded="@(abierto ? "true" : "false")"
                                    aria-label="@(abierto ? "Ocultar carpetas" : "Ver carpetas")" @onclick="() => ToggleAsync(g.CiudadanoId)">
                                @(abierto ? "▾" : "▸")
                            </button>
                        </td>
                        <td>@g.Rut</td>
                        <td>@g.NombreCompleto</td>
                        <td>@g.CarpetasAbiertas</td>
                        <td>
                            <button type="button" disabled="@(ocupado)" @onclick="() => MarcarRevisadoAsync(g.CiudadanoId)">Marcar como revisado</button>
                        </td>
                    </tr>
                    @if (abierto && expandidos[g.CiudadanoId] is { } carpetas)
                    {
                        <tr class="dup-detalle">
                            <td></td>
                            <td colspan="4">
                                <table class="dup-carpetas">
                                    <thead><tr><th>Sede</th><th>Fecha de citación</th><th>Estado</th><th>Clase</th><th></th></tr></thead>
                                    <tbody>
                                        @foreach (var c in carpetas)
                                        {
                                            <tr>
                                                <td>@Labels.Of(c.Sede)</td>
                                                <td>@c.FechaCitacion.ToString("dd-MM-yyyy")</td>
                                                <td><span class="@Labels.Css(c.Estado)">@Labels.Of(c.Estado)</span></td>
                                                <td>
                                                    <ClasesSelector Value="ClaseEditada(c)" ValueChanged="v => clasesEditadas[c.Id] = v"
                                                                    AriaLabel="@($"Clase de licencia de la carpeta de {Labels.Of(c.Sede)}")" Disabled="ocupado" />
                                                    @if (ClaseEditada(c) != c.Clases)
                                                    {
                                                        <button type="button" class="btn-small" disabled="@ocupado" @onclick="() => GuardarClaseAsync(g.CiudadanoId, c)">Guardar clase</button>
                                                    }
                                                </td>
                                                <td><a href="carpetas/@c.Id">Abrir carpeta</a></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <nav class="dup-paginacion" aria-label="Paginación">
            <button type="button" class="secondary" disabled="@(resultado.Page <= 1)" @onclick="() => IrAsync(resultado.Page - 1)">‹ Anterior</button>
            <span>Página @resultado.Page de @resultado.TotalPages · @resultado.Total casos</span>
            <button type="button" class="secondary" disabled="@(resultado.Page >= resultado.TotalPages)" @onclick="() => IrAsync(resultado.Page + 1)">Siguiente ›</button>
        </nav>
    </section>
}

@code {
    private const int PageSize = 25;

    private PagedResult<DuplicadoGrupoDto>? resultado;
    private readonly Dictionary<Guid, IReadOnlyList<CarpetaAbiertaDto>?> expandidos = [];
    private readonly Dictionary<Guid, ClaseLicencia> clasesEditadas = [];
    private string texto = "";
    private string sedeTexto = "";
    private int page = 1;
    private bool ocupado;
    private string? error;
    private string? mensaje;

    protected override Task OnInitializedAsync() => CargarAsync();

    private Sede? SedeFiltro => Enum.TryParse<Sede>(sedeTexto, out var s) ? s : null;

    private ClaseLicencia ClaseEditada(CarpetaAbiertaDto c) =>
        clasesEditadas.TryGetValue(c.Id, out var v) ? v : c.Clases;

    private async Task CargarAsync()
    {
        try
        {
            resultado = await Revision.ListarAsync(new ListarDuplicadosQuery(texto, SedeFiltro, page, PageSize));
            if (resultado.Items.Count == 0 && page > 1)
            {
                page = resultado.TotalPages;
                resultado = await Revision.ListarAsync(new ListarDuplicadosQuery(texto, SedeFiltro, page, PageSize));
            }
        }
        catch (Exception)
        {
            error = "No se pudo cargar la lista de posibles duplicados.";
            resultado ??= new PagedResult<DuplicadoGrupoDto>([], 0, 1, PageSize);
        }
    }

    private Task BuscarAsync()
    {
        page = 1;
        expandidos.Clear();
        return CargarAsync();
    }

    private Task LimpiarAsync()
    {
        texto = "";
        sedeTexto = "";
        return BuscarAsync();
    }

    private Task IrAsync(int nuevaPagina)
    {
        page = nuevaPagina;
        expandidos.Clear();
        return CargarAsync();
    }

    private async Task ToggleAsync(Guid ciudadanoId)
    {
        if (!expandidos.Remove(ciudadanoId))
        {
            await CargarCarpetasAsync(ciudadanoId);
        }
    }

    private async Task CargarCarpetasAsync(Guid ciudadanoId)
    {
        var carpetas = await Revision.ObtenerCarpetasAsync(ciudadanoId);
        expandidos[ciudadanoId] = carpetas;
        foreach (var c in carpetas)
        {
            clasesEditadas.Remove(c.Id);
        }
    }

    private Task GuardarClaseAsync(Guid ciudadanoId, CarpetaAbiertaDto carpeta) =>
        EjecutarAsync(async () =>
        {
            await Carpetas.AsignarClasesAsync(carpeta.Id, ClaseEditada(carpeta), Autor.Nombre);
            await CargarCarpetasAsync(ciudadanoId);
        }, "Clase de licencia actualizada.");

    private Task MarcarRevisadoAsync(Guid ciudadanoId) =>
        EjecutarAsync(async () =>
        {
            await Revision.MarcarRevisadoAsync(ciudadanoId, Autor.Nombre);
            expandidos.Remove(ciudadanoId);
            await CargarAsync();
            Notifier.Notify();
        }, "Caso marcado como revisado.");

    private async Task EjecutarAsync(Func<Task> action, string ok)
    {
        error = null;
        mensaje = null;
        if (!Autor.HasNombre)
        {
            error = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de continuar.";
            return;
        }

        ocupado = true;
        try
        {
            await action();
            mensaje = ok;
        }
        catch (DomainException ex)
        {
            error = ex.Message;
        }
        catch (NotFoundException ex)
        {
            error = ex.Message;
        }
        finally
        {
            ocupado = false;
        }
    }
}
