@page "/duplicados"
@layout ModuloLayout
@inject DuplicadosService Revision
@inject IJSRuntime JS
@inject ILogger<Duplicados> Logger
@inject CarpetaService Carpetas
@inject AutorState Autor
@inject DuplicadosNotifier Notifier

<PageTitle>@TituloPagina.De("Posibles duplicados")</PageTitle>

<div class="modulo-scroll">
<h1>Posibles Duplicados</h1>
<p class="muted">Ciudadanos con más de una carpeta abierta (mismo RUT, distintas fechas). Para cada caso: <strong>Reagendar</strong> (conservar una y moverla a la fecha de la otra, que se anula), <strong>Anular duplicada</strong> o <strong>mantener ambas</strong> (marcar como revisado).</p>

<form class="card dup-filtros" @onsubmit="BuscarAsync" @onsubmit:preventDefault>
    <label>Buscar por RUT o nombre
        <input @bind="texto" placeholder="12.345.678-5 o nombre" maxlength="100" />
    </label>
    <label>Sede
        <select @bind="sedeTexto">
            <option value="">Todas</option>
            @foreach (var s in Enum.GetValues<Sede>())
            {
                <option value="@s">@Labels.Of(s)</option>
            }
        </select>
    </label>
    <div class="actions">
        <button type="submit">Buscar</button>
        <button type="button" class="secondary" @onclick="LimpiarAsync">Limpiar</button>
    </div>
</form>

@if (error is not null)
{
    <p class="error" role="alert"><span class="lico-slot lico-msg" data-lico="alerta" aria-hidden="true"></span><span>@error</span></p>
}
@if (mensaje is not null)
{
    <p class="ok-msg" role="status"><span>@mensaje</span></p>
}

@if (total is null)
{
    <p>Cargando…</p>
}
else if (total == 0)
{
    <p class="muted">No hay casos pendientes de revisión.</p>
}
else
{
    <section class="card">
        <p class="dup-total"><strong>@total.Value.ToString("N0", CulturaCl)</strong> @(total == 1 ? "caso" : "casos") pendientes · haga clic en una fila para comparar sus carpetas</p>
        @if (grupoAbierto is { } g)
        {
            <div class="dup-comparacion" aria-live="polite">
                <header class="dup-comparacion-head">
                    <strong>Carpetas abiertas de @g.NombreCompleto · @g.Rut</strong>
                    <span class="dup-head-acciones"><button type="button" class="dup-btn-mantener btn-small" disabled="@ocupado" @onclick="() => MarcarRevisadoAsync(g.CiudadanoId)">No es duplicada: mantener ambas</button><button type="button" class="secondary btn-small" @onclick="() => ToggleAsync(g)">Cerrar ✕</button></span>
                </header>
                                        @if (expandidos[g.CiudadanoId] is not { } carpetas)
                                        {
                                            <p class="muted">Cargando carpetas…</p>
                                        }
                                        else
                                        {
                                            <div class="dup-cards">
                                                @foreach (var c in carpetas)
                                                {
                                                    <article class="dup-card">
                                                        <header class="dup-card-head">
                                                            <strong>@Labels.Of(c.Sede)</strong>
                                                            <span class="@Labels.Css(c.Estado)">@Labels.Of(c.Estado)</span>
                                                        </header>
                                                        <dl class="dup-campos">
                                                            @foreach (var campo in Campos.Where(x => x.Clave))
                                                            {
                                                                <div class="@(Difiere(carpetas, campo.Valor) ? "dup-difiere" : "")">
                                                                    <dt>@campo.Etiqueta</dt>
                                                                    <dd>@campo.Valor(c)</dd>
                                                                </div>
                                                            }
                                                        </dl>
                                                        <button type="button" class="dup-btn-conservar" disabled="@ocupado" @onclick="() => ConservarAsync(g, c, carpetas)">
                                                            Conservar esta carpeta
                                                        </button>
                                                        <details class="dup-mas">
                                                            <summary>Más datos y opciones</summary>
                                                            <dl class="dup-campos">
                                                                @foreach (var campo in Campos.Where(x => !x.Clave))
                                                                {
                                                                    <div class="@(Difiere(carpetas, campo.Valor) ? "dup-difiere" : "")">
                                                                        <dt>@campo.Etiqueta</dt>
                                                                        <dd>@campo.Valor(c)</dd>
                                                                    </div>
                                                                }
                                                            </dl>
                                                            <div class="dup-clase">
                                                                <span>Asignar clase:</span>
                                                                <ClasesSelector Value="ClaseEditada(c)" ValueChanged="v => clasesEditadas[c.Id] = v"
                                                                                AriaLabel="@($"Clase de licencia de la carpeta de {Labels.Of(c.Sede)}")" Disabled="ocupado" />
                                                                @if (ClaseEditada(c) != c.Clases)
                                                                {
                                                                    <button type="button" class="btn-small" disabled="@ocupado" @onclick="() => GuardarClaseAsync(g.CiudadanoId, c)">Guardar clase</button>
                                                                }
                                                            </div>
                                                            <footer class="dup-card-acciones dup-resolver">
                                                                <a class="btn-small" href="carpetas/@c.Id">Abrir carpeta</a>
                                                                @foreach (var otra in carpetas.Where(o => o.Id != c.Id))
                                                                {
                                                                    <button type="button" class="btn-small" disabled="@ocupado"
                                                                            title="Conserva esta carpeta con la fecha y sede de la otra; la otra se anula (Reagendamiento)"
                                                                            @onclick="() => ReagendarAsync(g, origen: otra, destino: c)">Reagendar a @otra.FechaCitacion.ToString("dd-MM-yyyy")</button>
                                                                }
                                                                <button type="button" class="btn-small btn-peligro" disabled="@ocupado" @onclick="() => AnularAsync(g, c)">Anular esta duplicada</button>
                                                            </footer>
                                                        </details>
                                                    </article>
                                                }
                                            </div>
                                            <p class="muted dup-leyenda">Resaltado = difiere entre las carpetas. «Conservar esta carpeta» anula las demás por duplicado (se pueden restaurar desde «Anuladas»).</p>
                                        }
            </div>
        }
        <div class="dup-scroll">
            <table class="dup-tabla">
                <thead><tr><th class="dup-col-rut">RUT</th><th class="dup-col-nombre">Nombre</th><th>Carpetas abiertas</th><th></th></tr></thead>
                <tbody>
                    <Virtualize @ref="virtualizador" TItem="DuplicadoGrupoDto" Context="g" ItemsProvider="CargarFilasAsync"
                                ItemSize="52" OverscanCount="10" SpacerElement="tr">
                        <ItemContent>
                            @{ var abierto = grupoAbierto?.CiudadanoId == g.CiudadanoId; }
                            <tr class="dup-grupo @(abierto ? "abierto" : "")" @onclick="() => ToggleAsync(g)">
                                <td class="dup-col-rut">@g.Rut</td>
                                <td class="dup-col-nombre">@g.NombreCompleto</td>
                                <td class="dup-col-cant"><span class="dup-badge">@g.CarpetasAbiertas</span></td>
                                <td class="dup-acciones" @onclick:stopPropagation>
                                    <button type="button" class="secondary dup-btn-ver" aria-expanded="@(abierto ? "true" : "false")" @onclick="() => ToggleAsync(g)">
                                        @(abierto ? "▾ Ocultar carpetas" : $"▸ Ver carpetas ({g.CarpetasAbiertas})")
                                    </button>
                                    <button type="button" class="dup-btn-mantener" disabled="@(ocupado)"title="Crear nueva: mantener ambas carpetas" @onclick="() => MarcarRevisadoAsync(g.CiudadanoId)">Mantener ambas (revisado)</button>
                                </td>
                            </tr>
                        </ItemContent>
                        <Placeholder>
                            <tr class="dup-grupo"><td colspan="4">&nbsp;</td></tr>
                        </Placeholder>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    </section>
}
</div>

@code {
    private static readonly System.Globalization.CultureInfo CulturaCl = new("es-CL");

    private sealed record Campo(string Etiqueta, Func<CarpetaDuplicadoDetalleDto, string> Valor, bool Clave = false);

    private static readonly Campo[] Campos =
    [
        new("Ubicación física (sector)", c => SectorTexto(c.FechaUltimaCarpeta)),
        new("Caja de archivo", c => string.IsNullOrWhiteSpace(c.CajaArchivo) ? "Sin caja" : c.CajaArchivo!),
        new("Última carpeta", c => string.IsNullOrWhiteSpace(c.FechaUltimaCarpeta) ? "S/C" : c.FechaUltimaCarpeta!),
        new("Trámite", c => string.IsNullOrWhiteSpace(c.TipoTramite) ? "—" : c.TipoTramite!),
        new("Fecha de citación", c => c.FechaCitacion.ToString("dd-MM-yyyy"), Clave: true),
        new("Fecha de subida", c => c.FechaSubida?.ToString("dd-MM-yyyy") ?? "—", Clave: true),
        new("Clase(s)", c => c.Clases == ClaseLicencia.Ninguna ? "Sin clase" : Labels.Of(c.Clases), Clave: true),
        new("Decisión", c => Labels.Of(c.Decision), Clave: true),
        new("Pendiente de búsqueda", PendienteTexto),
        new("Observación", c => string.IsNullOrWhiteSpace(c.IdoneidadMoral) ? "—" : c.IdoneidadMoral!),
        new("Comuna (cambio de domicilio)", c => Carpeta.EsCambioDomicilio(c.Estado) && !string.IsNullOrWhiteSpace(c.Comuna) ? c.Comuna! : "—"),
        new("Último movimiento", c => c.UltimoMovimientoFecha is { } f
            ? $"{HoraChile.ALocal(f):dd-MM-yyyy HH:mm} · {c.UltimoMovimientoPor}" : "Sin movimientos", Clave: true),
    ];

    private static string SectorTexto(string? fechaUltimaCarpeta) => SectorFisico.Calcular(fechaUltimaCarpeta) switch
    {
        SectorFisico.Archivo => "Archivo",
        SectorFisico.Oficina43 => "Of. 43",
        _ => "Sin dato",
    };

    private static string PendienteTexto(CarpetaDuplicadoDetalleDto c)
    {
        if (!c.PendienteBusqueda) return "No";
        if (c.PendienteBusquedaDesde is not { } desde) return "Sí";
        var dias = Math.Max(0, (int)(DateTime.UtcNow - desde).TotalDays);
        return $"Sí · hace {dias} {(dias == 1 ? "día" : "días")}";
    }

    private static bool Difiere(IReadOnlyList<CarpetaDuplicadoDetalleDto> carpetas, Func<CarpetaDuplicadoDetalleDto, string> valor) =>
        carpetas.Select(valor).Distinct(StringComparer.OrdinalIgnoreCase).Skip(1).Any();

    private int? total;
    private Virtualize<DuplicadoGrupoDto>? virtualizador;
    // Una sola comparación abierta, mostrada fuera de la lista virtualizada (alturas de fila uniformes).
    private DuplicadoGrupoDto? grupoAbierto;
    private readonly Dictionary<Guid, IReadOnlyList<CarpetaDuplicadoDetalleDto>?> expandidos = [];
    private readonly Dictionary<Guid, ClaseLicencia> clasesEditadas = [];
    private string texto = "";
    private string sedeTexto = "";
    private bool ocupado;
    private string? error;
    private string? mensaje;

    protected override Task OnInitializedAsync() => CargarAsync();

    private Sede? SedeFiltro => Enum.TryParse<Sede>(sedeTexto, out var s) ? s : null;

    private ClaseLicencia ClaseEditada(CarpetaDuplicadoDetalleDto c) =>
        clasesEditadas.TryGetValue(c.Id, out var v) ? v : c.Clases;

    private ListarDuplicadosQuery Consulta(int skip = 0, int? take = null) => new(texto, SedeFiltro, skip, take);

    /// <summary>Recalcula el total y refresca las filas visibles (lista continua virtualizada).</summary>
    private async Task CargarAsync()
    {
        try
        {
            var antes = total;
            total = (await Revision.ListarAsync(Consulta(take: 0))).Total;
            if (virtualizador is not null && antes is > 0 && total > 0)
            {
                await virtualizador.RefreshDataAsync();
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "No se pudo cargar la lista de posibles duplicados.");
            error = "No se pudo cargar la lista de posibles duplicados.";
            total ??= 0;
        }
    }

    private async ValueTask<ItemsProviderResult<DuplicadoGrupoDto>> CargarFilasAsync(ItemsProviderRequest request)
    {
        var rango = await Revision.ListarAsync(Consulta(request.StartIndex, request.Count), request.CancellationToken);
        if (total != rango.Total)
        {
            total = rango.Total;
            _ = InvokeAsync(StateHasChanged);
        }

        return new ItemsProviderResult<DuplicadoGrupoDto>(rango.Items, rango.Total);
    }

    private Task BuscarAsync()
    {
        grupoAbierto = null;
        expandidos.Clear();
        return CargarAsync();
    }

    private Task LimpiarAsync()
    {
        texto = "";
        sedeTexto = "";
        return BuscarAsync();
    }

    private async Task ToggleAsync(DuplicadoGrupoDto grupo)
    {
        var cerrar = grupoAbierto?.CiudadanoId == grupo.CiudadanoId;
        expandidos.Clear();
        grupoAbierto = null;
        if (cerrar) return;

        grupoAbierto = grupo;
        expandidos[grupo.CiudadanoId] = null;
        await CargarCarpetasAsync(grupo.CiudadanoId);
    }

    private async Task CargarCarpetasAsync(Guid ciudadanoId)
    {
        var carpetas = await Revision.ObtenerDetalleCarpetasAsync(ciudadanoId);
        if (expandidos.ContainsKey(ciudadanoId))
        {
            expandidos[ciudadanoId] = carpetas;
        }

        foreach (var c in carpetas)
        {
            clasesEditadas.Remove(c.Id);
        }
    }

    private Task GuardarClaseAsync(Guid ciudadanoId, CarpetaDuplicadoDetalleDto carpeta) =>
        EjecutarAsync(async () =>
        {
            await Carpetas.AsignarClasesAsync(carpeta.Id, ClaseEditada(carpeta), Autor.Nombre);
            await CargarCarpetasAsync(ciudadanoId);
        }, "Clase de licencia actualizada.");

    private Task MarcarRevisadoAsync(Guid ciudadanoId) =>
        EjecutarAsync(async () =>
        {
            await Revision.MarcarRevisadoAsync(ciudadanoId, Autor.Nombre);
            if (grupoAbierto?.CiudadanoId == ciudadanoId)
            {
                grupoAbierto = null;
                expandidos.Clear();
            }

            await CargarAsync();
            Notifier.Notify();
        }, "Caso marcado como revisado (se mantienen ambas).");

    private async Task ReagendarAsync(DuplicadoGrupoDto g, CarpetaDuplicadoDetalleDto origen, CarpetaDuplicadoDetalleDto destino)
    {
        if (ocupado) return;
        ocupado = true; // disabled before the first await (no double submit)
        bool confirmado;
        try
        {
            confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Conservar la carpeta de {Labels.Of(destino.Sede)} y moverla al {origen.FechaCitacion:dd-MM-yyyy}? La otra se anulará (Reagendamiento).");
        }
        finally
        {
            ocupado = false;
        }
        if (!confirmado) return;
        await EjecutarAsync(async () =>
        {
            await Carpetas.ReagendarAsync(origen.Id, destino.Id, Autor.Nombre);
            await TrasResolverAsync(g);
        }, "Carpeta reagendada; la duplicada quedó anulada.");
    }

    private async Task ConservarAsync(DuplicadoGrupoDto g, CarpetaDuplicadoDetalleDto conservar, IReadOnlyList<CarpetaDuplicadoDetalleDto> todas)
    {
        if (ocupado) return;
        ocupado = true; // disabled before the first await (no double submit)
        var otras = todas.Where(o => o.Id != conservar.Id).ToList();
        bool confirmado;
        try
        {
            var lista = string.Join(", ", otras.Select(o => $"{o.FechaCitacion:dd-MM-yyyy} ({Labels.Of(o.Sede)})"));
            confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Conservar la carpeta del {conservar.FechaCitacion:dd-MM-yyyy} ({Labels.Of(conservar.Sede)}) y anular por duplicado: {lista}? Podrán restaurarse desde «Anuladas».");
        }
        finally
        {
            ocupado = false;
        }
        if (!confirmado) return;
        await EjecutarAsync(async () =>
        {
            foreach (var otra in otras)
            {
                await Carpetas.AnularAsync(otra.Id, MotivosAnulacion.Duplicado, Autor.Nombre);
            }

            await TrasResolverAsync(g);
        }, "Carpeta conservada; las duplicadas quedaron anuladas.");
    }

    private async Task AnularAsync(DuplicadoGrupoDto g, CarpetaDuplicadoDetalleDto c)
    {
        if (ocupado) return;
        ocupado = true; // disabled before the first await (no double submit)
        bool confirmado;
        try
        {
            confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Anular por duplicado la carpeta del {c.FechaCitacion:dd-MM-yyyy} ({Labels.Of(c.Sede)})? Podrá restaurarse desde «Anuladas».");
        }
        finally
        {
            ocupado = false;
        }
        if (!confirmado) return;
        await EjecutarAsync(async () =>
        {
            await Carpetas.AnularAsync(c.Id, MotivosAnulacion.Duplicado, Autor.Nombre);
            await TrasResolverAsync(g);
        }, "Carpeta anulada por duplicado.");
    }

    /// <summary>Reloads the compared carpetas; closes the case when it no longer has duplicates.</summary>
    private async Task TrasResolverAsync(DuplicadoGrupoDto g)
    {
        var restantes = await Revision.ObtenerDetalleCarpetasAsync(g.CiudadanoId);
        if (restantes.Count < 2)
        {
            grupoAbierto = null;
            expandidos.Clear();
        }
        else if (expandidos.ContainsKey(g.CiudadanoId))
        {
            expandidos[g.CiudadanoId] = restantes;
        }

        await CargarAsync();
        Notifier.Notify();
    }

    private async Task EjecutarAsync(Func<Task> action, string ok)
    {
        error = null;
        mensaje = null;
        if (!Autor.HasNombre)
        {
            error = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de continuar.";
            return;
        }

        ocupado = true;
        try
        {
            await action();
            mensaje = ok;
        }
        catch (DomainException ex)
        {
            error = ex.Message;
        }
        catch (NotFoundException ex)
        {
            error = ex.Message;
        }
        finally
        {
            ocupado = false;
        }
    }
}
