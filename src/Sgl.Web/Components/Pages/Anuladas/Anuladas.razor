@page "/anuladas"
@layout ModuloLayout
@inject CarpetaService Carpetas
@inject AutorState Autor
@inject DuplicadosNotifier DuplicadosNotifier
@inject IJSRuntime JS

<PageTitle>@TituloPagina.De("Anuladas")</PageTitle>

<div class="page-container">
    <div class="modulo-barra">
        <h1 class="modulo-titulo">Anuladas <span class="muted">· @(items?.Count.ToString("N0", Cultura) ?? "…")</span></h1>
        <form class="modulo-busqueda" @onsubmit="CargarAsync" @onsubmit:preventDefault>
            <input @bind="texto" placeholder="Buscar por RUT o nombre" aria-label="Buscar anuladas" maxlength="100" />
            <button type="submit" class="btn-secondary">Buscar</button>
        </form>
    </div>
    @if (error is not null)
    {
        <div class="alert error" role="alert">@error</div>
    }
    @if (mensaje is not null)
    {
        <div class="alert success" role="status">@mensaje</div>
    }

    @if (items is null)
    {
        <div class="loading-state"><div class="spinner"></div><p>Cargando anuladas…</p></div>
    }
    else if (items.Count == 0)
    {
        <div class="empty-state">
            <span class="lico-slot lico-empty" data-lico="celebra" aria-hidden="true"></span>
            <p>No hay carpetas anuladas.</p>
        </div>
    }
    else
    {
        <div class="table-container">
            <table class="data-table bandeja-table">
                <thead>
                    <tr>
                        <th class="th-wrap col-sticky-nombre">NOMBRE DE CONTRIBUYENTE</th>
                        <th class="col-sticky-rut">RUT</th>
                        <th>SEDE</th>
                        <th>CITACIÓN</th>
                        <th>ESTADO PREVIO</th>
                        <th>MOTIVO</th>
                        <th>ANULADA</th>
                        <th>FUNCIONARIO</th>
                        <th>ACCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="items" Context="a" ItemSize="44" OverscanCount="15" SpacerElement="tr">
                        <tr>
                            <td class="col-sticky-nombre">
                                <div class="nombre-wrapper-cell">
                                    <span class="name-cell">@a.NombreCompleto</span>
                                    <span class="nombre-acciones">
                                        <a class="icono-buscar-dup icono-buscar-dup--neutro" href="@($"/carpetas?bandeja=todas&buscar={Uri.EscapeDataString(a.Rut)}")"
                                           title="Buscar otras carpetas de este RUT (repetidos)" aria-label="Buscar en el sistema las otras carpetas de este RUT">
                                            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                                        </a>
                                    </span>
                                </div>
                            </td>
                            <td class="date-cell col-sticky-rut">@a.Rut</td>
                            <td><span class="sede-tag">@Labels.Of(a.Sede)</span></td>
                            <td class="date-cell">@a.FechaCitacion.ToString("dd-MM-yyyy")</td>
                            <td>@Labels.Of(a.Estado)</td>
                            <td class="celda-trunca"><span class="badge @(a.Motivo == MotivosAnulacion.Reagendamiento ? "info" : "warn")" title="@a.Motivo">@a.Motivo</span></td>
                            <td class="date-cell">@HoraChile.ALocal(a.AnuladaEn).ToString("dd-MM-yyyy HH:mm")</td>
                            <td>@a.AnuladaPor</td>
                            <td class="action-cell">
                                <button type="button" class="btn-action-caja" disabled="@ocupado" @onclick="() => RestaurarAsync(a)" title="Vuelve al estado previo (queda en el historial)">Restaurar</button>
                                <a class="btn-detail" href="carpetas/@a.Id" title="Ver detalle e historial">Abrir →</a>
                            </td>
                        </tr>
                    </Virtualize>
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo Cultura = new("es-CL");
    private List<CarpetaAnuladaDto>? items;
    private string? texto;
    private bool ocupado;
    private string? error;
    private string? mensaje;

    protected override Task OnInitializedAsync() => CargarAsync();

    private static string Describir(IEnumerable<CarpetaAbiertaDto> carpetas) =>
        string.Join("; ", carpetas.Select(c => $"del {c.FechaCitacion:dd-MM-yyyy} en {Labels.Of(c.Sede)} ({Labels.Of(c.Estado)}, clase {Labels.Of(c.Clases)})"));

    private async Task CargarAsync() => items = (await Carpetas.ListarAnuladasAsync(texto)).ToList();

    private async Task RestaurarAsync(CarpetaAnuladaDto a)
    {
        error = null;
        mensaje = null;
        if (!Autor.HasNombre)
        {
            error = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de restaurar.";
            return;
        }
        ocupado = true;
        try
        {
            var verificacion = await Carpetas.VerificarRestauracionAsync(a.Id);
            if (verificacion.Bloquea)
            {
                error = "No se puede restaurar: este RUT ya tiene una carpeta abierta con la misma clase " + Describir(verificacion.Bloqueantes) + ". Anule o cierre esa carpeta primero.";
                return;
            }
            var aviso = verificacion.RequiereConfirmacion
                ? $" Atención: este RUT ya tiene otra carpeta abierta {Describir(verificacion.Advertencias)} (sin clase en común)."
                : "";
            if (!await JS.InvokeAsync<bool>("confirm", $"¿Restaurar la carpeta de {a.NombreCompleto}? Volverá a «{Labels.Of(a.Estado)}».{aviso}"))
            {
                return;
            }

            await Carpetas.RestaurarAsync(a.Id, Autor.Nombre!);
            mensaje = "Carpeta restaurada.";
            await CargarAsync();
            DuplicadosNotifier.Notify();
        }
        catch (CarpetaDuplicadaException)
        {
            error = "No se puede restaurar: este RUT ya tiene una carpeta abierta con la misma clase.";
        }
        catch (Exception ex) when (ex is DomainException or NotFoundException)
        {
            error = ex.Message;
        }
        finally
        {
            ocupado = false;
        }
    }
}
