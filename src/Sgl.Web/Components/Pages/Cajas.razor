@page "/cajas"
@inject CarpetaService Carpetas
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AutorState Autor
@inject ILogger<Cajas> Logger

<PageTitle>@TituloPagina.De(cajaSeleccionada is not null ? $"Acta {cajaSeleccionada}" : "Cajas de archivo")</PageTitle>

<div class="page-container pg-cajas">
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert error" role="alert">@mensajeError <button class="btn-close-alert" type="button" aria-label="Cerrar mensaje" @onclick="() => mensajeError = null">✕</button></div>
    }
    @if (!string.IsNullOrEmpty(cajaSeleccionada))
    {
        <!-- VISTA DE ACTA Y DETALLE IMPRIMIBLE DE LA CAJA (ESTILO F8 Y CAMBIO DE DOMICILIO) -->
        <div class="no-print caja-toolbar">
            <button type="button" class="btn-secondary" @onclick="VolverAInventario">
                &larr; Volver a Cajas
            </button>
            <button type="button" class="btn-primary btn-print" @onclick="ImprimirActa">
                🖨️ Imprimir / Guardar como PDF
            </button>
            <button type="button" class="btn-warning-outline" @onclick="ReabrirCajaActualAsync" title="Desempaquetar la caja y devolver las carpetas a la cola abierta">
                🔓 Reabrir Caja
            </button>
            <a class="btn-outline-link" href="carpetas?caja=@Uri.EscapeDataString(cajaSeleccionada)">
                📁 Ver en listado general &rarr;
            </a>
        </div>

        <div class="acta">
            <div class="acta-letterhead">
                <img src="img/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="acta-logo" />
                <div class="acta-inst">
                    <div class="l1">Ilustre Municipalidad de Valparaíso</div>
                    <div class="l2">Departamento de Licencias de Conducir</div>
                    <div class="l3">Sistema SGL 2026 · Control y Archivo de Carpetas</div>
                </div>
                <div class="acta-code">
                    <div class="k">Caja</div>
                    <div class="v">@cajaSeleccionada</div>
                </div>
            </div>

            <div class="acta-title">
                <h2>Listado Oficial de Carpetas en Caja</h2>
                <p>Carpetas en el orden en que fueron ingresadas a la caja física</p>
            </div>

            <div class="acta-meta">
                <div>
                    <span class="k">Código / Rótulo de Caja</span>
                    <span class="v">@cajaSeleccionada</span>
                </div>
                <div>
                    <span class="k">Fecha de Cierre / Emisión</span>
                    <span class="v">@Sgl.Domain.HoraChile.ALocal(DateTime.UtcNow).ToString("dd-MM-yyyy HH:mm")</span>
                </div>
                <div>
                    <span class="k">Total de Carpetas</span>
                    <span class="v">@(carpetasDeCaja?.Count ?? 0) carpetas</span>
                </div>
            </div>

            @if (cargandoDetalle)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Cargando detalle de la caja…</p>
                </div>
            }
            else if (carpetasDeCaja is null || carpetasDeCaja.Count == 0)
            {
                <p class="caja-empty">Esta caja no tiene carpetas asignadas.</p>
            }
            else
            {
                <table class="acta-table">
                    <thead>
                        <tr>
                            <th style="width: 42px;">N°</th>
                            <th style="text-align: left;">Nombre de contribuyente</th>
                            <th class="col-rut-centrado">RUT</th>
                            <th>Sede</th>
                            <th>Última Carpeta</th>
                            <th>Fecha Citación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var correlativo = 0; }
                        @foreach (var item in carpetasDeCaja)
                        {
                            correlativo++;
                            <tr>
                                <td class="n">@correlativo</td>
                                <td class="nom">@item.NombreCompleto</td>
                                <td class="mono col-rut-centrado">@item.Rut</td>
                                <td>@Labels.Of(item.Sede)</td>
                                <td>@FechaImpresa.DdMmAaaa(item.FechaUltimaCarpeta)</td>
                                <td>@item.FechaCitacion.ToString("dd-MM-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="6">Total de carpetas en esta caja: @carpetasDeCaja.Count</td>
                        </tr>
                    </tfoot>
                </table>
            }

            <div class="acta-signs">
                <div>
                    Entregado por
                    <small>Nombre, firma y fecha</small>
                </div>
                <div>
                    Recibido por Archivo
                    <small>Nombre, firma y fecha</small>
                </div>
            </div>

            <div class="acta-foot">
                <span>Municipalidad de Valparaíso · Licencias de Conducir</span>
                <span>Emitido: @Sgl.Domain.HoraChile.ALocal(DateTime.UtcNow).ToString("dd-MM-yyyy HH:mm") por @(Autor.HasNombre ? Autor.Nombre : "Funcionario")</span>
            </div>
        </div>
    }
    else
    {
        <!-- VISTA PRINCIPAL: RESUMEN, CAJAS CERRADAS Y COLA POR GUARDAR -->
        <div class="header-section">
            <span class="lico-slot head-art" data-lico="explica" aria-hidden="true"></span>
            <h1>Cajas de archivo</h1>
            <p class="subtitle">Ordenamiento de carpetas encontradas, rotulación de cajas y emisión de actas de entrega para archivo.</p>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert-banner alert-success" role="status">
                <span class="lico-slot lico-msg" data-lico="celebra" aria-hidden="true"></span>
                <span>✅ @mensajeExito</span>
                <button class="btn-close-alert" type="button" aria-label="Cerrar mensaje" @onclick="() => mensajeExito = null">✕</button>
            </div>
        }

        <div class="cajas-kpi-row">
            <div class="kpi-card">
                <div class="kpi-icon">📦</div>
                <div class="kpi-data">
                    <span class="kpi-number">@(cajas?.Count ?? 0)</span>
                    <span class="kpi-label">Cajas registradas</span>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon">📁</div>
                <div class="kpi-data">
                    <span class="kpi-number">@(cajas?.Sum(x => x.TotalCarpetas).ToString("N0") ?? "0")</span>
                    <span class="kpi-label">Carpetas en cajas</span>
                </div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon">📥</div>
                <div class="kpi-data">
                    <span class="kpi-number">@colas.Total.ToString("N0")</span>
                    <span class="kpi-label">Pendientes por guardar (con decisión final)</span>
                </div>
            </div>
        </div>

        <!-- Pestañas: Cajas Cerradas vs Cola por Guardar -->
        <div class="cajas-tab-nav">
            <button class="tab-btn @(pestanaActiva == "cerradas" ? "active" : "")" data-serie="cerradas" @onclick='() => SeleccionarPestanaAsync("cerradas")'>
                Cajas archivadas (@(cajas?.Count ?? 0))
            </button>
            @foreach (var (clave, serie, titulo) in Series)
            {
                <button class="tab-btn @(pestanaActiva == clave ? "active" : "")" data-serie="@clave" @onclick="() => SeleccionarPestanaAsync(clave)">
                    @titulo (@colas.De(serie).ToString("N0"))
                </button>
            }
        </div>

        @if (pestanaActiva == "cerradas")
        {
            <div class="cajas-toolbar">
                <div class="search-input-wrapper" style="max-width: 380px;">
                    <span class="search-icon">🔍</span>
                    <input @bind="filtroCajaTexto" @bind:event="oninput" placeholder="Buscar caja por nombre o código..." />
                </div>
                <div class="cajas-count-note">
                    Mostrando @CajasFiltradas.Count de @(cajas?.Count ?? 0) cajas
                </div>
            </div>

            @if (cajas is null)
            {
                <div class="loading-state">
                    <div class="spinner"></div>
                    <p>Cargando inventario de cajas…</p>
                </div>
            }
            else if (CajasFiltradas.Count == 0)
            {
                <div class="empty-state">
                    <span class="lico-slot lico-empty" data-lico="explica" aria-hidden="true"></span>
                    @if (string.IsNullOrWhiteSpace(filtroCajaTexto))
                    {
                        <p>No hay cajas en esta serie todavía.</p>
                    }
                    else
                    {
                        <p>No se encontraron cajas con el filtro "@filtroCajaTexto".</p>
                    }
                </div>
            }
            else
            {
                <div class="cajas-table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Rótulo / Código de Caja</th>
                                <th style="text-align: center;">Carpetas Archivadas</th>
                                <th style="min-width: 250px; text-align: right;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in CajasFiltradas)
                            {
                                <tr class="caja-row" style="--fill:@LlenadoRelativo(c.TotalCarpetas)%">
                                    <td>
                                        <div class="caja-title-cell">
                                            <span class="caja-badge-icon" aria-hidden="true"><svg class="ico-caja" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="5" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg></span>
                                            <strong>@c.Caja</strong>
                                        </div>
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="badge ok">@c.TotalCarpetas carpeta(s)</span>
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="caja-actions-cell">
                                            <button class="btn-print-caja" @onclick="() => AbrirDetalleCaja(c.Caja)" title="Ver listado e imprimir detalle oficial de la caja">
                                                📄 Ver listado / Imprimir
                                            </button>
                                            <a class="btn-detail" href="carpetas?caja=@Uri.EscapeDataString(c.Caja)" title="Filtrar carpetas en el listado general">
                                                📁 Ver en tabla &rarr;
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            <!-- PESTAÑA: COLA DE CARPETAS POR GUARDAR EN CAJA (UNA POR SERIE) -->
            <div class="caja-queue-card">
                <div class="queue-header">
                    <div>
                        <h2>📥 Cola de carpetas por archivar: serie @Carpeta.NombreSerie(serieActiva)</h2>
                        <p class="subtitle">Solo aparecen carpetas con decisión final (otorgada o denegada) de esta serie. Seleccione las que irán en la caja e ingrese su rótulo.</p>
                    </div>
                </div>

                @if (colas.SinDecisionEnCola > 0)
                {
                    <p class="caja-hint caja-cola-heredada" role="note">
                        Además hay @colas.SinDecisionEnCola.ToString("N0") carpeta(s) en «Cola de Caja» sin decisión final. No se modificaron ni se listan aquí: siguen como estaban.
                    </p>
                }

                <div class="box-close-form">
                    <div class="box-input-group">
                        <label for="nuevoRotuloInput"><strong>Rótulo / N° de caja:</strong></label>
                        <input id="nuevoRotuloInput" @bind="nuevoRotuloCaja" placeholder="@EjemploRotulo" maxlength="@Carpeta.MaxCajaLength" class="input-rotulo" />
                    </div>
                    <div class="box-input-group">
                        <label for="letraSugerenciaInput">Letra:</label>
                        <input id="letraSugerenciaInput" value="@letraSugerencia" maxlength="2" size="3" class="input-rotulo" @onchange="CambiarLetraAsync" />
                    </div>
                    <label class="chk-existente">
                        <input id="agregarExistenteChk" type="checkbox" @bind="agregarAExistente" />
                        Agregar a caja existente
                    </label>
                    <button class="btn-primary" disabled="@(colaSeleccionadas.Count == 0 || string.IsNullOrWhiteSpace(nuevoRotuloCaja))" @onclick="AsignarCajaColaAsync">
                        📦 Almacenar @colaSeleccionadas.Count carpeta(s) en @(string.IsNullOrWhiteSpace(nuevoRotuloCaja) ? "Caja" : nuevoRotuloCaja)
                    </button>
                </div>
                <p class="caja-hint caja-sugerencia" id="sugerenciaCaja" role="note">
                    @if (sugerencia is not null)
                    {
                        <span>Siguiente número sugerido: <strong>@sugerencia</strong>. Es solo una ayuda: el número lo asigna usted.</span>
                        <button type="button" class="btn-sug" @onclick="() => nuevoRotuloCaja = sugerencia">Usar @sugerencia</button>
                    }
                    else
                    {
                        <span>No hay más números disponibles para esa letra en esta serie: use otra letra.</span>
                    }
                </p>

                @if (carpetasCola is null)
                {
                    <div class="loading-state">
                        <div class="spinner"></div>
                        <p>Cargando carpetas pendientes…</p>
                    </div>
                }
                else if (carpetasCola.Count == 0)
                {
                    <div class="empty-state">
                        <span class="lico-slot lico-empty" data-lico="explica" aria-hidden="true"></span>
                        <p>No hay carpetas pendientes de archivar en caja en este lote.</p>
                    </div>
                }
                else
                {
                    <div class="cajas-table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th class="th-check"></th>
                                    <th>N°</th>
                                    <th>Nombre de contribuyente</th>
                                    <th class="col-rut-centrado">RUT</th>
                                    <th>Sede</th>
                                    <th>Fecha Citación</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <Virtualize TItem="FilaCola" Context="fila" Items="filasCola" ItemSize="44" OverscanCount="15" SpacerElement="tr">
                                @{
                                    var c = fila.Carpeta;
                                    var nro = fila.Numero;
                                    var sel = colaSeleccionadas.Contains(c.Id);
                                    <tr class="@(sel ? "row-selected" : "")">
                                        <td class="td-check">
                                            <input type="checkbox" checked="@sel" @onchange="() => ToggleSelectCola(c.Id)" />
                                        </td>
                                        <td>@nro</td>
                                        <td><CeldaCarpeta CarpetaId="c.Id" Valor="@c.NombreCompleto" CssClass="name-cell" OnGuardado="CargarDatosAsync" /></td>
                                        <td class="col-rut-centrado"><CeldaCarpeta CarpetaId="c.Id" Valor="@c.Rut" EsRut="true" CssClass="rut-cell" OnGuardado="CargarDatosAsync" /></td>
                                        <td><span class="sede-tag">@Labels.Of(c.Sede)</span></td>
                                        <td class="date-cell">@c.FechaCitacion.ToString("dd-MM-yyyy")</td>
                                        <td>
                                            <button class="btn-action-caja" title="Guardar esta carpeta en una caja física" @onclick="() => AbrirModalCaja(c)">
                                                <svg class="ico-caja" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="5" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
                                                <span>Caja</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                                </Virtualize>
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
</div>

@if (mostrarModalCaja && carpetaModal is not null)
{
    <div class="modal-overlay" @onclick="CerrarModalCaja">
        <div class="modal-card" @onclick:stopPropagation role="dialog" aria-modal="true" aria-label="Almacenamiento en caja física">
            <h3>📦 Almacenamiento en Caja Física</h3>
            <p>Carpeta: <strong class="nombre-persona">@carpetaModal.NombreCompleto</strong> (@carpetaModal.Rut)</p>
            <div class="modal-form">
                <label>Código / Identificador de la Caja o Estante:
                    <input @bind="nuevaCajaModal" maxlength="@Carpeta.MaxCajaLength" placeholder="@EjemploRotulo" autofocus />
                </label>
                <label class="chk-existente">
                    <input type="checkbox" @bind="agregarModal" />
                    Agregar a caja existente
                </label>
                @if (sugerencia is not null)
                {
                    <p class="caja-hint">Siguiente número sugerido: <strong>@sugerencia</strong> (solo una ayuda).
                        <button type="button" class="btn-sug" @onclick="() => nuevaCajaModal = sugerencia">Usar @sugerencia</button></p>
                }
                @if (CajasDeLaSerie.Count > 0)
                {
                    <div class="cajas-sugeridas">
                        <span class="sugeridas-label">Cajas existentes de esta serie:</span>
                        @foreach (var caja in CajasDeLaSerie.Take(6))
                        {
                            <button type="button" class="btn-sug" @onclick="() => { nuevaCajaModal = caja.Caja; agregarModal = true; }">@caja.Caja (@caja.TotalCarpetas)</button>
                        }
                    </div>
                }
                <div class="modal-actions">
                    <button class="btn-primary" @onclick="GuardarCajaModalAsync" disabled="@string.IsNullOrWhiteSpace(nuevaCajaModal)">Confirmar almacenamiento</button>
                    <button class="btn-secondary" @onclick="CerrarModalCaja">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "caja")]
    public string? CajaQuery { get; set; }

    private string? cajaSeleccionada;

    /// <summary>Presentation-only: occupancy of a box relative to the fullest one (0-100), used for the box illustration.</summary>
    private int LlenadoRelativo(int total)
    {
        var max = cajas is { Count: > 0 } ? cajas.Max(x => x.TotalCarpetas) : 0;
        return max <= 0 ? 0 : (int)Math.Round(100.0 * total / max);
    }
    private string pestanaActiva = "cerradas";

    /// <summary>Pestañas de cola: una por serie (clave, serie, título).</summary>
    private static readonly (string Clave, SerieCaja Serie, string Titulo)[] Series =
    [
        ("normal", SerieCaja.Normal, "Normales"),
        ("cd", SerieCaja.CambioDomicilio, $"Cambio de domicilio ({CajaFormatos.Actual.SufijoCambioDomicilio})"),
        ("puc", SerieCaja.PenultimaCarpeta, $"Penúltima carpeta ({CajaFormatos.Actual.SufijoPenultima})"),
    ];

    private SerieCaja serieActiva = SerieCaja.Normal;
    private ColasCajaDto colas = new(0, 0, 0, 0);
    private string letraSugerencia = "";
    private string? sugerencia;
    private bool agregarAExistente;
    private bool agregarModal;

    private string EjemploRotulo => $"Ej: A-12{CajaFormatos.Actual.SufijoDe(serieActiva)}";

    /// <summary>Cajas ya registradas que pertenecen a la serie activa (por el sufijo del rótulo).</summary>
    private IReadOnlyList<CajaResumenDto> CajasDeLaSerie =>
        (cajas ?? []).Where(c => Carpeta.SerieDeRotulo(c.Caja) == serieActiva).ToList();

    private async Task SeleccionarPestanaAsync(string clave)
    {
        pestanaActiva = clave;
        colaSeleccionadas.Clear();
        nuevoRotuloCaja = "";
        agregarAExistente = false;
        letraSugerencia = "";
        mensajeError = null;
        if (Series.FirstOrDefault(x => x.Clave == clave) is { Clave: not null } serie)
        {
            serieActiva = serie.Serie;
            await CargarColaAsync();
        }
    }

    private async Task CambiarLetraAsync(ChangeEventArgs e)
    {
        letraSugerencia = (e.Value as string ?? "").Trim();
        await CargarSugerenciaAsync();
    }

    private async Task CargarSugerenciaAsync()
    {
        try
        {
            sugerencia = await Carpetas.SugerirSiguienteCajaAsync(serieActiva, letraSugerencia);
        }
        catch (DomainException ex)
        {
            sugerencia = null;
            mensajeError = ex.Message;
        }
    }
    private string filtroCajaTexto = "";
    private string nuevoRotuloCaja = "";
    private string? mensajeExito;
    private string? mensajeError;
    private bool ocupado;

    /// <summary>Runs a box mutation once at a time, requiring the official's name, with a visible error on failure.</summary>
    private async Task EjecutarCajaAsync(Func<string, Task> accion)
    {
        if (ocupado) return;
        mensajeError = null;
        if (!Autor.HasNombre)
        {
            mensajeError = "Ingrese su nombre en el campo «Funcionario» (arriba) antes de modificar cajas.";
            return;
        }

        ocupado = true;
        try
        {
            await accion(Autor.Nombre);
        }
        catch (Exception ex) when (ex is DomainException or NotFoundException)
        {
            mensajeError = ex.Message;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Fallo una operación de cajas.");
            mensajeError = "No se pudo completar la operación. Intente nuevamente.";
        }
        finally
        {
            ocupado = false;
        }
    }
    private bool cargandoDetalle;

    private IReadOnlyList<CajaResumenDto>? cajas;
    private IReadOnlyList<CarpetaResumenDto>? carpetasDeCaja;
    private IReadOnlyList<CarpetaResumenDto>? carpetasCola;
    private List<FilaCola> filasCola = [];

    /// <summary>Fila de la cola con su correlativo, para la lista continua virtualizada.</summary>
    private sealed record FilaCola(int Numero, CarpetaResumenDto Carpeta);
    private readonly HashSet<Guid> colaSeleccionadas = [];

    private IReadOnlyList<CajaResumenDto> CajasFiltradas =>
        string.IsNullOrWhiteSpace(filtroCajaTexto)
            ? (cajas ?? [])
            : (cajas ?? []).Where(c => c.Caja.Contains(filtroCajaTexto, StringComparison.OrdinalIgnoreCase)).ToList();

    private bool TodosColaSeleccionados =>
        carpetasCola is not null && carpetasCola.Count > 0 && colaSeleccionadas.Count >= carpetasCola.Count;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
        if (!string.IsNullOrWhiteSpace(CajaQuery))
        {
            await AbrirDetalleCaja(CajaQuery);
        }
    }

    private async Task CargarDatosAsync()
    {
        cajas = await Carpetas.ObtenerCajasAsync();
        colas = await Carpetas.ContarColasCajaAsync();
        await CargarColaAsync();
    }

    /// <summary>Carga la cola de la serie activa: solo carpetas con decisión final de esa serie y todavía sin caja real.</summary>
    private async Task CargarColaAsync()
    {
        var lista = await Carpetas.ListarColaCajaAsync(serieActiva);
        carpetasCola = lista;
        filasCola = lista.Select((c, i) => new FilaCola(i + 1, c)).ToList();
        await CargarSugerenciaAsync();
    }

    private async Task AbrirDetalleCaja(string caja)
    {
        cajaSeleccionada = caja;
        cargandoDetalle = true;
        carpetasDeCaja = await Carpetas.ObtenerCarpetasDeCajaAsync(caja);
        cargandoDetalle = false;
    }

    private void VolverAInventario()
    {
        cajaSeleccionada = null;
        carpetasDeCaja = null;
    }

    private async Task ReabrirCajaActualAsync()
    {
        if (string.IsNullOrWhiteSpace(cajaSeleccionada)) return;
        var rotulo = cajaSeleccionada;
        await EjecutarCajaAsync(async autor =>
        {
            await Carpetas.ReabrirCajaAsync(rotulo, autor);
            mensajeExito = $"Caja {rotulo} reabierta con éxito. Sus carpetas volvieron a la cola para poder modificarlas o corregirlas.";
            cajaSeleccionada = null;
            await SeleccionarPestanaAsync("normal");
            await CargarDatosAsync();
        });
    }

    private async Task ImprimirActa()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private void ToggleSelectCola(Guid id)
    {
        if (!colaSeleccionadas.Add(id))
            colaSeleccionadas.Remove(id);
    }

    private void ToggleSelectAllCola(ChangeEventArgs e)
    {
        if (carpetasCola is null) return;
        var check = (bool)(e.Value ?? false);
        if (check)
        {
            foreach (var item in carpetasCola)
                colaSeleccionadas.Add(item.Id);
        }
        else
        {
            colaSeleccionadas.Clear();
        }
    }

    private async Task AsignarCajaColaAsync()
    {
        if (colaSeleccionadas.Count == 0 || string.IsNullOrWhiteSpace(nuevoRotuloCaja)) return;
        var rotulo = nuevoRotuloCaja.Trim();
        await EjecutarCajaAsync(async autor =>
        {
            await Carpetas.AsignarCajaLoteAsync(new AsignarCajaLoteCommand(colaSeleccionadas.ToList(), rotulo, autor, agregarAExistente));
            colaSeleccionadas.Clear();
            var guardada = Carpeta.NormalizarRotulo(rotulo) ?? rotulo;
            nuevoRotuloCaja = "";
            agregarAExistente = false;
            mensajeExito = $"Se almacenaron las carpetas en la caja {guardada}.";
            await CargarDatosAsync();
            await AbrirDetalleCaja(guardada);
        });
    }

    // Mismo mecanismo que Cambio de domicilio: cuadro «Almacenamiento en Caja Física» con cajas activas como sugerencia.
    private bool mostrarModalCaja;
    private CarpetaResumenDto? carpetaModal;
    private string nuevaCajaModal = "";

    private void AbrirModalCaja(CarpetaResumenDto c)
    {
        carpetaModal = c;
        nuevaCajaModal = "";
        agregarModal = false;
        mostrarModalCaja = true;
    }

    private void CerrarModalCaja()
    {
        mostrarModalCaja = false;
        carpetaModal = null;
    }

    private async Task GuardarCajaModalAsync()
    {
        if (carpetaModal is null || string.IsNullOrWhiteSpace(nuevaCajaModal)) return;
        var c = carpetaModal;
        var rotulo = nuevaCajaModal.Trim();
        CerrarModalCaja();
        await EjecutarCajaAsync(async autor =>
        {
            await Carpetas.AsignarCajaAsync(new AsignarCajaCommand(c.Id, rotulo, autor, agregarModal));
            mensajeExito = $"Carpeta de {c.NombreCompleto} almacenada en {Carpeta.NormalizarRotulo(rotulo) ?? rotulo}.";
            await CargarDatosAsync();
        });
    }
}
