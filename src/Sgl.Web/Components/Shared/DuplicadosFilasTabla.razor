@* "Por arreglar" rows for the Por clasificar table: one red row per possible-duplicate case (citizen with >1 open
   carpeta that has no row of its own in the tray), alphabetical, followed by the separator of the normal rows.
   Rendered inside the tray's <tbody>, so it shares header and columns with the carpeta rows. *@
@inject DuplicadosService Revision
@inject ILogger<DuplicadosFilasTabla> Logger

@if (total > 0)
{
    <tr class="dup-seccion-cab" id="dup-seccion">
        <td colspan="@Columnas">
            <div class="dup-seccion-cab-fila">
                <strong>POR ARREGLAR · @total.ToString("N0", CulturaCl) @(total == 1 ? "caso" : "casos")</strong>
                <span>ciudadanos con más de una carpeta abierta</span>
                <a class="dup-seccion-ir" href="#dup-por-clasificar-sep" @onclick="IrAPorClasificarAsync" @onclick:preventDefault>↓ ir a las @(CantidadPorClasificar.ToString("N0", CulturaCl)) por clasificar</a>
            </div>
        </td>
    </tr>
    @foreach (var g in filas)
    {
        var abierto = abiertoId == g.CiudadanoId;
        <tr class="fila-duplicada dup-caso @(abierto ? "abierto" : null)" @key="g.CiudadanoId">
            <td class="td-check col-sticky-check"><input type="checkbox" disabled title="Los casos por arreglar no se clasifican en lote" /></td>
            <td class="date-cell col-sticky-rut">@g.Rut</td>
            <td class="col-sticky-nombre">
                <div class="nombre-wrapper-cell">
                    <span class="name-cell" title="@g.NombreCompleto">@g.NombreCompleto</span>
                    <a class="icono-buscar-dup" href="@($"carpetas?bandeja=todas&buscar={Uri.EscapeDataString(g.Rut)}")"
                       title="Buscar todas las carpetas de este RUT en el sistema" aria-label="@($"Buscar en el sistema las carpetas de {g.NombreCompleto}")">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                    </a>
                </div>
            </td>
            <td><span class="sede-tag">—</span></td>
            <td colspan="@(Columnas - 4)">
                <div class="dup-caso-resumen">
                    <span class="dup-motivo @(g.Motivo.StartsWith("RUT") ? "dup-motivo-alerta" : null)">@g.Motivo</span>
                    <span class="dup-badge" title="Carpetas abiertas">@g.CarpetasAbiertas</span>
                    <button type="button" class="btn-small" aria-expanded="@(abierto ? "true" : "false")" @onclick="() => Alternar(g.CiudadanoId)">@(abierto ? "Cerrar" : "Resolver")</button>
                </div>
            </td>
        </tr>
        @if (abierto)
        {
            <tr class="dup-caso-detalle">
                <td colspan="@Columnas">
                    <DuplicadoResolver @key="g.CiudadanoId" Grupo="g" OnCerrar="CerrarAsync" OnResuelto="TrasResolverAsync" />
                </td>
            </tr>
        }
    }
    @if (filas.Count < total)
    {
        <tr class="dup-seccion-mas">
            <td colspan="@Columnas">
                <button type="button" class="btn-secondary" disabled="@cargando" @onclick="MostrarMasAsync">Mostrar más (restan @((total - filas.Count).ToString("N0", CulturaCl)))</button>
            </td>
        </tr>
    }
    <tr class="dup-seccion-cab dup-seccion-cab-normal" id="dup-por-clasificar-sep">
        <td colspan="@Columnas">
            <div class="dup-seccion-cab-fila">
                <strong>POR CLASIFICAR · @CantidadPorClasificar.ToString("N0", CulturaCl) @(CantidadPorClasificar == 1 ? "carpeta" : "carpetas")</strong>
            </div>
        </td>
    </tr>
}

@code {
    private const int TamanoPagina = 100;
    private static readonly System.Globalization.CultureInfo CulturaCl = new("es-CL");

    /// <summary>Number of columns of the host table (colspan of the merged cells).</summary>
    [Parameter] public int Columnas { get; set; } = 8;

    /// <summary>Tray text search (RUT or name), same as the main grid.</summary>
    [Parameter] public string? Texto { get; set; }

    [Parameter] public Sede? Sede { get; set; }

    /// <summary>Carpetas in the tray (shown in the "Por clasificar" separator and the shortcut link).</summary>
    [Parameter] public int CantidadPorClasificar { get; set; }

    /// <summary>Raised when a case was resolved so the host can refresh its own rows and counters.</summary>
    [Parameter] public EventCallback OnCambio { get; set; }

    private readonly List<DuplicadoGrupoDto> filas = [];
    private int total;
    private bool cargando;
    private Guid? abiertoId;
    private string? textoAplicado;
    private Sede? sedeAplicada;
    private bool iniciado;

    protected override async Task OnParametersSetAsync()
    {
        if (iniciado && textoAplicado == Texto && sedeAplicada == Sede) return;
        iniciado = true;
        textoAplicado = Texto;
        sedeAplicada = Sede;
        abiertoId = null;
        await RecargarAsync(Math.Max(TamanoPagina, filas.Count));
    }

    private ListarDuplicadosQuery Consulta(int skip, int take) =>
        new(Texto, Sede, skip, take, SinCarpetaPorClasificar: true);

    private async Task RecargarAsync(int cantidad)
    {
        cargando = true;
        try
        {
            var r = await Revision.ListarAsync(Consulta(0, cantidad));
            filas.Clear();
            filas.AddRange(r.Items);
            total = r.Total;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "No se pudo cargar los casos por arreglar.");
            filas.Clear();
            total = 0;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task MostrarMasAsync()
    {
        if (cargando) return;
        cargando = true;
        try
        {
            var r = await Revision.ListarAsync(Consulta(filas.Count, TamanoPagina));
            filas.AddRange(r.Items.Where(i => filas.All(f => f.CiudadanoId != i.CiudadanoId)));
            total = r.Total;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "No se pudo cargar más casos por arreglar.");
        }
        finally
        {
            cargando = false;
        }
    }

    private void Alternar(Guid ciudadanoId) => abiertoId = abiertoId == ciudadanoId ? null : ciudadanoId;

    private Task CerrarAsync()
    {
        abiertoId = null;
        return Task.CompletedTask;
    }

    private async Task TrasResolverAsync()
    {
        // Keep the already-paged window; a resolved case simply disappears from the list.
        await RecargarAsync(Math.Max(TamanoPagina, filas.Count));
        if (abiertoId is { } id && filas.All(f => f.CiudadanoId != id)) abiertoId = null;
        await OnCambio.InvokeAsync();
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task IrAPorClasificarAsync() =>
        await JS.InvokeVoidAsync("eval", "document.getElementById('dup-por-clasificar-sep')?.scrollIntoView({block:'start'})");
}
