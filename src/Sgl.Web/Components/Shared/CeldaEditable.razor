@* Inline-editable table cell: one click on the text turns it into an input (Enter/Space on the focused text also opens it).
   Enter or leaving the field saves (only when the value changed); Escape cancels.
   Click, double-click and keys never reach the row (row double-click opens the detail; here it must not). *@

@if (editando)
{
    <input @ref="input"
           class="@(EsRut ? "excel-rut-input rut-input celda-editable-input" : "celda-editable-input")"
           value="@Valor"
           data-original="@Valor"
           maxlength="@(EsRut ? 12 : 201)"
           aria-label="@Titulo"
           title="Enter para guardar · Esc para cancelar"
           oninput="@(EsRut ? "formatRutInput(this)" : null)"
           onkeydown="event.stopPropagation();if(event.key==='Enter'){event.preventDefault();this.blur();}else if(event.key==='Escape'){event.preventDefault();this.value=this.dataset.original;this.blur();}"
           @onchange="OnChangeAsync"
           @onblur="Cerrar"
           @onclick:stopPropagation @ondblclick:stopPropagation />
}
else
{
    <span class="@CssClass celda-editable-texto" role="button" tabindex="0"
          title="@($"{Title ?? Valor} · Clic para corregir {Titulo}")"
          aria-label="@($"Corregir {Titulo}: {Valor}")"
          onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();event.stopPropagation();this.click();}"
          @onclick="Abrir" @onclick:stopPropagation @ondblclick:stopPropagation>@Valor</span>
}

@code {
    [Parameter, EditorRequired] public string Valor { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public bool EsRut { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public EventCallback<string> Guardar { get; set; }

    private bool editando;
    private bool enfocar;
    private ElementReference input;

    private void Abrir()
    {
        editando = true;
        enfocar = true;
    }

    private void Cerrar() => editando = false;
    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        var nuevo = e.Value?.ToString()?.Trim() ?? string.Empty;
        editando = false;
        if (nuevo.Length == 0 || string.Equals(nuevo, Valor, StringComparison.Ordinal)) return;
        await Guardar.InvokeAsync(nuevo);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!enfocar || !editando) return;
        enfocar = false;
        try { await input.FocusAsync(); } catch (Exception) { /* element gone before focus: nothing to do */ }
    }
}
