@* Pending duplicate cases counter for the main navigation. Loaded after the first render
   (never blocks page rendering) from a short-lived app-wide cache. *@
@implements IDisposable
@inject DuplicadosBadgeCache Cache
@inject DuplicadosNotifier Notifier
@inject NavigationManager Nav
@inject ILogger<DuplicadosBadge> Logger

@if (pendientes > 0)
{
    <span class="nav-badge" aria-label="@($"{pendientes} casos pendientes")">@(pendientes > 99 ? "99+" : pendientes.ToString())</span>
}

@code {
    private int pendientes;
    private readonly CancellationTokenSource cts = new();

    protected override void OnInitialized()
    {
        Notifier.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _ = RefrescarAsync();
        }
    }

    private void OnChanged()
    {
        Cache.Invalidar();
        _ = RefrescarAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = RefrescarAsync();

    private async Task RefrescarAsync()
    {
        try
        {
            var valor = await Cache.ObtenerAsync(cts.Token);
            if (valor != pendientes)
            {
                pendientes = valor;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "No se pudo contar los posibles duplicados.");
        }
    }

    public void Dispose()
    {
        Notifier.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
        cts.Cancel();
        cts.Dispose();
    }
}
