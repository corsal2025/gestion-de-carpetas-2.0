@* Compact license-class picker for table rows: a native disclosure showing the chosen classes. *@
<details class="clase-rapida @(Value == ClaseLicencia.Ninguna ? "sin-clase" : null)">
    <summary title="Clase de licencia (obligatoria para clasificar)" aria-label="@AriaLabel" aria-disabled="@(Disabled ? "true" : "false")" aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@DescriptionId">@(Value == ClaseLicencia.Ninguna ? "Elegir" : ClasesLicencia.Format(Value))<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
    <div class="clase-rapida-panel" popover="auto" aria-label="@AriaLabel">
        <p class="clase-panel-titulo">Clases de licencia</p>
        <p class="clase-panel-ayuda">Puede elegir más de una.</p>
        <ClasesSelector Value="Value" ValueChanged="ValueChanged" Disabled="Disabled" AriaLabel="@AriaLabel" />
        <button type="button" class="clase-rapida-listo" disabled="@Disabled" @onclick="Confirmed">Listo</button>
    </div>
</details>

@code {
    [Parameter] public ClaseLicencia Value { get; set; }

    [Parameter] public EventCallback<ClaseLicencia> ValueChanged { get; set; }
    [Parameter] public EventCallback Confirmed { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string AriaLabel { get; set; } = "Clase de licencia de esta fila";
    [Parameter] public bool Invalid { get; set; }
    [Parameter] public string? DescriptionId { get; set; }
}
