@inherits LayoutComponentBase
@inject AutorState Autor
@inject IJSRuntime JS
@inject NavigationManager Nav

<header class="topbar">
    <div class="brand-group">
        <a class="brand" href="carpetas?bandeja=PorClasificar" title="Ir a Licencias para clasificar">
            <span class="brand-mark brand-logo">
                <img src="images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" />
            </span>
            <span class="brand-text"><strong>Gestión de Carpetas 2.0</strong> <span class="brand-sub">Licencias de Conducir</span></span>
        </a>
    </div>
    <nav class="main-nav" aria-label="Principal">
        <NavLink href="" Match="NavLinkMatch.All" class="nav-item nav-carpetas" title="Ir al panel de inicio">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>
            Inicio
        </NavLink>
        <NavLink href="cajas" class="nav-item nav-cajas">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>
            Cajas de Archivo
        </NavLink>
        <NavLink href="estadisticas" class="nav-item nav-estadisticas">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
            Estadísticas
        </NavLink>
    </nav>
    <div class="topbar-tools">
        @if (!EsListadoCarpetas)
        {
            <BuscadorGlobal />
        }
        <button id="btn-guia-global" class="btn-guia-accion" type="button" title="Cómo usar el sistema (Guía interactiva)" data-tooltip="Simulador interactivo con flecha explicativa que te enseña paso a paso cómo usar el sistema">
            <span class="guia-avatar lico-slot" data-lico="explica" aria-hidden="true"></span>
            <span>Cómo usar el sistema</span>
        </button>
        <button class="head-lico" type="button" aria-label="Lico, tu asistente: abrir la guía de uso del sistema" title="Lico: abrir la guía de uso" onclick="document.getElementById('btn-guia-global').click()">
            <span class="lico-slot" data-lico="saluda" aria-hidden="true"></span>
            <span class="head-lico-burbuja" aria-hidden="true">¡Hola! Me llamo Lico</span>
        </button>
        <div class="pal-wrap">
        <button type="button" class="pal-toggle" id="btn-paleta" aria-expanded="false" aria-controls="pal-panel" aria-label="Elegir paleta de color" title="Elegir paleta de color"><i aria-hidden="true"></i></button>
        <div class="pal" id="pal-panel" role="group" aria-label="Paleta de color">
            <button type="button" class="sw" data-palette="inst" style="--sc: #26388c" aria-label="Paleta Institucional" title="Paleta Institucional" aria-pressed="true" onclick="window.sglUi.setPalette('inst')"><i></i></button>
            <button type="button" class="sw" data-palette="ocea" style="--sc: #127aa8" aria-label="Paleta Océano" title="Paleta Océano" aria-pressed="false" onclick="window.sglUi.setPalette('ocea')"><i></i></button>
            <button type="button" class="sw" data-palette="bosq" style="--sc: #1f7d4e" aria-label="Paleta Bosque" title="Paleta Bosque" aria-pressed="false" onclick="window.sglUi.setPalette('bosq')"><i></i></button>
            <button type="button" class="sw" data-palette="atar" style="--sc: #c43a2c" aria-label="Paleta Atardecer" title="Paleta Atardecer" aria-pressed="false" onclick="window.sglUi.setPalette('atar')"><i></i></button>
            <button type="button" class="sw" data-palette="viol" style="--sc: #7040d0" aria-label="Paleta Violeta" title="Paleta Violeta" aria-pressed="false" onclick="window.sglUi.setPalette('viol')"><i></i></button>
            <button type="button" class="sw" data-palette="graf" style="--sc: #4a5068" aria-label="Paleta Grafito" title="Paleta Grafito" aria-pressed="false" onclick="window.sglUi.setPalette('graf')"><i></i></button>
        </div>
        </div>
        <button class="tool-btn" type="button" id="btn-filas" aria-pressed="false" title="Alternar entre filas suaves y los colores originales del Excel" aria-label="Alternar colores de filas" onclick="window.sglUi.toggleRows()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="18" height="4" rx="1"/><rect x="3" y="16" width="18" height="4" rx="1"/></svg>
        </button>
        <button class="tool-btn" type="button" id="btn-diseno" title="Cambiar estilo visual: claro o institucional" aria-label="Cambiar estilo visual entre claro e institucional" onclick="window.sglUi.toggleDesign()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M3 15h18"/></svg>
        </button>
        <button class="tool-btn" type="button" id="btn-tema" title="Cambiar entre tema claro y oscuro" aria-label="Cambiar tema claro u oscuro" onclick="window.sglUi.toggleTheme()">
            <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
    </div>
</header>

@if (pedirNombre)
{
    <div class="nombre-modal-fondo">
        <form class="nombre-modal" role="dialog" aria-modal="true" aria-labelledby="nombre-modal-titulo" @onsubmit="ConfirmarNombreAsync" @onsubmit:preventDefault>
            <h2 id="nombre-modal-titulo">¿Quién está usando el sistema?</h2>
            <p>Su nombre queda en el historial de cada cambio que haga. Se pide una sola vez en este equipo.</p>
            <label for="nombre-modal-input">Nombre del funcionario</label>
            <input id="nombre-modal-input" @bind="nombreNuevo" @bind:event="oninput" maxlength="100" autocomplete="name" autofocus placeholder="Ej.: Javiera Sánchez" />
            <div class="nombre-modal-acciones">
                <button type="button" class="btn-secondary" @onclick="OmitirNombre">Ahora no</button>
                <button type="submit" class="btn-primary" disabled="@string.IsNullOrWhiteSpace(nombreNuevo)">Guardar</button>
            </div>
        </form>
    </div>
}

<main class="content">
    @Body
</main>

<footer class="footer">Desarrollado por Raúl Salazar</footer>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private const string ClaveNombre = "sgl.funcionario";

    // The official's name survives reloads (per browser); storage failures are ignored.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Autor.HasIngresado) return;
        try
        {
            var guardado = await JS.InvokeAsync<string?>("sglUi.leer", ClaveNombre);
            if (!string.IsNullOrWhiteSpace(guardado))
            {
                Autor.Nombre = guardado.Trim();
            }
            else
            {
                // First time on this computer: ask once for the name recorded in the change history.
                pedirNombre = true;
            }
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
    }

    private bool pedirNombre;
    private string nombreNuevo = string.Empty;

    private async Task ConfirmarNombreAsync()
    {
        if (string.IsNullOrWhiteSpace(nombreNuevo)) return;
        Autor.Nombre = nombreNuevo.Trim();
        await GuardarNombreAsync();
        pedirNombre = false;
    }

    /// <summary>"Ahora no": changes keep the generic author; the window comes back on the next visit.</summary>
    private void OmitirNombre() => pedirNombre = false;

    private async Task GuardarNombreAsync()
    {
        try { await JS.InvokeVoidAsync("sglUi.guardar", ClaveNombre, Autor.Ingresado); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
    }

    /// <summary>The tray list shows the global search next to "Mostrar sedes y acciones"; elsewhere it stays in the top bar.</summary>
    private bool EsListadoCarpetas
    {
        get
        {
            var ruta = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
            return ruta.Equals("carpetas", StringComparison.OrdinalIgnoreCase);
        }
    }
}
