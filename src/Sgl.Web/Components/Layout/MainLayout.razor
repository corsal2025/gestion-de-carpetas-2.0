@inherits LayoutComponentBase
@inject AutorState Autor

<header class="topbar">
    <div class="brand-group">
        <a class="brand" href="carpetas">
            <span class="brand-logo">🏛️</span>
            <span class="brand-text"><strong>Gestión de Carpetas 2.0</strong> · Licencias de Conducir</span>
        </a>
    </div>
    <nav class="main-nav">
        <NavLink href="carpetas" Match="NavLinkMatch.Prefix" class="nav-item">
            📁 Gestión de Carpetas
        </NavLink>
        <NavLink href="cajas" class="nav-item">
            📦 Cajas de Archivo
        </NavLink>
    </nav>
    <div class="user-block">
        <label class="autor">
            👤 Funcionario:
            <input @bind="Autor.Nombre" @bind:event="oninput" placeholder="Su nombre" maxlength="100" />
        </label>
    </div>
</header>

<main class="content">
    @Body
</main>

<footer class="footer">Desarrollado por Raúl Salazar</footer>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>
