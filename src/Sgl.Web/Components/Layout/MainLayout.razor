@inherits LayoutComponentBase
@inject AutorState Autor

<header class="topbar">
    <div class="brand-group">
        <a class="brand" href="carpetas">
            <span class="brand-logo">🏛️</span>
            <span class="brand-text"><strong>Gestión de Carpetas 2.0</strong> · Licencias de Conducir</span>
        </a>
    </div>
    <nav class="main-nav">
        <NavLink href="carpetas" Match="NavLinkMatch.Prefix" class="nav-item nav-carpetas">
            📋 Gestión de Carpetas
        </NavLink>
        <NavLink href="cajas" class="nav-item nav-cajas">
            📦 Cajas de Archivo
        </NavLink>
        <NavLink href="importar" class="nav-item nav-importar">
            📥 Cargar Excel Masivo
        </NavLink>
        <button id="btn-guia-global" class="btn-guia-accion" type="button" title="Cómo usar el sistema (Guía interactiva)" data-tooltip="Simulador interactivo con flecha explicativa que te enseña paso a paso cómo usar el sistema" onclick="window.iniciarGuiaInteractiva()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>Cómo usar el sistema</span>
        </button>
    </nav>
    <div class="user-block">
        <label class="autor">
            👤 Funcionario:
            <input @bind="Autor.Nombre" @bind:event="oninput" placeholder="Su nombre" maxlength="100" />
        </label>
    </div>
</header>

<main class="content">
    @Body
</main>

<footer class="footer">Desarrollado por Raúl Salazar</footer>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>
